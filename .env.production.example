# Copy this file to your production environment secret store.
# Do not commit real values.

NODE_ENV=production
PORT=3000

DATABASE_URL="postgresql://USER:PASSWORD@db-host:5432/vera?schema=public"
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@db-host:5432/vera_shadow?schema=public"

# Must be at least 32 random characters.
JWT_SECRET="replace-with-strong-random-secret"
JWT_ISSUER="vera-prod"
JWT_AUDIENCE="vera-web,vera-mobile"

# Restrict to production origins only.
CORS_ORIGIN="https://app.vera.example,https://admin.vera.example"
ENABLE_ORIGIN_GUARD=1
VERA_VALIDATE_ENV_STRICT=1
VERA_ENFORCE_HTTPS=1

PUBLIC_BASE_URL="https://app.vera.example"
PUBLIC_API_URL="https://api.vera.example"
NEXT_PUBLIC_API_URL="https://api.vera.example"

# ── VeriForge Nest API (backend on :3001) ────────────────────────────────
# Required in production. Store on a durable volume, not ephemeral disk.
# VERIFORGE_TENANT_REGISTRY_PATH=/var/lib/veriforge/tenants.json
# VERIFORGE_LEDGER_PATH=/var/lib/veriforge/ledger.json
# VERIFORGE_TENANT_JWT_SECRET=replace-with-32-plus-random-chars
# VERIFORGE_LEDGER_HMAC_KEY=replace-with-32-plus-random-chars
# One-time seed of Alloy/ForgeCo tenants (do not leave on after first boot).
# VERIFORGE_SEED_TENANTS=true
# Hosted reviewer (Auditor). Production creates the user only when this is set.
# VERIFORGE_REVIEWER_PASSWORD=ReviewOnlyChangeMe!2

NATS_URL="nats://nats:4222"
VERA_CORE_UPLOAD_MODE="s3"
CHAT_SECRET="replace-with-strong-random-secret"

# ── VeriSuite SMS (ships in vera-backend monolith) ──────────────────────
# Monitoring JSON lines (sms.metric / sms.ops.boot). Set 0 to disable.
SMS_MONITORING_ENABLED=1
# AI shown/accepted/dismissed/applied decision logs (DB + stdout). Set 0 to disable.
SMS_AI_DECISION_LOGGING=1
# Slack / PagerDuty / custom webhook for SMS incident alerts (optional).
SMS_ALERT_WEBHOOK_URL=""
# External LLM for L1/L2 tiers — keep 0 until provider keys + review are ready.
# D0/D1 deterministic AI (AI-01…18) always ships in-process.
SMS_LLM_ENABLED=0
# Optional override for AI insights cache TTL (ms). Default 3600000.
# SMS_AI_CACHE_TTL_MS=3600000
