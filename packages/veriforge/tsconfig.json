{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@veriforge/*": ["src/*"]
    }
  },
  "include": ["src/**/*"]
}
