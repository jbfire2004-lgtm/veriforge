NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://vera_auth:vera_auth_secret@localhost:5433/vera_auth?schema=public

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

BCRYPT_ROUNDS=12
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
COOKIE_SAME_SITE=lax

# Optional: POST user + roles on register to Vera RBAC service
RBAC_HOOK_URL=http://localhost:3002/rbac/hooks/user-registered
RBAC_SERVICE_KEY=dev-rbac-hook-secret
RBAC_HOOK_TIMEOUT_MS=5000

# Optional: emit audit events on login/register
AUDIT_SERVICE_URL=http://localhost:3003
AUDIT_SERVICE_KEY=dev-audit-ingest-secret

LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
