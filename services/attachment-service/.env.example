NODE_ENV=development
PORT=3004
DATABASE_URL=postgresql://vera_attachment:vera_attachment_secret@localhost:5436/vera_attachment?schema=public

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
AUTH_VALIDATE_URL=http://localhost:3001/auth/validate-token

# local | s3
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./data/uploads

# S3-compatible (MinIO, AWS S3, etc.)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=vera-attachments
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

MAX_FILE_SIZE_BYTES=26214400
PRESIGNED_URL_TTL_SEC=900
THUMBNAIL_MAX_WIDTH=320
THUMBNAIL_MAX_HEIGHT=320

# Optional virus scan hook: POST { filePath, attachmentId, companyId }
VIRUS_SCAN_URL=
VIRUS_SCAN_TIMEOUT_MS=5000

ATTACHMENT_SERVICE_KEY=dev-attachment-ingest-secret

LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
