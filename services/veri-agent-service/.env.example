NODE_ENV=development
PORT=3040
HOST=0.0.0.0
LOG_LEVEL=info

# Postgres (metadata / audit / tenant AI config)
DATABASE_URL=postgresql://veriforge:veriforge_dev_password@localhost:5433/veriforge

# Redis (optional — rate limit + short cache)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# LLM provider (egress only through privacy firewall)
VERA_LLM_ENDPOINT=
VERA_LLM_API_KEY=
VERA_LLM_MODEL=gpt-4o-mini
VERA_EMBEDDING_ENDPOINT=
VERA_EMBEDDING_MODEL=text-embedding-3-small
VERA_AGENT_LLM_ENABLED=true
VERA_AGENT_ALLOW_IMAGE_EGRESS=false
# Industry operating mode: manufacturing | construction | mining | telecom | power | nuclear | multi | none
# VERA_AGENT_MODE=multi
VERA_AGENT_REGION=ca-central-1

# Auth (JWT issuer shared with VeriForge Nest backend)
JWT_ISSUER=veriforge
JWT_AUDIENCE=veri-agent
# Required when AUTH_DEV_BYPASS=false or NODE_ENV=production
JWT_SECRET=dev-only-change-me
# Dev only: skip JWT verification when true (forbidden in production)
AUTH_DEV_BYPASS=true
# Comma-separated Nest-compatible purpose deny list
# VERA_AGENT_DENIED_PURPOSES=

# Rate limits
  RATE_LIMIT_PER_MINUTE=120

# Privacy firewall rules (JSON)
# VERA_AGENT_REDACTION_RULES_PATH=./config/redaction-rules.json

# Policy engine profiles (strict / balanced + tenant overrides)
# VERA_AGENT_POLICIES_DIR=./config/policies
# VERA_AGENT_TENANT_POLICY_MAP=./config/policies/tenant-overrides.json

# Translation abstraction levels
# VERA_AGENT_TRANSLATION_STRICT_PATH=./config/translation/strict.json
# VERA_AGENT_TRANSLATION_RELAXED_PATH=./config/translation/relaxed.json

# Orchestration / providers
# VERA_AGENT_ORCHESTRATION_CONFIG=./config/orchestration.json

# Security (rate limits + abuse thresholds; per-tenant overrides)
# VERA_AGENT_SECURITY_CONFIG=./config/security.json

# Privacy mode default (strict | balanced) — tenant map may override
VERA_AGENT_PRIVACY_MODE=strict

# SAFETY-ENHANCED overlay (default off — no behavior change)
# VERA_AGENT_SAFETY_OVERLAY=off
# VERA_AGENT_SAFETY_OVERLAY=enhanced
# Hard confirm for egress/destructive (requires overlay=enhanced; default off)
# VERA_AGENT_SAFETY_REQUIRE_CONFIRM=false

# Observability (OpenTelemetry-compatible stubs)
OTEL_SERVICE_NAME=veri-agent-service
OTEL_METRICS_ENABLED=true
OTEL_TRACING_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
