{
  "version": 1,
  "defaults": {
    "replacement": "[REDACTED]",
    "requireClean": true,
    "blockOnResidualPii": true
  },
  "tenant": {
    "requireCompanyId": true,
    "injectTenantTag": true,
    "forbidCrossTenantFields": ["otherCompanyId", "foreignTenantId", "peerCompanyId"]
  },
  "roleConstraints": [
    {
      "id": "owner_no_active_hazards",
      "whenRoles": ["PROJECT_OWNER"],
      "unlessAlsoRoles": ["SAFETY_LEAD", "COMPANY_ADMIN", "PLATFORM_ADMIN", "PROJECT_MANAGER"],
      "blockPurposes": ["flha_analyze", "flha_review_assist", "inspection_photo_findings", "equipment_inspection_photo_findings"],
      "blockIfResidualRiskIn": ["high", "critical"],
      "action": "transform_owner_safe",
      "description": "Project owners must not receive active/high residual hazard detail via AI prompts"
    },
    {
      "id": "worker_no_image_describe",
      "whenRoles": ["WORKER"],
      "unlessAlsoRoles": ["SAFETY_LEAD", "CONTRACTOR", "PROJECT_MANAGER"],
      "blockPurposes": ["image_describe"],
      "action": "block",
      "code": "role_denied",
      "description": "Workers cannot invoke image describe egress"
    }
  ],
  "image": {
    "defaultAllowEgress": false,
    "allowedPurposes": ["image_describe", "inspection_photo_findings", "equipment_inspection_photo_findings"],
    "stripBase64UnlessAllowed": true
  },
  "patterns": [
    {
      "id": "email",
      "category": "personal",
      "regex": "\\b[\\w.+-]+@[\\w.-]+\\.\\w{2,}\\b",
      "flags": "gi",
      "replacement": "[REDACTED_EMAIL]"
    },
    {
      "id": "phone",
      "category": "personal",
      "regex": "\\b(?:\\+?1[-.\\s]?)?\\(?\\d{3}\\)?[-.\\s]?\\d{3}[-.\\s]?\\d{4}\\b",
      "flags": "g",
      "replacement": "[REDACTED_PHONE]"
    },
    {
      "id": "ssn_like",
      "category": "personal",
      "regex": "\\b\\d{3}[-\\s]?\\d{2}[-\\s]?\\d{4}\\b",
      "flags": "g",
      "replacement": "[REDACTED_ID]"
    },
    {
      "id": "gps",
      "category": "location",
      "regex": "\\b(?:lat(?:itude)?|lon(?:gitude)?|gps)\\s*[:=]?\\s*-?\\d{1,3}\\.\\d+\\b",
      "flags": "gi",
      "replacement": "[REDACTED_GPS]"
    },
    {
      "id": "lat_lng_pair",
      "category": "location",
      "regex": "\\b-?\\d{1,2}\\.\\d{3,},\\s*-?\\d{1,3}\\.\\d{3,}\\b",
      "flags": "g",
      "replacement": "[REDACTED_COORDS]"
    },
    {
      "id": "street_address",
      "category": "location",
      "regex": "\\b\\d{1,5}\\s+(?:[A-Za-z0-9.'-]+\\s+){0,4}(?:St|Street|Ave|Avenue|Rd|Road|Blvd|Drive|Dr|Lane|Ln|Way|Court|Ct)\\b\\.?",
      "flags": "gi",
      "replacement": "[REDACTED_ADDRESS]"
    },
    {
      "id": "person_role_name",
      "category": "name",
      "regex": "\\b(witness|employee|worker|operator|supervisor|foreman|superintendent)\\s+[A-Z][a-z]+(?:\\s+[A-Z][a-z]+)?\\b",
      "flags": "gi",
      "replacement": "$1 [ROLE]"
    },
    {
      "id": "company_suffix",
      "category": "company",
      "regex": "\\b[A-Z][A-Za-z0-9&.\\- ]{1,40}\\s+(?:Inc|LLC|Ltd|Corp|Corporation|Company|Co)\\b\\.?",
      "flags": "g",
      "replacement": "[REDACTED_ORG]"
    },
    {
      "id": "site_name_label",
      "category": "location",
      "regex": "\\b(?:site|facility|plant|yard)\\s*[:=]\\s*[\"']?[^\\n,\"']{2,80}",
      "flags": "gi",
      "replacement": "site: [REDACTED_SITE]"
    },
    {
      "id": "project_code_leak",
      "category": "company",
      "regex": "\\b(?:customer|client|owner)\\s*[:=]\\s*[\"']?[^\\n,\"']{2,80}",
      "flags": "gi",
      "replacement": "client: [REDACTED_CLIENT]"
    }
  ],
  "dropKeys": [
    "imageBase64",
    "image_base64",
    "photoBase64",
    "ssn",
    "sin",
    "password",
    "token",
    "accessToken",
    "refreshToken",
    "authorization",
    "email",
    "phone",
    "phoneNumber",
    "mobile",
    "address",
    "homeAddress",
    "gps",
    "latitude",
    "longitude",
    "lat",
    "lng",
    "geolocation",
    "workerName",
    "fullName",
    "companyLegalName"
  ],
  "flha": {
    "maxHazardSummaryChars": 240,
    "maxControlsPerHazard": 8,
    "ownerSafeSummaryTemplate": "Residual risk band: {{residualRisk}} ({{energyType}})",
    "stripActiveHazardDetailForOwner": true
  }
}
