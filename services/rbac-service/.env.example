NODE_ENV=development
PORT=3002
DATABASE_URL=postgresql://vera_rbac:vera_rbac_secret@localhost:5434/vera_rbac?schema=public

# Must match Vera Auth Service access token secret
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long

PERMISSION_CACHE_TTL_MS=60000
PERMISSION_CACHE_MAX_ENTRIES=10000

LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# Optional: auth service URL for token introspection fallback
AUTH_VALIDATE_URL=http://localhost:3001/auth/validate-token
