# VeriForge SaaS API + worker — copy to .env
# Full map: infra/veriforge/.env.example | docs/VERIFORGE-ENV-VARIABLES.md

NODE_ENV=development
PORT=3020

# DATABASE (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/veriforge?schema=public
DB_POOL_SIZE=5
DB_POOL_TIMEOUT=20
RUN_DB_SEED=1
ALLOW_DESTRUCTIVE_MIGRATIONS=0

# JWT / AUTH (required)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_SECRETS=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
JWT_ISSUER=veriforge
JWT_AUDIENCE=veriforge-app
FIELD_ENCRYPTION_KEY=dev-only-field-encryption-key-32b
FIELD_ENCRYPTION_OPTIONAL=false
COOKIE_SECURE=false
ENFORCE_HTTPS=false
CORS_ORIGIN=*

# REDIS
REDIS_URL=redis://localhost:6379
REDIS_DISABLED=false
CACHE_TTL_RBAC_SEC=120
CACHE_TTL_PRICING_SEC=300
CACHE_TTL_MODULES_SEC=300

# EMAIL (Resend — EMAIL_PROVIDER_API_KEY alias)
RESEND_API_KEY=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=VeriForge <onboarding@veriforge.local>
APP_PUBLIC_URL=http://localhost:5175

# CRON
CRON_ENABLED=true
RUN_CRON_IN_API=false
WORKER_MODE=false
WORKER_HEALTH_PORT=3021
TRIAL_JOB_BATCH_SIZE=100
TRIAL_JOB_CONCURRENCY=5

# LOGGING
LOG_LEVEL=info
OTEL_ENABLED=false
OTEL_SERVICE_NAME=veriforge-saas-service
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_DIAG_LOG=false
METRICS_BEARER_TOKEN=

# DEVELOPER
DEVELOPER_BOOTSTRAP_SECRET=
PLATFORM_ADMIN_EMAILS=admin@veriforge.local
SEED_DEV_USERS=1
SEED_DEV_ADMIN_EMAIL=admin@veriforge.local
SEED_DEV_ADMIN_PASSWORD=Str0ng!Passw0rd
SEED_DEV_TRIAL_DAYS=90

# BILLING
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ANNUAL_DISCOUNT_PERCENT=17
TRIAL_DAYS=7
CURRENCY=USD

# PRIVACY
PII_USER_RETENTION_DAYS=3650
AUDIT_LOG_RETENTION_DAYS=2555

# FEATURE FLAGS (optional JSON — platform flags live in DB)
FEATURE_FLAGS={"newScorecardEngine":true}

# DOCUMENT CENTER STORAGE
DOCUMENT_STORAGE_PROVIDER=local
# DOCUMENT_STORAGE_LOCAL_PATH=./uploads/documents
# DOCUMENT_STORAGE_PUBLIC_BASE_URL=http://localhost:3020/uploads/documents
# DOCUMENT_S3_BUCKET=
# DOCUMENT_S3_PUT_URL=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=veriforge-documents

