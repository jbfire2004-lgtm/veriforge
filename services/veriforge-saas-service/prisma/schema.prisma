generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgStatus {
  active
  suspended
  closed
}

enum UserStatus {
  invited
  active
  disabled
}

enum ModuleCode {
  vericore
  veripm
  verihub
}

enum BillingCycle {
  monthly
  annual
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  incomplete
  unpaid
  paused
}

enum SubscriptionItemStatus {
  active
  trialing
  canceled
  incomplete
}

enum OnboardingStatus {
  not_started
  in_progress
  completed
}

enum TrialNotificationKind {
  welcome
  trial_ending_soon
  trial_ended
  founder_new_trial
}

enum SystemRoleCode {
  owner
  admin
  manager
  user
}

enum HiringClientStatus {
  active
  suspended
}

enum HiringClientRole {
  ClientAdmin
  Reviewer
}

enum ContractAwardStatus {
  pending
  awarded
  declined
  withdrawn
}

enum DeveloperRole {
  SystemAdmin
  ModuleArchitect
  SupportEngineer
  BillingAdmin
}

enum DeveloperStatus {
  active
  disabled
}

enum ComplianceArtifactType {
  insurance
  wcb
  cor
  scsa
  custom
}

enum ComplianceArtifactStatus {
  valid
  expired
  pending_review
  rejected
}

/// Product modules billed and gated via SubscriptionProfile.
enum ProductModuleCode {
  core
  pm
  safety
  compliance
  wallet
  training
  audits
  investigations
  scorecards
  hiring_client_tools
}

enum SubscriptionPlan {
  trial
  starter
  professional
  enterprise
}

model Module {
  id          String     @id @default(uuid()) @db.Uuid
  code        ModuleCode @unique
  name        String
  description String?
  isActive    Boolean    @default(true) @map("is_active")
  sortOrder   Int        @default(0) @map("sort_order")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  prices               ModulePrice[]
  organizationModules  OrganizationModule[]
  modulePermissions    ModulePermission[]
  subscriptionItems    SubscriptionItem[]

  @@map("modules")
}

model ModulePrice {
  id               String       @id @default(uuid()) @db.Uuid
  moduleId         String       @map("module_id") @db.Uuid
  billingCycle     BillingCycle @map("billing_cycle")
  currency         String       @default("USD") @db.Char(3)
  unitAmountCents  Int          @map("unit_amount_cents")
  externalPriceId  String?      @map("external_price_id")
  effectiveFrom    DateTime     @default(now()) @map("effective_from")
  effectiveTo      DateTime?    @map("effective_to")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  module Module @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@index([moduleId])
  @@index([moduleId, billingCycle, currency, effectiveTo])
  @@map("module_prices")
}

model Organization {
  id                   String       @id @default(uuid()) @db.Uuid
  name                 String
  slug                 String       @unique
  status               OrgStatus    @default(active)
  industry             String?
  address              String?      @db.Text
  contactEmail         String?      @map("contact_email")
  contactPhone         String?      @map("contact_phone")
  subscriptionProfile  Json?        @map("subscription_profile")
  modulesEnabled       Json         @default("[]") @map("modules_enabled")
  trialStart           DateTime?    @map("trial_start")
  trialEnd             DateTime?    @map("trial_end")
  isTrialActive        Boolean      @default(false) @map("is_trial_active")
  externalCustomerId   String?      @unique @map("external_customer_id")
  billingEmail         String?      @map("billing_email")
  defaultBillingCycle  BillingCycle @default(monthly) @map("default_billing_cycle")
  timezone             String       @default("UTC")
  onboardingNotes      String?      @map("onboarding_notes") @db.Text
  onboardingChecklist  Json?        @map("onboarding_checklist")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  users                User[]
  userRoles            UserRole[]
  orgRoles             OrgRole[]
  organizationModules  OrganizationModule[]
  subscriptions        Subscription[]
  subscriptionItems    SubscriptionItem[]
  onboarding           Onboarding?
  onboardingEvents     OnboardingEvent[]
  trialNotifications   TrialNotificationLog[]
  complianceArtifacts  ComplianceArtifact[]
  scorecards           Scorecard[]
  complianceNotifications ComplianceNotificationLog[]
  subscriptionProfileRecord SubscriptionProfile?
  notifications        Notification[]
  moduleUsageMetrics   ModuleUsageMetric[]
  contractorProfile    ContractorProfile?
  auditTemplates       AuditTemplate[]

  @@index([status])
  @@index([isTrialActive])
  @@index([isTrialActive, trialEnd])
  @@map("organizations")
}

/// Directory profile for a contractor org (Organization is the contractor tenant).
model ContractorProfile {
  id               String          @id @default(uuid()) @db.Uuid
  /// Same as Organization.id — public contractor_id in APIs.
  contractorId     String          @unique @map("contractor_id") @db.Uuid
  legalName        String          @map("legal_name")
  tradeName        String?         @map("trade_name")
  safetyRating     Float           @default(0) @map("safety_rating")
  insuranceStatus  InsuranceStatus @default(unknown) @map("insurance_status")
  complianceScore  Int             @default(0) @map("compliance_score")
  /// { email, phone, website, address, primaryContact }
  contactInfo      Json            @default("{}") @map("contact_info")
  industry         String?
  region           String?
  isListed         Boolean         @default(true) @map("is_listed")
  notes            String?         @db.Text
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  documents    ContractorDocument[]
  documentCenterDocuments DocumentCenterDocument[]
  audits       ContractorAudit[]
  evaluationAudits EvaluationAudit[]
  programVerifications ProgramVerification[]
  quickCheckRuns QuickCheckRun[]
  sites        ContractorSite[]
  connections  ContractorConnection[]

  @@index([isListed, complianceScore])
  @@index([insuranceStatus])
  @@index([legalName])
  @@map("contractor_profiles")
}

enum InsuranceStatus {
  valid
  expiring
  expired
  missing
  unknown
}

enum ContractorConnectionStatus {
  pending
  approved
  rejected
  revoked
}

enum ContractorDocumentKind {
  insurance
  wcb
  cor
  scsa
  license
  other
}

enum ContractorDocumentStatus {
  valid
  expired
  pending_review
  rejected
  missing
}

enum ContractorAuditResult {
  pass
  conditional
  fail
  pending
}

model ContractorDocument {
  id           String                   @id @default(uuid()) @db.Uuid
  contractorId String                   @map("contractor_id") @db.Uuid
  kind         ContractorDocumentKind
  label        String?
  fileUrl      String                   @map("file_url")
  expiryDate   DateTime?                @map("expiry_date")
  status       ContractorDocumentStatus @default(pending_review)
  meta         Json?
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")

  profile ContractorProfile @relation(fields: [contractorId], references: [contractorId], onDelete: Cascade)

  @@index([contractorId, kind])
  @@index([contractorId, status])
  @@map("contractor_documents")
}

/// Document Center — versioned contractor documents with exemptions.
enum DocumentCategory {
  insurance
  safety_program
  license
  training
}

enum DocumentCenterStatus {
  valid
  expiring
  expired
  pending_review
  rejected
  exempt
  missing
}

model DocumentCenterDocument {
  id                   String               @id @default(uuid()) @db.Uuid
  contractorId         String               @map("contractor_id") @db.Uuid
  category             DocumentCategory
  title                String
  expiryDate           DateTime?            @map("expiry_date")
  status               DocumentCenterStatus @default(pending_review)
  exemptionFlag        Boolean              @default(false) @map("exemption_flag")
  exemptionReason      String?              @map("exemption_reason") @db.Text
  exemptionExpiresAt   DateTime?            @map("exemption_expires_at")
  currentVersion       Int                  @default(1) @map("current_version")
  /// Current file URL (denormalized from latest version)
  fileUrl              String?              @map("file_url")
  storageKey           String?              @map("storage_key")
  storageProvider      String?              @map("storage_provider")
  meta                 Json?
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  profile  ContractorProfile @relation(fields: [contractorId], references: [contractorId], onDelete: Cascade)
  versions DocumentVersion[]

  @@index([contractorId, category])
  @@index([contractorId, status])
  @@index([expiryDate])
  @@index([exemptionFlag])
  @@map("document_center_documents")
}

model DocumentVersion {
  id           String   @id @default(uuid()) @db.Uuid
  documentId   String   @map("document_id") @db.Uuid
  version      Int
  fileUrl      String   @map("file_url")
  storageKey   String?  @map("storage_key")
  fileName     String?  @map("file_name")
  mimeType     String?  @map("mime_type")
  sizeBytes    Int?     @map("size_bytes")
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  changeNote   String?  @map("change_note")
  createdAt    DateTime @default(now()) @map("created_at")

  document DocumentCenterDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId, createdAt])
  @@map("document_versions")
}

model ContractorAudit {
  id           String                @id @default(uuid()) @db.Uuid
  contractorId String                @map("contractor_id") @db.Uuid
  title        String
  auditor      String?
  auditedAt    DateTime              @map("audited_at")
  result       ContractorAuditResult @default(pending)
  score        Int?
  findings     Json?
  reportUrl    String?               @map("report_url")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  profile          ContractorProfile @relation(fields: [contractorId], references: [contractorId], onDelete: Cascade)
  evaluationAudits EvaluationAudit[]

  @@index([contractorId, auditedAt])
  @@index([contractorId, result])
  @@map("contractor_audits")
}

/// Audit & Evaluation — templates, reviews, findings, corrective actions.
enum AuditEvaluationStatus {
  draft
  assigned
  in_review
  scored
  closed
  cancelled
}

enum AuditFindingSeverity {
  critical
  major
  minor
  observation
}

enum AuditFindingStatus {
  open
  addressed
  accepted
  waived
}

enum CorrectiveActionStatus {
  open
  in_progress
  completed
  waived
  overdue
}

enum AuditQuestionType {
  score
  yes_no
  text
  na
}

model AuditTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  /// Null = platform default template; set = org-owned
  orgId       String?  @map("org_id") @db.Uuid
  name        String
  description String?  @db.Text
  version     Int      @default(1)
  isActive    Boolean  @default(true) @map("is_active")
  /// e.g. safety, quality, prequalification
  category    String   @default("safety")
  meta        Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  organization Organization?         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sections     AuditTemplateSection[]
  audits       EvaluationAudit[]

  @@index([orgId, isActive])
  @@index([isActive, category])
  @@map("audit_templates")
}

model AuditTemplateSection {
  id         String @id @default(uuid()) @db.Uuid
  templateId String @map("template_id") @db.Uuid
  title      String
  description String? @db.Text
  /// Relative weight vs other sections (e.g. 30 = 30%)
  weight     Float  @default(1)
  sortOrder  Int    @default(0) @map("sort_order")

  template  AuditTemplate           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  questions AuditTemplateQuestion[]

  @@index([templateId, sortOrder])
  @@map("audit_template_sections")
}

model AuditTemplateQuestion {
  id          String            @id @default(uuid()) @db.Uuid
  sectionId   String            @map("section_id") @db.Uuid
  prompt      String            @db.Text
  helpText    String?           @map("help_text") @db.Text
  questionType AuditQuestionType @default(score) @map("question_type")
  /// Relative weight within section
  weight      Float             @default(1)
  maxScore    Float             @default(100) @map("max_score")
  required    Boolean           @default(true)
  sortOrder   Int               @default(0) @map("sort_order")
  /// Optional Document Center category hint for reviewers
  documentCategoryHint String?  @map("document_category_hint")

  section   AuditTemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  responses AuditResponse[]
  findings  AuditFinding[]

  @@index([sectionId, sortOrder])
  @@map("audit_template_questions")
}

model EvaluationAudit {
  id               String                @id @default(uuid()) @db.Uuid
  contractorId     String                @map("contractor_id") @db.Uuid
  templateId       String                @map("template_id") @db.Uuid
  title            String
  status           AuditEvaluationStatus @default(draft)
  score            Float?
  /// Cached per-section scores { sectionId: { score, weight } }
  sectionScores    Json?                 @map("section_scores")
  reviewerId       String?               @map("reviewer_id") @db.Uuid
  reviewerName     String?               @map("reviewer_name")
  assignedAt       DateTime?             @map("assigned_at")
  startedAt        DateTime?             @map("started_at")
  completedAt      DateTime?             @map("completed_at")
  dueDate          DateTime?             @map("due_date")
  createdById      String?               @map("created_by_id") @db.Uuid
  hiringClientId   String?               @map("hiring_client_id") @db.Uuid
  /// Mirror into Contractor Directory audit for compliance scoring
  directoryAuditId String?               @unique @map("directory_audit_id") @db.Uuid
  /// Snapshot of Document Center dashboard at audit start
  documentSnapshot Json?                 @map("document_snapshot")
  notes            String?               @db.Text
  meta             Json?
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  profile        ContractorProfile @relation(fields: [contractorId], references: [contractorId], onDelete: Cascade)
  template       AuditTemplate     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  directoryAudit ContractorAudit?  @relation(fields: [directoryAuditId], references: [id], onDelete: SetNull)
  responses      AuditResponse[]
  findings       AuditFinding[]
  correctiveActions CorrectiveAction[]

  @@index([contractorId, status])
  @@index([templateId])
  @@index([reviewerId, status])
  @@index([hiringClientId])
  @@map("evaluation_audits")
}

model AuditResponse {
  id         String   @id @default(uuid()) @db.Uuid
  auditId    String   @map("audit_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  /// Normalized 0–maxScore numeric contribution
  scoreValue Float?   @map("score_value")
  /// yes_no / text raw answer
  answerText String?  @map("answer_text") @db.Text
  isNa       Boolean  @default(false) @map("is_na")
  notes      String?  @db.Text
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdAt  DateTime @default(now()) @map("created_at")

  audit    EvaluationAudit       @relation(fields: [auditId], references: [id], onDelete: Cascade)
  question AuditTemplateQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([auditId, questionId])
  @@index([auditId])
  @@map("audit_responses")
}

model AuditFinding {
  id          String              @id @default(uuid()) @db.Uuid
  auditId     String              @map("audit_id") @db.Uuid
  questionId  String?             @map("question_id") @db.Uuid
  title       String
  description String?             @db.Text
  severity    AuditFindingSeverity @default(minor)
  status      AuditFindingStatus  @default(open)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  audit             EvaluationAudit       @relation(fields: [auditId], references: [id], onDelete: Cascade)
  question          AuditTemplateQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  correctiveActions CorrectiveAction[]

  @@index([auditId, status])
  @@index([auditId, severity])
  @@map("audit_findings")
}

model CorrectiveAction {
  id          String                 @id @default(uuid()) @db.Uuid
  auditId     String                 @map("audit_id") @db.Uuid
  findingId   String?                @map("finding_id") @db.Uuid
  title       String
  description String?                @db.Text
  ownerName   String?                @map("owner_name")
  ownerId     String?                @map("owner_id") @db.Uuid
  dueDate     DateTime?              @map("due_date")
  status      CorrectiveActionStatus @default(open)
  completedAt DateTime?              @map("completed_at")
  evidenceUrl String?                @map("evidence_url")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  audit   EvaluationAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  finding AuditFinding?   @relation(fields: [findingId], references: [id], onDelete: SetNull)

  @@index([auditId, status])
  @@index([findingId])
  @@index([dueDate, status])
  @@map("corrective_actions")
}

/// Program Verification System (PVS) — written safety programs + safety matrix.
enum PvsProgramCategory {
  hazard_assessment
  emergency_response
  incident_investigation
  ppe
  working_at_heights
  confined_space
  lockout_tagout
  substance_abuse
  orientation_training
  environmental
  other
}

enum PvsVerificationStatus {
  draft
  submitted
  in_review
  verified
  rejected
  exempt
  missing
}

enum PvsExemptionApprovalStatus {
  none
  pending
  approved
  rejected
}

enum PvsElementStatus {
  pending
  verified
  missing
  exempt
  na
}

model ProgramVerification {
  id                   String                     @id @default(uuid()) @db.Uuid
  contractorId         String                     @map("contractor_id") @db.Uuid
  programCategory      PvsProgramCategory         @map("program_category")
  title                String
  /// Written program body / summary
  programBody          String?                    @map("program_body") @db.Text
  fileUrl              String?                    @map("file_url")
  verificationStatus   PvsVerificationStatus      @default(draft) @map("verification_status")
  exemptionFlag        Boolean                    @default(false) @map("exemption_flag")
  exemptionReason      String?                    @map("exemption_reason") @db.Text
  exemptionApprovalStatus PvsExemptionApprovalStatus @default(none) @map("exemption_approval_status")
  exemptionReviewedAt  DateTime?                  @map("exemption_reviewed_at")
  exemptionReviewedBy  String?                    @map("exemption_reviewed_by") @db.Uuid
  reviewerId           String?                    @map("reviewer_id") @db.Uuid
  reviewerName         String?                    @map("reviewer_name")
  verifiedAt           DateTime?                  @map("verified_at")
  verificationNotes    String?                    @map("verification_notes") @db.Text
  /// Denormalized matrix snapshot for API convenience
  safetyMatrix         Json                       @default("[]") @map("safety_matrix")
  version              Int                        @default(1)
  meta                 Json?
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")

  profile  ContractorProfile @relation(fields: [contractorId], references: [contractorId], onDelete: Cascade)
  elements PvsMatrixElement[]

  @@unique([contractorId, programCategory])
  @@index([contractorId, verificationStatus])
  @@index([reviewerId, verificationStatus])
  @@index([exemptionFlag, exemptionApprovalStatus])
  @@map("program_verifications")
}

model PvsMatrixElement {
  id          String           @id @default(uuid()) @db.Uuid
  pvsId       String           @map("pvs_id") @db.Uuid
  elementKey  String           @map("element_key")
  elementLabel String          @map("element_label")
  required    Boolean          @default(true)
  status      PvsElementStatus @default(pending)
  notes       String?          @db.Text
  sortOrder   Int              @default(0) @map("sort_order")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  program ProgramVerification @relation(fields: [pvsId], references: [id], onDelete: Cascade)

  @@unique([pvsId, elementKey])
  @@index([pvsId, status])
  @@map("pvs_matrix_elements")
}

enum QuickCheckRiskLevel {
  green
  yellow
  red
}

/// Logged QuickCheck runs for analytics.
model QuickCheckRun {
  id               String              @id @default(uuid()) @db.Uuid
  contractorId     String              @map("contractor_id") @db.Uuid
  complianceScore  Int                 @map("compliance_score")
  riskLevel        QuickCheckRiskLevel @map("risk_level")
  /// { documents, audits, pvs, insurance, … }
  breakdown        Json
  /// Array of { code, label, severity, source }
  missingItems     Json                @default("[]") @map("missing_items")
  triggeredById    String?             @map("triggered_by_id") @db.Uuid
  /// profile | analytics | page | api | modal
  source           String              @default("api")
  hiringClientId   String?             @map("hiring_client_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at")

  profile ContractorProfile @relation(fields: [contractorId], references: [contractorId], onDelete: Cascade)

  @@index([contractorId, createdAt])
  @@index([riskLevel, createdAt])
  @@index([source, createdAt])
  @@map("quickcheck_runs")
}

model ContractorSite {
  id           String   @id @default(uuid()) @db.Uuid
  contractorId String   @map("contractor_id") @db.Uuid
  name         String
  address      String?  @db.Text
  region       String?
  isActive     Boolean  @default(true) @map("is_active")
  meta         Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  profile ContractorProfile @relation(fields: [contractorId], references: [contractorId], onDelete: Cascade)

  @@index([contractorId, isActive])
  @@map("contractor_sites")
}

/// Hiring client ↔ contractor connection workflow (request / approve / reject).
model ContractorConnection {
  id                String                     @id @default(uuid()) @db.Uuid
  hiringClientId    String                     @map("hiring_client_id") @db.Uuid
  contractorId      String                     @map("contractor_id") @db.Uuid
  status            ContractorConnectionStatus @default(pending)
  message           String?                    @db.Text
  responseMessage   String?                    @map("response_message") @db.Text
  requestedByUserId String?                    @map("requested_by_user_id") @db.Uuid
  respondedByUserId String?                    @map("responded_by_user_id") @db.Uuid
  respondedAt       DateTime?                  @map("responded_at")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  hiringClient HiringClient      @relation(fields: [hiringClientId], references: [id], onDelete: Cascade)
  profile      ContractorProfile @relation(fields: [contractorId], references: [contractorId], onDelete: Cascade)

  @@unique([hiringClientId, contractorId])
  @@index([contractorId, status])
  @@index([hiringClientId, status])
  @@map("contractor_connections")
}

/// Canonical subscription + product module entitlements per organization.
model SubscriptionProfile {
  id             String             @id @default(uuid()) @db.Uuid
  orgId          String             @unique @map("org_id") @db.Uuid
  modulesEnabled Json               @default("{}") @map("modules_enabled")
  billingPlan    SubscriptionPlan   @default(trial) @map("billing_plan")
  billingStatus  SubscriptionStatus @default(trialing) @map("billing_status")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([billingStatus])
  @@map("subscription_profiles")
}

model Onboarding {
  id          String           @id @default(uuid()) @db.Uuid
  orgId       String           @unique @map("org_id") @db.Uuid
  status      OnboardingStatus @default(not_started)
  notes       String?          @db.Text
  checklist   Json?
  assignedTo  String?          @map("assigned_to")
  startedAt   DateTime?        @map("started_at")
  completedAt DateTime?        @map("completed_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("onboardings")
}

/// Org-scoped roles (Owner / Admin / Manager / Worker + custom).
model OrgRole {
  id          String          @id @default(uuid()) @db.Uuid
  orgId       String          @map("org_id") @db.Uuid
  name        String
  description String?
  permissions Json            @default("[]")
  systemCode  SystemRoleCode? @map("system_code")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  users        OrgRoleUser[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("org_roles")
}

model OrgRoleUser {
  id        String   @id @default(uuid()) @db.Uuid
  orgRoleId String   @map("org_role_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  orgRole OrgRole @relation(fields: [orgRoleId], references: [id], onDelete: Cascade)
  user    User    @relation("OrgRoleUserLink", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgRoleId, userId])
  @@index([userId])
  @@map("org_role_users")
}

model OnboardingEvent {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  type      String
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([type, createdAt])
  @@map("onboarding_events")
}

/// Idempotent send log — one row per (org, kind).
model TrialNotificationLog {
  id             String                @id @default(uuid()) @db.Uuid
  orgId          String                @map("org_id") @db.Uuid
  kind           TrialNotificationKind
  recipientEmail String                @map("recipient_email")
  sentAt         DateTime              @default(now()) @map("sent_at")
  meta           Json?

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, kind])
  @@index([orgId])
  @@index([kind, sentAt])
  @@map("trial_notification_logs")
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("platform_settings")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  orgId           String     @map("org_id") @db.Uuid
  email           String
  passwordHash    String?    @map("password_hash")
  fullName        String     @map("full_name")
  firstName       String?    @map("first_name")
  lastName        String?    @map("last_name")
  /// AES-GCM ciphertext for PII display name (optional dual-write during rollout)
  fullNameEnc     String?    @map("full_name_enc")
  status          UserStatus @default(invited)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  mfaEnabled      Boolean    @default(false) @map("mfa_enabled")
  /// Encrypted TOTP secret (AES-GCM); null when MFA off
  mfaSecretEnc    String?    @map("mfa_secret_enc")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  organization  Organization  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  roles         UserRole[]    @relation("UserRoleUser")
  assignedRoles UserRole[]    @relation("UserRoleAssigner")
  orgRoleLinks  OrgRoleUser[] @relation("OrgRoleUserLink")
  refreshTokens RefreshToken[]
  uploadedComplianceArtifacts ComplianceArtifact[] @relation("ComplianceUploader")

  @@unique([orgId, email])
  @@index([orgId])
  @@index([status])
  @@map("users")
}

model Role {
  id          String         @id @default(uuid()) @db.Uuid
  code        SystemRoleCode @unique
  name        String
  description String?
  isSystem    Boolean        @default(true) @map("is_system")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions   RolePermission[]
  modulePermissions ModulePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model ModulePermission {
  moduleId     String   @map("module_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  module     Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([moduleId, permissionId])
  @@index([permissionId])
  @@map("module_permissions")
}

model UserRole {
  id         String    @id @default(uuid()) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  assignedAt DateTime  @default(now()) @map("assigned_at")
  assignedBy String?   @map("assigned_by") @db.Uuid
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assigner     User?        @relation("UserRoleAssigner", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([userId])
  @@index([userId, revokedAt])
  @@index([roleId])
  @@map("user_roles")
}

model OrganizationModule {
  id            String    @id @default(uuid()) @db.Uuid
  orgId         String    @map("org_id") @db.Uuid
  moduleId      String    @map("module_id") @db.Uuid
  enabled       Boolean   @default(true)
  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  module       Module       @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@index([orgId])
  @@index([moduleId])
  @@index([orgId, effectiveTo, enabled])
  @@map("organization_modules")
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  orgId                  String             @map("org_id") @db.Uuid
  status                 SubscriptionStatus @default(trialing)
  billingCycle           BillingCycle       @default(monthly) @map("billing_cycle")
  currency               String             @default("USD") @db.Char(3)
  trialStart             DateTime?          @map("trial_start")
  trialEnd               DateTime?          @map("trial_end")
  currentPeriodStart     DateTime?          @map("current_period_start")
  currentPeriodEnd       DateTime?          @map("current_period_end")
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt             DateTime?          @map("canceled_at")
  externalCustomerId     String?            @map("external_customer_id")
  externalSubscriptionId String?            @unique @map("external_subscription_id")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  items        SubscriptionItem[]

  @@index([orgId])
  @@index([status])
  @@map("subscriptions")
}

model SubscriptionItem {
  id                          String                 @id @default(uuid()) @db.Uuid
  subscriptionId              String                 @map("subscription_id") @db.Uuid
  orgId                       String                 @map("org_id") @db.Uuid
  moduleId                    String                 @map("module_id") @db.Uuid
  status                      SubscriptionItemStatus @default(active)
  billingCycle                BillingCycle           @map("billing_cycle")
  quantity                    Int                    @default(1)
  unitAmountCents             Int                    @map("unit_amount_cents")
  currency                    String                 @default("USD") @db.Char(3)
  externalSubscriptionItemId  String?                @unique @map("external_subscription_item_id")
  externalPriceId             String?                @map("external_price_id")
  createdAt                   DateTime               @default(now()) @map("created_at")
  updatedAt                   DateTime               @updatedAt @map("updated_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  module       Module       @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@index([subscriptionId])
  @@index([orgId])
  @@index([moduleId])
  @@map("subscription_items")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String?  @map("org_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  resource   String?
  resourceId String?  @map("resource_id")
  ip         String?
  userAgent  String?  @map("user_agent")
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([orgId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// Idempotent Stripe webhook processing
model StripeWebhookEvent {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @unique @map("event_id")
  type        String
  processedAt DateTime @default(now()) @map("processed_at")
  payloadHash String?  @map("payload_hash")

  @@index([type, processedAt])
  @@map("stripe_webhook_events")
}

/// App release ↔ migration tag (complements Prisma `_prisma_migrations`)
model SchemaRelease {
  id            String   @id @default(uuid()) @db.Uuid
  releaseTag    String   @unique @map("release_tag")
  migrationName String   @map("migration_name")
  appliedAt     DateTime @default(now()) @map("applied_at")
  notes         String?

  @@index([migrationName])
  @@map("schema_releases")
}

/// EPC / owner / municipality / GC reviewing contractors before award
model HiringClient {
  id           String             @id @default(uuid()) @db.Uuid
  companyName  String             @map("company_name")
  contactName  String             @map("contact_name")
  contactEmail String             @map("contact_email")
  contactPhone String?            @map("contact_phone")
  status       HiringClientStatus @default(active)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  users       HiringClientUser[]
  awards      ContractAward[]
  connections ContractorConnection[]

  @@index([status])
  @@index([contactEmail])
  @@map("hiring_clients")
}

model HiringClientUser {
  id             String           @id @default(uuid()) @db.Uuid
  hiringClientId String           @map("hiring_client_id") @db.Uuid
  email          String
  passwordHash   String           @map("password_hash")
  role           HiringClientRole @default(Reviewer)
  permissions    Json             @default("[]")
  fullName       String?          @map("full_name")
  status         UserStatus       @default(active)
  lastLoginAt    DateTime?        @map("last_login_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  hiringClient  HiringClient               @relation(fields: [hiringClientId], references: [id], onDelete: Cascade)
  refreshTokens HiringClientRefreshToken[]
  awards        ContractAward[]            @relation("AwardActor")
  reviewedArtifacts ComplianceArtifact[]   @relation("ComplianceReviewer")

  @@unique([hiringClientId, email])
  @@index([email])
  @@index([hiringClientId])
  @@map("hiring_client_users")
}

model HiringClientRefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user HiringClientUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("hiring_client_refresh_tokens")
}

/// Record of a hiring client awarding (or intending to award) work to a contractor org
model ContractAward {
  id               String              @id @default(uuid()) @db.Uuid
  hiringClientId   String              @map("hiring_client_id") @db.Uuid
  contractorOrgId  String              @map("contractor_org_id") @db.Uuid
  awardedByUserId  String?             @map("awarded_by_user_id") @db.Uuid
  status           ContractAwardStatus @default(awarded)
  projectName      String?             @map("project_name")
  notes            String?             @db.Text
  awardedAt        DateTime            @default(now()) @map("awarded_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  hiringClient HiringClient      @relation(fields: [hiringClientId], references: [id], onDelete: Cascade)
  awardedBy    HiringClientUser? @relation("AwardActor", fields: [awardedByUserId], references: [id], onDelete: SetNull)

  @@index([hiringClientId, awardedAt])
  @@index([contractorOrgId])
  @@map("contract_awards")
}

/// Platform developer / support engineer (system-level account)
model Developer {
  id           String          @id @default(uuid()) @db.Uuid
  email        String          @unique
  passwordHash String          @map("password_hash")
  role         DeveloperRole
  permissions  Json            @default("[]")
  fullName     String?         @map("full_name")
  status       DeveloperStatus @default(active)
  lastLoginAt  DateTime?       @map("last_login_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  refreshTokens     DeveloperRefreshToken[]
  apiKeys           DeveloperApiKey[]
  actionLogs        DeveloperActionLog[]
  impersonationSessions ImpersonationSession[]

  @@index([role])
  @@index([status])
  @@map("developers")
}

model DeveloperRefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  developerId  String    @map("developer_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  developer Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  @@index([developerId])
  @@index([expiresAt])
  @@map("developer_refresh_tokens")
}

model DeveloperApiKey {
  id           String    @id @default(uuid()) @db.Uuid
  developerId  String    @map("developer_id") @db.Uuid
  name         String
  keyPrefix    String    @map("key_prefix")
  keyHash      String    @unique @map("key_hash")
  scopes       Json      @default("[]")
  lastUsedAt   DateTime? @map("last_used_at")
  revokedAt    DateTime? @map("revoked_at")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  developer Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  @@index([developerId])
  @@map("developer_api_keys")
}

model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?
  enabled     Boolean  @default(false)
  payload     Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model ImpersonationSession {
  id              String    @id @default(uuid()) @db.Uuid
  developerId     String    @map("developer_id") @db.Uuid
  targetOrgId     String    @map("target_org_id") @db.Uuid
  reason          String?
  startedAt       DateTime  @default(now()) @map("started_at")
  endedAt         DateTime? @map("ended_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  developer Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  @@index([developerId, startedAt])
  @@index([targetOrgId])
  @@map("impersonation_sessions")
}

/// Dedicated audit trail for developer console actions
model DeveloperActionLog {
  id           String   @id @default(uuid()) @db.Uuid
  developerId  String?  @map("developer_id") @db.Uuid
  action       String
  resource     String?
  resourceId   String?  @map("resource_id")
  ip           String?
  userAgent    String?  @map("user_agent")
  meta         Json?
  createdAt    DateTime @default(now()) @map("created_at")

  developer Developer? @relation(fields: [developerId], references: [id], onDelete: SetNull)

  @@index([developerId, createdAt])
  @@index([action, createdAt])
  @@map("developer_action_logs")
}

/// Contractor compliance artifacts (insurance, WCB, COR, SCSA, custom)
model ComplianceArtifact {
  id           String                   @id @default(uuid()) @db.Uuid
  orgId        String                   @map("org_id") @db.Uuid
  type         ComplianceArtifactType
  label        String?
  fileUrl      String                   @map("file_url")
  expiryDate   DateTime?                @map("expiry_date")
  status       ComplianceArtifactStatus @default(pending_review)
  reviewerId   String?                  @map("reviewer_id") @db.Uuid
  uploadedById String?                  @map("uploaded_by_id") @db.Uuid
  reviewNotes  String?                  @map("review_notes") @db.Text
  reviewedAt   DateTime?                @map("reviewed_at")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  reviewer     HiringClientUser? @relation("ComplianceReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  uploadedBy   User?             @relation("ComplianceUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([orgId, type])
  @@index([orgId, status])
  @@index([expiryDate])
  @@index([status, expiryDate])
  @@map("compliance_artifacts")
}

/// Contractor safety scorecard (global + compliance + project scores).
/// Table name kept as org_compliance_scorecards for migration continuity.
model Scorecard {
  id                  String   @id @default(uuid()) @db.Uuid
  orgId               String   @map("org_id") @db.Uuid
  /// Blended / global safety score (0–100). Alias for overallScore consumers.
  globalScore         Int      @default(0) @map("global_score")
  /// Legacy overall score — kept in sync with globalScore.
  overallScore        Int      @default(0) @map("overall_score")
  complianceScore     Int      @default(0) @map("compliance_score")
  complianceBreakdown Json     @default("{}") @map("compliance_breakdown")
  /// Per-project score slices: [{ projectId, projectName, overall, safety, ... }]
  projectScores       Json     @default("[]") @map("project_scores")
  calculatedAt        DateTime @default(now()) @map("calculated_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId])
  @@index([orgId])
  @@index([globalScore])
  @@map("org_compliance_scorecards")
}

enum ComplianceNotificationKind {
  expiry_warning
  expired
  review_pending
  approved
  rejected
}

model ComplianceNotificationLog {
  id             String                     @id @default(uuid()) @db.Uuid
  orgId          String                     @map("org_id") @db.Uuid
  artifactId     String?                    @map("artifact_id") @db.Uuid
  kind           ComplianceNotificationKind
  recipientEmail String                     @map("recipient_email")
  sentAt         DateTime                   @default(now()) @map("sent_at")
  meta           Json?

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, artifactId, kind])
  @@index([orgId, sentAt])
  @@index([kind, sentAt])
  @@map("compliance_notification_logs")
}

enum NotificationChannel {
  email
  in_app
}

enum NotificationDeliveryStatus {
  queued
  sent
  failed
}

/// Unified in-app + delivery notification store.
model Notification {
  id              String                      @id @default(uuid()) @db.Uuid
  orgId           String?                     @map("org_id") @db.Uuid
  userId          String?                     @map("user_id") @db.Uuid
  /// compliance_expiry | scorecard_update | billing_issue | module_update | system_alert
  type            String                      @default("system_alert")
  title           String                      @default("")
  /// Message body (also used for email channel text).
  body            String                      @db.Text
  read            Boolean                     @default(false)
  channel         NotificationChannel         @default(in_app)
  status          NotificationDeliveryStatus  @default(queued)
  subject         String?
  recipientEmail  String?                     @map("recipient_email")
  dedupeKey       String?                     @unique @map("dedupe_key")
  meta            Json?
  error           String?                     @db.Text
  queuedAt        DateTime                    @default(now()) @map("queued_at")
  sentAt          DateTime?                   @map("sent_at")
  createdAt       DateTime                    @default(now()) @map("created_at")
  updatedAt       DateTime                    @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([status, queuedAt])
  @@index([orgId, status])
  @@index([channel, status])
  @@index([userId, read, createdAt])
  @@index([orgId, read, createdAt])
  @@index([type, createdAt])
  @@map("notifications")
}

/// Outbound email outbox processed by notificationDispatcher cron.
model EmailQueue {
  id        String    @id @default(uuid()) @db.Uuid
  to        String
  subject   String
  body      String    @db.Text
  status    String    @default("pending")
  orgId     String?   @map("org_id") @db.Uuid
  dedupeKey String?   @unique @map("dedupe_key")
  error     String?   @db.Text
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("email_queue")
}

/// Hourly module usage snapshots for analytics.
model ModuleUsageMetric {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  moduleCode   String   @map("module_code")
  periodStart  DateTime @map("period_start")
  periodEnd    DateTime @map("period_end")
  eventCount   Int      @default(0) @map("event_count")
  activeUsers  Int      @default(0) @map("active_users")
  meta         Json?
  recordedAt   DateTime @default(now()) @map("recorded_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, moduleCode, periodStart])
  @@index([moduleCode, periodStart])
  @@index([orgId, recordedAt])
  @@map("module_usage_metrics")
}
