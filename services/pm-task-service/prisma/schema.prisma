generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  draft
  ready
  in_progress
  blocked
  completed
  cancelled
}

model Task {
  id                String     @id @default(uuid()) @db.Uuid
  companyId         String     @map("company_id") @db.Uuid
  workPackageId     String     @map("work_package_id") @db.Uuid
  title             String
  description       String?
  taskType          String?    @map("task_type")
  requiredSkills    Json       @default("[]") @map("required_skills") @db.JsonB
  requiredEquipment Json       @default("[]") @map("required_equipment") @db.JsonB
  requiredTraining  Json       @default("[]") @map("required_training") @db.JsonB
  requiredControls  Json       @default("[]") @map("required_controls") @db.JsonB
  requiredPpe       Json       @default("[]") @map("required_ppe") @db.JsonB
  requiredJha       Json       @default("[]") @map("required_jha") @db.JsonB
  status            TaskStatus @default(draft)
  startDate         DateTime?  @map("start_date")
  endDate           DateTime?  @map("end_date")
  version           Int        @default(1)
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  assignments TaskAssignment[]

  @@index([companyId])
  @@index([workPackageId])
  @@index([companyId, workPackageId])
  @@index([status])
  @@map("tasks")
}

model TaskAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  taskId       String   @map("task_id") @db.Uuid
  assigneeType String   @map("assignee_type")
  assigneeId   String   @map("assignee_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, assigneeType, assigneeId])
  @@index([taskId])
  @@index([assigneeId])
  @@map("task_assignments")
}
