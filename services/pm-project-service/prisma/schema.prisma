generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RiskLevel {
  low
  medium
  high
  critical
}

enum WorkPackageStatus {
  planned
  active
  completed
  on_hold
}

enum TaskStatus {
  todo
  in_progress
  blocked
  done
}

model Project {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String
  type      String?
  scope     String?
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  riskLevel RiskLevel @default(low) @map("risk_level")
  metadata  Json      @default("{}") @db.JsonB
  createdBy String    @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  workPackages WorkPackage[]
  tasks        ProjectTask[]

  @@index([companyId])
  @@index([companyId, name])
  @@index([riskLevel])
  @@map("projects")
}

model WorkPackage {
  id          String            @id @default(uuid()) @db.Uuid
  projectId   String            @map("project_id") @db.Uuid
  companyId   String            @map("company_id") @db.Uuid
  name        String
  description String?
  status      WorkPackageStatus @default(planned)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   ProjectTask[]

  @@index([projectId])
  @@index([companyId])
  @@map("work_packages")
}

model ProjectTask {
  id               String     @id @default(uuid()) @db.Uuid
  projectId        String     @map("project_id") @db.Uuid
  workPackageId    String?    @map("work_package_id") @db.Uuid
  companyId        String     @map("company_id") @db.Uuid
  name             String
  status           TaskStatus @default(todo)
  linkedEntityType String?    @map("linked_entity_type")
  linkedEntityId   String?    @map("linked_entity_id") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPackage WorkPackage? @relation(fields: [workPackageId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([workPackageId])
  @@index([companyId])
  @@map("project_tasks")
}
