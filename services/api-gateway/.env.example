NODE_ENV=development
PORT=8080

AUTH_SERVICE_URL=http://localhost:3001
RBAC_SERVICE_URL=http://localhost:3002
AUDIT_SERVICE_URL=http://localhost:3003
ATTACHMENT_SERVICE_URL=http://localhost:3004
OFFLINE_SERVICE_URL=http://localhost:3005
HAZARD_CONTROL_SERVICE_URL=http://localhost:3006
BACKEND_SERVICE_URL=http://localhost:3000

# Optional override: path to routes JSON (default: config/routes.json)
ROUTES_CONFIG_PATH=

# Token introspection (Auth Service)
AUTH_VALIDATE_PATH=/auth/validate-token
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
TOKEN_CACHE_TTL_MS=30000
TOKEN_CACHE_MAX=5000

# RBAC evaluation
RBAC_EVALUATE_PATH=/rbac/evaluate
RBAC_ENABLED=true

# Service keys forwarded for audit ingestion
AUDIT_SERVICE_KEY=dev-audit-ingest-secret

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=30

LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# Upstream health probe timeout (ms)
HEALTH_CHECK_TIMEOUT_MS=3000
