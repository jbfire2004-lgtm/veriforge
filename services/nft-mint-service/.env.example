PORT=4010
NODE_ENV=development
RPC_URL=https://polygon-rpc.com
# Optional separate read-only observer endpoint
OBSERVER_RPC_URL=
# env = local hot wallet (dev only); remote = KMS / HSM signing service
SIGNER_MODE=env
PRIVATE_KEY=0xYOUR_PRIVATE_KEY
# Production: SIGNER_MODE=remote + REMOTE_SIGNER_URL (no PRIVATE_KEY in process)
# REMOTE_SIGNER_URL=https://signer.internal/v1/sign-and-send
# REMOTE_SIGNER_TOKEN=
# ALLOW_HOT_WALLET=false
TRAINING_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000001
WORKFLOW_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000002
EQUIPMENT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000003
# Telcoin Network Network ID example — set for production pin
# EXPECTED_CHAIN_ID=2017
MIN_CONFIRMATIONS=3
