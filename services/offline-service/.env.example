NODE_ENV=development
PORT=3005
DATABASE_URL=postgresql://vera_offline:vera_offline_secret@localhost:5437/vera_offline?schema=public

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
AUTH_VALIDATE_URL=http://localhost:3001/auth/validate-token

# Optional remote validation hook
VALIDATION_HOOK_URL=
MODULE_APPLY_URL=

SYNC_WORKER_ENABLED=true
SYNC_WORKER_INTERVAL_MS=15000
SYNC_WORKER_BATCH_SIZE=50

LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
