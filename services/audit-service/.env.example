NODE_ENV=development
PORT=3003
DATABASE_URL=postgresql://vera_audit:vera_audit_secret@localhost:5435/vera_audit?schema=public

# Must match Vera Auth Service access token secret
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long

# Shared secret for service-to-service ingestion (auth, rbac, monolith modules)
AUDIT_SERVICE_KEY=dev-audit-ingest-secret

LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# Optional: auth service URL for token introspection fallback
AUTH_VALIDATE_URL=http://localhost:3001/auth/validate-token

# Default page size for GET /audit/events
AUDIT_DEFAULT_LIMIT=50
AUDIT_MAX_LIMIT=200
