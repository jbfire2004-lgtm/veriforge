# Copy to backend/.env for local dev and use `.env.production.example` for stage/prod.
#
# VeriForge (SaaS + Next.js + Compose): see infra/veriforge/.env.example
# and docs/VERIFORGE-ENV-VARIABLES.md

# --- Database (required) ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/vera?schema=public"
# Optional: only needed for `prisma migrate dev` (shadow DB)
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/vera_shadow?schema=public"

# --- Backend API ---
PORT=3001
NODE_ENV=development
JWT_SECRET="dev-only-secret-change-before-prod"
JWT_ISSUER="vera-local"
JWT_AUDIENCE="vera-local-clients"

# CORS comma-separated origins (canonical browser origin :5175)
CORS_ORIGIN="http://localhost:5175,http://localhost:3000"
ENABLE_ORIGIN_GUARD=0
VERA_VALIDATE_ENV_STRICT=0
VERA_ENFORCE_HTTPS=0

# Public URLs embedded in QR payloads / document links (canonical browser :5175/vera)
PUBLIC_BASE_URL="http://localhost:5175/vera"
PUBLIC_API_URL="http://localhost:3001"

# Seed (optional plaintext for dev logins `admin` / `supervisor1`)
SEED_USER_PASSWORD="hashedpassword123"

# --- Optional modules ---
CHAT_SECRET=""
VERA_CORE_UPLOAD_MODE="local"
NATS_URL="nats://localhost:4222"

# Performance (hot-path caches / photo analysis)
# VERA_PHOTO_ANALYSIS_ASYNC=true          # default: async enqueue (set false to wait)
# VERA_PHOTO_ANALYSIS_CONCURRENCY=3
# VERA_VISION_CANDIDATES_TTL_MS=60000
# VERA_CAIL_DASHBOARD_TTL_MS=60000
# VERA_CAIL_SIGNALS_TTL_MS=30000

# --- Frontend (vera-frontend/.env.local) ---
NEXT_PUBLIC_API_URL="http://localhost:3001"
# Local VeriForge demo role dropdown (never enable on a hosted review site)
# NEXT_PUBLIC_VERIFORGE_DEMO_ROLE_SWITCH=true

# VeriForge Nest tenancy (backend/.env)
# VERIFORGE_SEED_TENANTS=true
# VERIFORGE_REVIEWER_PASSWORD=Review!Only2026
