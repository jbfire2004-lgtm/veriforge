VITE_API_BASE_URL=/api
# Full VeriForge env map: infra/veriforge/.env.example
# Local: keep unset so module links use /vera on this origin (canonical browser :5175).
# Production: optional absolute workspace origin, e.g. VITE_VERA_APP_URL=https://app.example.com/vera
# Comma-separated emails allowed into /admin (must also match backend PLATFORM_ADMIN_EMAILS)VITE_PLATFORM_ADMIN_EMAILS=admin@veriforge.local
# Optional: pre-fill dev login helper on /login (development only)
VITE_DEV_LOGIN_EMAIL=admin@veriforge.local
VITE_DEV_LOGIN_PASSWORD=Str0ng!Passw0rd
