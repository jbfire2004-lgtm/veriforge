  workType               String?              @map("work_type")
  location               String?
  crewKey                String?              @map("crew_key")
  jhaRecordId            String?              @map("jha_record_id")
  energyJson             Json?                @map("energy_json")
  hazardCount            Int                  @default(0) @map("hazard_count")
  controlCount           Int                  @default(0) @map("control_count")
