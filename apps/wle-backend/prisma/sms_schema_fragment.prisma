model SmsCompetencyMetric {
  id                 String         @id @default(uuid())
  companyId          Int            @map("company_id")
  projectId          Int?           @map("project_id")
  periodStart        DateTime       @map("period_start") @db.Date
  periodEnd          DateTime       @map("period_end") @db.Date
  periodGrain        SmsPeriodGrain @map("period_grain")
  roleKey            String         @map("role_key")
  competencyKey      String         @map("competency_key")
  headcount          Int            @default(0)
  coveragePct        Decimal?       @map("coverage_pct") @db.Decimal(5, 2)
  overdueCount       Int            @default(0) @map("overdue_count")
  expiring30dCount   Int            @default(0) @map("expiring_30d_count")
  authGapCount       Int            @default(0) @map("auth_gap_count")
  riskIndex          Decimal?       @map("risk_index") @db.Decimal(5, 2)
  forecastSeriesJson Json?          @map("forecast_series_json")
  modelVersion       String?        @map("model_version")
  schemaVersion      Int            @default(1) @map("schema_version")
  computedAt         DateTime       @map("computed_at")
  sourceJobId        String?        @map("source_job_id")
  accessPlane        SmsAccessPlane @default(company) @map("access_plane")
  visibilityRoles    String[]       @default([]) @map("visibility_roles")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  deletedAt          DateTime?      @map("deleted_at")
  rowVersion         Int            @default(1) @map("row_version")

  // Logical grain uniqueness is (company_id, project_id, role_key, competency_key,
  // period_grain, period_start). project_id is NULL for company-wide matrix rows, and
  // Postgres UNIQUE treats each NULL as distinct, so the real de-dup guard is added via
  // a raw SQL migration: CREATE UNIQUE INDEX ... ON (company_id, COALESCE(project_id, 0),
  // role_key, competency_key, period_grain, period_start). The indexes below are for
  // query access patterns only, not uniqueness.
  @@index([companyId, periodGrain, periodStart])
  @@index([companyId, projectId, roleKey, competencyKey])
  @@index([companyId, riskIndex(sort: Desc)])
  @@map("sms_competency_metrics")
}

model SmsInspectionMetric {
  id                   String         @id @default(uuid())
  companyId            Int            @map("company_id")
  projectId            Int?           @map("project_id")
  periodStart          DateTime       @map("period_start") @db.Date
  periodEnd            DateTime       @map("period_end") @db.Date
  periodGrain          SmsPeriodGrain @map("period_grain")
  inspectionsCompleted Int            @default(0) @map("inspections_completed")
  inspectionsPlanned   Int            @default(0) @map("inspections_planned")
  completionPct        Decimal?       @map("completion_pct") @db.Decimal(5, 2)
  bboCount             Int            @default(0) @map("bbo_count")
  focusAuditCount      Int            @default(0) @map("focus_audit_count")
  bboQualityAvg        Decimal?       @map("bbo_quality_avg") @db.Decimal(5, 2)
  findingsOpen         Int            @default(0) @map("findings_open")
  findingsClosed       Int            @default(0) @map("findings_closed")
  findingsRatePer200k  Decimal?       @map("findings_rate_per_200k") @db.Decimal(12, 4)
  aiFlaggedCount       Int            @default(0) @map("ai_flagged_count")
  repeatFindingCount   Int            @default(0) @map("repeat_finding_count")
  actionsLinkedCount   Int            @default(0) @map("actions_linked_count")
  focusPacksJson       Json?          @map("focus_packs_json")
  schemaVersion        Int            @default(1) @map("schema_version")
  computedAt           DateTime       @map("computed_at")
  sourceJobId          String?        @map("source_job_id")
  accessPlane          SmsAccessPlane @default(project) @map("access_plane")
  visibilityRoles      String[]       @default([]) @map("visibility_roles")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  deletedAt            DateTime?      @map("deleted_at")
  rowVersion           Int            @default(1) @map("row_version")

  // Logical grain uniqueness is (company_id, project_id, period_grain, period_start);
  // project_id nullable = company-wide. Real de-dup guard added via raw SQL migration
  // using CREATE UNIQUE INDEX ... COALESCE(project_id, 0) ... — see SmsCompetencyMetric.
  @@index([companyId, projectId, periodGrain, periodStart])
  @@index([companyId, projectId, periodEnd(sort: Desc)])
  @@index([companyId, projectId, bboQualityAvg])
  @@index([companyId, findingsOpen])
  @@map("sms_inspection_metrics")
}

