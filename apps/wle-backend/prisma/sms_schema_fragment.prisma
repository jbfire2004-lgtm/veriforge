  accessPlane            SmsAccessPlane  @default(project) @map("access_plane")
  visibilityRoles        String[]        @default([]) @map("visibility_roles")
  title                  String
  templateKey            String?         @map("template_key")
  workType               String?         @map("work_type")
  industry               String?
  status                 SmsJhaStatus    @default(draft)
  version                Int             @default(1)
  residualRiskMax        Decimal?        @map("residual_risk_max") @db.Decimal(8, 2)
  riskRankJson           Json?           @map("risk_rank_json")
  sifPotential           Boolean         @default(false) @map("sif_potential")
  qualityScore           Decimal?        @map("quality_score") @db.Decimal(5, 2)
  qualityBand            SmsQualityBand? @map("quality_band")
  erpRecordId            String?         @map("erp_record_id")
  tasksCount             Int             @default(0) @map("tasks_count")
  hazardsCount           Int             @default(0) @map("hazards_count")
  approvedAt             DateTime?       @map("approved_at")
  approvedByUserId       Int?            @map("approved_by_user_id")
  createdByUserId        Int?            @map("created_by_user_id")
  updatedByUserId        Int?            @map("updated_by_user_id")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")
  deletedAt              DateTime?       @map("deleted_at")
  rowVersion             Int             @default(1) @map("row_version")

  flhaRecords SmsFlhaRecord[]
  erpRecord   SmsErpRecord?   @relation(fields: [erpRecordId], references: [id], onDelete: SetNull)

  @@unique([sorJhaFlhaId, version])
  @@index([companyId, projectId, status])
  @@index([companyId, sifPotential])
  @@index([erpRecordId])
  @@map("sms_jha_records")
}

model SmsErpRecord {
