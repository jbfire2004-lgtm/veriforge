// ═══════════════════════════════════════════════════════════════════════════
// VeriSuite SMS — production projection layer (Final Data Model)
// Physical tables use sms_ prefix to avoid VISI company_metrics / project_metrics.
// Appended into schema.prisma by build; keep in sync.
//
// SoR note: sor_* FK columns (sorJhaFlhaId, sorActionId, sorMeetingId,
// sorEmergencyPlanId) are String (UUID) — Nest SoR (JhaFlha, PmCorrectiveAction,
// SafetyMeeting, EmergencyPlan) uses UUID primary keys, not Int. This is an
// intentional deviation from the canvas table literal ("INT") which predates
// the SoR's UUID PK convention.
// ═══════════════════════════════════════════════════════════════════════════

enum SmsAccessPlane {
  project
  company
  subcontractor
}

enum SmsPeriodGrain {
  day
  week
  month
  quarter
}

enum SmsGeoLevel {
  global
  continent
  country
  province
  region
  city
  site
}

enum SmsFlhaStatus {
  draft
  active
  closed
  void
}

enum SmsQualityBand {
  pass
  warn
  fail
}

enum SmsFieldOsSyncStatus {
  pending
  synced
  error
  na
}

enum SmsJhaStatus {
  draft
  in_review
  approved
  archived
}

enum SmsErpScenario {
  electrical
  fall
  trench
  chemical
  rollover
  general
}

enum SmsErpStatus {
  draft
  active
  archived
}

enum SmsActionKind {
  corrective
  preventive
}

enum SmsActionStatus {
  open
  in_progress
  pending_verify
  closed
  void
}

enum SmsPriority {
  low
  medium
  high
  critical
}

enum SmsSourceModule {
  incident
  inspection
  jha
  flha
  meeting
  manual
  ai
}

enum SmsMeetingType {
  toolbox
  orientation
  emergency_drill_brief
  other
}

enum SmsMeetingStatus {
  scheduled
  completed
  cancelled
}

enum SmsAiModelTier {
  D0
  D1
  L1
  L2
}

enum SmsAiTone {
  neutral
  positive
  caution
  alert
}

enum SmsAiSource {
  rules
  scorer
  llm
  fallback
}

enum SmsAiStatus {
  active
  accepted
  rejected
  expired
  superseded
}

enum SmsDrillRosterStatus {
  expected
  accounted
  missing
  excused
}

enum SmsEntitlementReason {
  no_data
  license
  denied
}

model SmsGeoNode {
  id              String         @id @default(uuid())
  companyId       Int            @map("company_id")
  parentGeoNodeId String?        @map("parent_geo_node_id")
  geoLevel        SmsGeoLevel    @map("geo_level")
  geoCode         String         @map("geo_code")
  displayName     String         @map("display_name")
  isoCountry      String?        @map("iso_country")
  admin1Code      String?        @map("admin1_code")
  timezone        String?
  centroidLat     Float?         @map("centroid_lat")
  centroidLng     Float?         @map("centroid_lng")
  pathLtree       String?        @map("path_ltree")
  depth           Int            @default(0)
  sortOrder       Int            @default(0) @map("sort_order")
  isActive        Boolean        @default(true) @map("is_active")
  accessPlane     SmsAccessPlane @default(company) @map("access_plane")
  visibilityRoles String[]       @default([]) @map("visibility_roles")
  createdByUserId Int?           @map("created_by_user_id")
  updatedByUserId Int?           @map("updated_by_user_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")
  rowVersion      Int            @default(1) @map("row_version")

  parent          SmsGeoNode?             @relation("SmsGeoHierarchy", fields: [parentGeoNodeId], references: [id], onDelete: Restrict)
  children        SmsGeoNode[]            @relation("SmsGeoHierarchy")
  entitlements    SmsGeoNodeEntitlement[]
  projectMaps     SmsProjectGeoMap[]      @relation("SmsSiteGeo")
  countryMaps     SmsProjectGeoMap[]      @relation("SmsCountryGeo")
  provinceMaps    SmsProjectGeoMap[]      @relation("SmsProvinceGeo")
  regionalMetrics SmsRegionalMetric[]
  projectMetrics  SmsProjectMetric[]

  @@unique([companyId, geoCode])
  @@index([companyId, parentGeoNodeId])
  @@index([companyId, geoLevel, geoCode])
  @@map("sms_geo_nodes")
}

model SmsGeoNodeEntitlement {
  id         String                @id @default(uuid())
  companyId  Int                   @map("company_id")
  geoNodeId  String                @map("geo_node_id")
  available  Boolean               @default(true)
  reasonCode SmsEntitlementReason? @map("reason_code")
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  geoNode SmsGeoNode @relation(fields: [geoNodeId], references: [id], onDelete: Cascade)

  @@unique([companyId, geoNodeId])
  @@index([companyId, available])
  @@map("sms_geo_node_entitlements")
}

model SmsProjectGeoMap {
  projectId         Int     @id @map("project_id")
  companyId         Int     @map("company_id")
  siteGeoNodeId     String  @map("site_geo_node_id")
  countryGeoNodeId  String? @map("country_geo_node_id")
  provinceGeoNodeId String? @map("province_geo_node_id")

  siteGeo     SmsGeoNode  @relation("SmsSiteGeo", fields: [siteGeoNodeId], references: [id], onDelete: Restrict)
  countryGeo  SmsGeoNode? @relation("SmsCountryGeo", fields: [countryGeoNodeId], references: [id], onDelete: SetNull)
  provinceGeo SmsGeoNode? @relation("SmsProvinceGeo", fields: [provinceGeoNodeId], references: [id], onDelete: SetNull)

  @@index([companyId, siteGeoNodeId])
  @@map("sms_project_geo_map")
}

model SmsIndustryBenchmarkCohort {
  id           String         @id @default(uuid())
  industryCode String         @map("industry_code")
  regionScope  String         @map("region_scope")
  periodGrain  SmsPeriodGrain @map("period_grain")
  periodStart  DateTime       @map("period_start") @db.Date
  periodEnd    DateTime       @map("period_end") @db.Date
  metricKey    String         @map("metric_key")
  cohortN      Int            @map("cohort_n")
  p25          Decimal?       @db.Decimal(12, 4)
  p50          Decimal?       @db.Decimal(12, 4)
  p75          Decimal?       @db.Decimal(12, 4)
  mean         Decimal?       @db.Decimal(12, 4)
  suppressed   Boolean        @default(false)
  computedAt   DateTime       @map("computed_at")

  @@unique([industryCode, regionScope, periodGrain, periodStart, metricKey])
  @@index([industryCode, regionScope, periodEnd])
  @@map("sms_industry_benchmark_cohorts")
}

