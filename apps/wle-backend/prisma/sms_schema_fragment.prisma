  trainingCoveragePct     Decimal?       @map("training_coverage_pct") @db.Decimal(5, 2)
  erpDrillReadinessPct    Decimal?       @map("erp_drill_readiness_pct") @db.Decimal(5, 2)
  competencyRiskIndexAvg  Decimal?       @map("competency_risk_index_avg") @db.Decimal(5, 2)
