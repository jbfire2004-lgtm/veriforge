{
  "name": "backend",
  "version": "0.0.1",
  "description": "Vera backend (NestJS 9 + Prisma 5)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "prisma": {
    "seed": "ts-node -P tsconfig.prisma.json prisma/seed.ts"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:auth": "jest --config ./test/auth/jest-auth.config.cjs --runInBand",
    "test:auth-flow": "jest --config ./test/auth/jest-auth.config.cjs --runInBand ./test/auth/auth-session-flow.spec.ts",
    "test:phase1": "jest --config ./test/phase1/jest-phase1.config.cjs --runInBand",
    "test:pm-safety": "jest --config ./test/pm-safety/jest-pm-safety.config.cjs --runInBand",
    "test:role-access": "jest --config ./test/ci/jest-ci.config.cjs --runInBand --testPathPatterns=role-access.integration.spec.ts",
    "test:error-contract": "jest --config ./test/ci/jest-ci.config.cjs --runInBand --testPathPatterns=error-contract.integration.spec.ts",
    "test:ci": "jest --config ./test/ci/jest-ci.config.cjs --runInBand",
    "test:workflow-sim": "jest --config ./test/workflow-simulation/jest-workflow-sim.config.cjs --runInBand",
    "test:verisuite-sms": "jest --runInBand src/verisuite-sms --testPathPattern=verisuite-sms",
    "seed": "ts-node -P tsconfig.prisma.json prisma/seed.ts",
    "seed:training-providers": "ts-node -P tsconfig.prisma.json prisma/run-seed-training-providers.ts",
    "seed:practice-company": "ts-node -P tsconfig.prisma.json prisma/run-seed-practice-company.ts",
    "seed:vera-core": "ts-node -P tsconfig.prisma.json prisma/seed-vera-core.ts",
    "seed:vera-catalog": "ts-node -P tsconfig.prisma.json prisma/run-seed-vera-catalog.ts",
    "fix:dev-passwords": "ts-node -P tsconfig.prisma.json prisma/fix-dev-passwords.ts",
    "prisma:seed": "prisma db seed",
    "dev": "npm run start:dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/s3-request-presigner": "^3.1041.0",
    "@nestjs/common": "^9.0.0",
    "@nestjs/core": "^9.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^1.2.2",
    "@nestjs/passport": "^9.0.3",
    "@nestjs/platform-express": "^9.0.0",
    "@nestjs/schedule": "^2.2.3",
    "@nestjs/throttler": "^4.2.1",
    "@prisma/client": "5.15.0",
    "@trpc/server": "^11.4.3",
    "@turf/boolean-point-in-polygon": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "@vera/api-contract": "file:../packages/vera-api-contract",
    "@vera/autonomous-operations": "file:../packages/vera-autonomous-operations",
    "@vera/autonomous-safety": "file:../packages/vera-autonomous-safety",
    "@vera/civilization": "file:../packages/vera-civilization",
    "@vera/command-center": "file:../packages/vera-command-center",
    "@vera/digital-twin": "file:../packages/vera-digital-twin",
    "@vera/enterprise-automation": "file:../packages/vera-enterprise-automation",
    "@vera/enterprise-brain": "file:../packages/vera-enterprise-brain",
    "@vera/global-network": "file:../packages/vera-global-network",
    "@vera/hub-industry-safety": "file:../packages/vera-hub-industry-safety",
    "@vera/hub-industry-safety-trends": "file:../packages/vera-hub-industry-safety-trends",
    "@vera/industry-ecosystem": "file:../packages/vera-industry-ecosystem",
    "@vera/intelligence": "file:../packages/vera-intelligence",
    "@vera/interplanetary": "file:../packages/vera-interplanetary",
    "@vera/interstellar": "file:../packages/vera-interstellar",
    "@vera/marketplace": "file:../packages/vera-marketplace",
    "@vera/predictive-scheduling": "file:../packages/vera-predictive-scheduling",
    "@vera/vision": "file:../packages/vera-vision",
    "@vera/workflow-sim": "file:../packages/vera-workflow-sim",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.8.0",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "multer": "^2.1.1",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "prisma": "5.15.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.2.0",
    "ws": "8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.5.0",
    "@nestjs/schematics": "^9.2.0",
    "@nestjs/testing": "^9.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.13",
    "@types/jest": "^29.5.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.1.0",
    "@types/node": "18.16.12",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^2.0.11",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "29.5.0",
    "prettier": "^2.3.2",
    "prisma-erd-generator": "^2.4.2",
    "source-map-support": "^0.5.20",
    "supertest": "^6.1.3",
    "ts-jest": "29.1.0",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.2.0",
    "typescript": "^5.3.3"
  }
}
