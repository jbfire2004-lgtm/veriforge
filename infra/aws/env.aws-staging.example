# AWS staging — use with docker-compose.production.yml on EC2
# or adapt values for EKS ConfigMap + Secrets Manager.
#
# Copy to infra/veriforge/.env and fill real values.
# See docs/AWS-DEPLOYMENT.md

NODE_ENV=production
HTTP_PORT=80

# --- Amazon RDS PostgreSQL 16 ---
# Endpoint looks like: veriforge-staging-pg.xxxxx.us-east-1.rds.amazonaws.com
POSTGRES_DB=veriforge
POSTGRES_USER=veriforge
POSTGRES_PASSWORD=FROM_SECRETS_MANAGER
DATABASE_URL=postgresql://veriforge:FROM_SECRETS_MANAGER@veriforge-staging-pg.xxxxx.us-east-1.rds.amazonaws.com:5432/veriforge?sslmode=require&schema=public

# Compose-local Postgres instead of RDS (throwaway only):
# DATABASE_URL=postgresql://veriforge:CHANGE_ME@db:5432/veriforge?schema=public

# --- ElastiCache Redis ---
REDIS_URL=redis://:FROM_SECRETS_MANAGER@veriforge-staging-redis.xxxxx.cache.amazonaws.com:6379
# If TLS required:
# REDIS_URL=rediss://:FROM_SECRETS_MANAGER@....cache.amazonaws.com:6379

# Compose-local Redis:
# REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=FROM_SECRETS_MANAGER_MIN_32_CHARS
JWT_REFRESH_SECRET=FROM_SECRETS_MANAGER_MIN_32_CHARS
NEXTAUTH_SECRET=FROM_SECRETS_MANAGER_MIN_32_CHARS
FIELD_ENCRYPTION_KEY=FROM_SECRETS_MANAGER_MIN_32_CHARS

STRIPE_SECRET_KEY=sk_test_FROM_STRIPE_DASHBOARD
STRIPE_WEBHOOK_SECRET=whsec_FROM_STRIPE_DASHBOARD
PLATFORM_ADMIN_EMAILS=you@veriglobal.ca
RESEND_API_KEY=re_FROM_RESEND
EMAIL_FROM="VeriForge Staging <noreply@staging.veriglobal.ca>"

# Public HTTPS origin (no trailing slash; no /vera in production)
APP_PUBLIC_URL=https://staging.veriglobal.ca
NEXTAUTH_URL=https://staging.veriglobal.ca
CORS_ORIGIN=https://staging.veriglobal.ca
# Browser calls /nest (gateway → Nest). Server-side Next uses NEST_INTERNAL_URL.
NEXT_PUBLIC_API_URL=/nest
NEST_INTERNAL_URL=http://nest:3001
VERIFORGE_SAAS_URL=http://api:3020

COOKIE_SECURE=true
ENFORCE_HTTPS=true
LOG_LEVEL=info
RUN_DB_SEED=0
ALLOW_DESTRUCTIVE_MIGRATIONS=0

# Nest Prisma database. Same RDS host as SaaS is fine; use a different database name.
# Compose-local Postgres (throwaway): postgresql://veriforge:CHANGE_ME@db:5432/vera_nest?schema=public
NEST_DATABASE_URL=postgresql://veriforge:FROM_SECRETS_MANAGER@veriforge-staging-pg.xxxxx.us-east-1.rds.amazonaws.com:5432/vera_nest?sslmode=require&schema=public
NEST_JWT_SECRET=FROM_SECRETS_MANAGER_MIN_32_CHARS
ENABLE_ORIGIN_GUARD=true
VERA_ENFORCE_HTTPS=true
# Nest image compile heap. Leave unset on a 16 GB EC2 (defaults to 8192).
# NODE_HEAP_MB=8192
# AWS_REGION=ca-central-1
# AWS_S3_BUCKET=veriglobal-staging-uploads

# VeriAgent / AI egress (optional on Nest host)
# Leave VERA_AGENT_REMOTE_URL unset to keep in-process VeriAgent (no behavior change).
# VERA_AGENT_SAFETY_OVERLAY=enhanced
# VERA_AGENT_SAFETY_REQUIRE_CONFIRM=false
