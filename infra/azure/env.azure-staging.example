# Azure staging — use with docker-compose.production.yml on a VM
# or adapt values for AKS ConfigMap + Key Vault secrets.
#
# Copy to infra/veriforge/.env and fill real values from Key Vault.
# See docs/AZURE-DEPLOYMENT.md

NODE_ENV=production
HTTP_PORT=80

# --- Azure Database for PostgreSQL Flexible Server ---
# Host looks like: veriforge-staging-pg.postgres.database.azure.com
POSTGRES_DB=postgres
POSTGRES_USER=veriforge
POSTGRES_PASSWORD=FROM_KEY_VAULT
DATABASE_URL=postgresql://veriforge:FROM_KEY_VAULT@veriforge-staging-pg.postgres.database.azure.com:5432/postgres?sslmode=require&schema=public

# --- Azure Cache for Redis (use rediss + port 6380) ---
REDIS_URL=rediss://:FROM_KEY_VAULT@veriforge-staging-redis.redis.cache.windows.net:6380

JWT_ACCESS_SECRET=FROM_KEY_VAULT_MIN_32_CHARS
JWT_REFRESH_SECRET=FROM_KEY_VAULT_MIN_32_CHARS
NEXTAUTH_SECRET=FROM_KEY_VAULT_MIN_32_CHARS
FIELD_ENCRYPTION_KEY=FROM_KEY_VAULT_MIN_32_CHARS

STRIPE_SECRET_KEY=sk_test_FROM_STRIPE_DASHBOARD
STRIPE_WEBHOOK_SECRET=whsec_FROM_STRIPE_DASHBOARD
PLATFORM_ADMIN_EMAILS=you@yourdomain.com
RESEND_API_KEY=re_FROM_RESEND
EMAIL_FROM=VeriForge Staging <noreply@staging.yourdomain.com>

# Public HTTPS origin (no trailing slash; no /vera in production)
APP_PUBLIC_URL=https://staging.yourdomain.com
NEXTAUTH_URL=https://staging.yourdomain.com
CORS_ORIGIN=https://staging.yourdomain.com
NEXT_PUBLIC_API_URL=/api
VERIFORGE_SAAS_URL=http://api:3020

COOKIE_SECURE=true
ENFORCE_HTTPS=true
LOG_LEVEL=info
RUN_DB_SEED=0
ALLOW_DESTRUCTIVE_MIGRATIONS=0

# Nest (separate container — set on backend/.env or compose override)
# DATABASE_URL=postgresql://...  (Nest Prisma DB — can be same server, different DB)
# PUBLIC_BASE_URL=https://staging.yourdomain.com
# CORS_ORIGIN=https://staging.yourdomain.com
