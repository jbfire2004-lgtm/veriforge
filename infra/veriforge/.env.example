# =============================================================================
# VeriForge — complete environment variable map
# =============================================================================
# Copy to infra/veriforge/.env for Docker Compose, or split per service:
#   services/veriforge-saas-service/.env  (API + worker)
#   vera-frontend/.env.local              (Next.js app)
#
# Never commit filled secrets. Use a secret manager in production.
# Documentation: docs/VERIFORGE-ENV-VARIABLES.md
# =============================================================================

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# DEV_MODE=true  → shorthand for local dev (see docs); use NODE_ENV=development
DEV_MODE=true

# ── DATABASE ─────────────────────────────────────────────────────────────────
# Prisma connection string (required for API + worker + migrate)
DATABASE_URL=postgresql://veriforge:veriforge_dev_password@localhost:5432/veriforge?schema=public

# Docker Compose postgres service (used to build DATABASE_URL in compose)
POSTGRES_DB=veriforge
POSTGRES_USER=veriforge
POSTGRES_PASSWORD=veriforge_dev_password

# Optional: prisma migrate dev shadow DB
# SHADOW_DATABASE_URL=postgresql://veriforge:veriforge_dev_password@localhost:5432/veriforge_shadow?schema=public

# Connection pool (API)
DB_POOL_SIZE=5
DB_POOL_TIMEOUT=20

# Migrate / seed
RUN_DB_SEED=1
ALLOW_DESTRUCTIVE_MIGRATIONS=0

# ── AUTH & JWT ───────────────────────────────────────────────────────────────
# Required (min 32 chars in production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters

# Legacy alias (docs only — map to JWT_ACCESS_SECRET in new configs)
# JWT_SECRET=change-me-access-secret-min-32-characters

# Optional rotation: "v2:newSecret...,v1:oldSecret..."
JWT_ACCESS_SECRETS=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
JWT_ISSUER=veriforge
JWT_AUDIENCE=veriforge-app

# PII field encryption (required in production, min 32 chars)
FIELD_ENCRYPTION_KEY=dev-only-field-encryption-key-32b
FIELD_ENCRYPTION_OPTIONAL=false

# Password hashing — VeriForge uses Argon2id (see src/security/password.ts).
# PASSWORD_SALT_ROUNDS / BCRYPT_ROUNDS are legacy placeholders (bcrypt verify only for old hashes).
PASSWORD_SALT_ROUNDS=12
# BCRYPT_ROUNDS=12

COOKIE_SECURE=false
ENFORCE_HTTPS=false
CORS_ORIGIN=*

# ── NEXT AUTH (Next.js / vera-frontend) ─────────────────────────────────────
NEXTAUTH_SECRET=dev-nextauth-secret-change-in-prod-min-32-ch
NEXTAUTH_URL=http://localhost:3000

# ── REDIS (caching, RBAC invalidation, rate limits) ───────────────────────────
REDIS_URL=redis://localhost:6379
# REDIS_DISABLED=true

CACHE_TTL_RBAC_SEC=120
CACHE_TTL_PRICING_SEC=300
CACHE_TTL_MODULES_SEC=300

# ── EMAIL ────────────────────────────────────────────────────────────────────
# Resend API key; without it emails log to console (dev)
EMAIL_PROVIDER_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=VeriForge <noreply@veriforge.com>

# ── CRON JOBS ────────────────────────────────────────────────────────────────
# Production: run crons in dedicated worker container (recommended).
CRON_ENABLED=true
RUN_CRON_IN_API=false
WORKER_MODE=false
WORKER_HEALTH_PORT=3021

# Trial / batch job tuning
TRIAL_JOB_BATCH_SIZE=100
TRIAL_JOB_CONCURRENCY=5

# ── LOGGING ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# OpenTelemetry (optional)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=veriforge-saas-service
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_DIAG_LOG=false

# Prometheus /metrics scrape (required when NODE_ENV=production)
METRICS_BEARER_TOKEN=

# ── FEATURE FLAGS ────────────────────────────────────────────────────────────
# Optional JSON scaffold for client-side toggles (not read by SaaS API today).
# Platform feature flags are stored in DB (developer console) — use /developer/feature-flags.
FEATURE_FLAGS={"newScorecardEngine":true}

# Next.js public toggles (vera-frontend)
# NEXT_PUBLIC_VERIFORGE_DEMO_ROLE_SWITCH=false

# ── DEVELOPER TOOLS ──────────────────────────────────────────────────────────
DEVELOPER_BOOTSTRAP_SECRET=
PLATFORM_ADMIN_EMAILS=admin@veriforge.local

# Local seed users (skipped in production unless SEED_DEV_USERS=1)
SEED_DEV_USERS=1
SEED_DEV_ADMIN_EMAIL=admin@veriforge.local
SEED_DEV_ADMIN_PASSWORD=Str0ng!Passw0rd
SEED_DEV_TRIAL_DAYS=90

# ── SaaS API ─────────────────────────────────────────────────────────────────
PORT=3020
APP_PUBLIC_URL=http://localhost:5175

# Billing / trials
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2025-01-27.acacia
ANNUAL_DISCOUNT_PERCENT=17
TRIAL_DAYS=7
CURRENCY=USD

# Privacy retention
PII_USER_RETENTION_DAYS=3650
AUDIT_LOG_RETENTION_DAYS=2555

# ── Next.js app (vera-frontend) ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_PATH=
VERIFORGE_SAAS_URL=http://127.0.0.1:3020
NEXT_PUBLIC_SAAS_URL=http://127.0.0.1:3020

# ── Document Center storage ──────────────────────────────────────────────────
# local | s3 | supabase
DOCUMENT_STORAGE_PROVIDER=local
# DOCUMENT_STORAGE_LOCAL_PATH=./uploads/documents
# DOCUMENT_STORAGE_PUBLIC_BASE_URL=http://localhost:3020/uploads/documents
# S3 (optional)
# DOCUMENT_S3_BUCKET=
# DOCUMENT_S3_REGION=us-east-1
# DOCUMENT_S3_ACCESS_KEY=
# DOCUMENT_S3_SECRET_KEY=
# DOCUMENT_S3_ENDPOINT=          # MinIO / custom
# DOCUMENT_S3_PUT_URL=           # template with {key}
# Supabase (optional)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=veriforge-documents

# Nest tRPC bridge (backend) — optional if using Vera core API
# VERIFORGE_SAAS_URL is also read by backend/src/server/api/routers/_saas.ts

# ── Docker / deploy ────────────────────────────────────────────────────────────
HTTP_PORT=80
IMAGE_TAG=latest
APP_IMAGE=veriforge-app
API_IMAGE=veriforge-api

# CI/CD (GitHub Actions secrets — not in local .env)
# VERIFORGE_DATABASE_URL=
# DEPLOY_SSH_HOST=
# DEPLOY_WEBHOOK_URL=
