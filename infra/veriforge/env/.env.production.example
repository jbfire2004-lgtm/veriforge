# Production — store real values in a secret manager; never commit filled copies.
NODE_ENV=production
HTTP_PORT=80
IMAGE_TAG=latest
APP_IMAGE=veriforge-app
API_IMAGE=veriforge-api

POSTGRES_DB=veriforge
POSTGRES_USER=veriforge
POSTGRES_PASSWORD=USE_SECRET_MANAGER

# Host must match compose service name `db`
DATABASE_URL=postgresql://veriforge:USE_SECRET_MANAGER@db:5432/veriforge?schema=public
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=USE_SECRET_MANAGER_MIN_32_CHARS________
JWT_REFRESH_SECRET=USE_SECRET_MANAGER_MIN_32_CHARS_______
NEXTAUTH_SECRET=USE_SECRET_MANAGER_MIN_32_CHARS________
FIELD_ENCRYPTION_KEY=USE_SECRET_MANAGER_MIN_32_CHARS________

STRIPE_SECRET_KEY=sk_live_USE_SECRET_MANAGER
STRIPE_WEBHOOK_SECRET=whsec_USE_SECRET_MANAGER
PLATFORM_ADMIN_EMAILS=founder@veriglobal.ca
RESEND_API_KEY=re_USE_SECRET_MANAGER
EMAIL_FROM="VeriForge <noreply@veriglobal.ca>"

APP_PUBLIC_URL=https://app.veriglobal.ca
NEXTAUTH_URL=https://app.veriglobal.ca
CORS_ORIGIN=https://app.veriglobal.ca
# Browser calls /nest (gateway → Nest). Server-side Next uses NEST_INTERNAL_URL.
NEXT_PUBLIC_API_URL=/nest
NEST_INTERNAL_URL=http://nest:3001
VERIFORGE_SAAS_URL=http://api:3020

# Nest API (separate database from the SaaS DATABASE_URL above)
NEST_DATABASE_URL=postgresql://veriforge:USE_SECRET_MANAGER@db:5432/vera_nest?schema=public
NEST_JWT_SECRET=USE_SECRET_MANAGER_MIN_32_CHARS________
ENABLE_ORIGIN_GUARD=true
VERA_ENFORCE_HTTPS=true
COOKIE_SECURE=true
ENFORCE_HTTPS=true

# Leave unset on EC2 (16 GB). The Nest image compile defaults to 8192 MB.
# NODE_HEAP_MB=8192

LOG_LEVEL=info
RUN_DB_SEED=0
ALLOW_DESTRUCTIVE_MIGRATIONS=0
