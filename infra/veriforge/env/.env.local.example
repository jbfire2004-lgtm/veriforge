# Local development (compose)
NODE_ENV=development
HTTP_PORT=8080
POSTGRES_DB=veriforge
POSTGRES_USER=veriforge
POSTGRES_PASSWORD=veriforge_dev_password
DATABASE_URL=postgresql://veriforge:veriforge_dev_password@postgres:5432/veriforge?schema=public
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=local-dev-access-secret-change-me-32
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me-32

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_ADMIN_EMAILS=admin@veriforge.local
RESEND_API_KEY=
EMAIL_FROM=VeriForge <noreply@localhost>
APP_PUBLIC_URL=http://localhost:8080
CORS_ORIGIN=*
LOG_LEVEL=debug
