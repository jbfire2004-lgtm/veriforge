# Staging — store real values in a secret manager; never commit filled copies.
# Public origin is https://staging.veriglobal.ca. Fill this on the EC2 host.
NODE_ENV=production
HTTP_PORT=80
IMAGE_TAG=latest

POSTGRES_DB=veriforge
POSTGRES_USER=veriforge
POSTGRES_PASSWORD=CHANGE_ME_STAGING

# Host must match compose service name `db` (or an RDS endpoint).
DATABASE_URL=postgresql://veriforge:CHANGE_ME_STAGING@db:5432/veriforge?schema=public
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=CHANGE_ME_STAGING_ACCESS________________
JWT_REFRESH_SECRET=CHANGE_ME_STAGING_REFRESH_______________
NEXTAUTH_SECRET=CHANGE_ME_STAGING_NEXTAUTH______________
FIELD_ENCRYPTION_KEY=CHANGE_ME_STAGING_FIELD_KEY____________

STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
PLATFORM_ADMIN_EMAILS=founder@veriglobal.ca
RESEND_API_KEY=
EMAIL_FROM="VeriForge Staging <noreply@staging.veriglobal.ca>"

APP_PUBLIC_URL=https://staging.veriglobal.ca
NEXTAUTH_URL=https://staging.veriglobal.ca
CORS_ORIGIN=https://staging.veriglobal.ca
NEXT_PUBLIC_API_URL=/nest
NEST_INTERNAL_URL=http://nest:3001
VERIFORGE_SAAS_URL=http://api:3020

NEST_DATABASE_URL=postgresql://veriforge:CHANGE_ME_STAGING@db:5432/vera_nest?schema=public
NEST_JWT_SECRET=CHANGE_ME_STAGING_NEST_JWT______________
ENABLE_ORIGIN_GUARD=true
VERA_ENFORCE_HTTPS=true
COOKIE_SECURE=true
ENFORCE_HTTPS=true

LOG_LEVEL=info
RUN_DB_SEED=0
ALLOW_DESTRUCTIVE_MIGRATIONS=0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
