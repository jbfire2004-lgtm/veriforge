{
  "annotations": { "list": [] },
  "editable": true,
  "id": null,
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP 5xx rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(veriforge_http_errors_total[5m]))",
          "legendFormat": "5xx/s",
          "refId": "A"
        }
      ]
    },
    {
      "type": "gauge",
      "title": "Error ratio (5m)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.02 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(veriforge_http_errors_total[5m])) / clamp_min(sum(rate(veriforge_http_requests_total[5m])), 0.001)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Errors by route",
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (route, status_code) (rate(veriforge_http_errors_total[5m]))",
          "legendFormat": "{{route}} {{status_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "DB ready",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "min(veriforge_db_ready)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "DB pool saturation",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "veriforge_db_pool_saturation_ratio",
          "legendFormat": "saturation",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["veriforge", "errors"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "VeriForge Error Rate",
  "uid": "veriforge-errors",
  "version": 1
}
