enum PmCorrectiveActionType {
  immediate
  interim_control
  permanent
  preventive
  equipment_repair
  training_requirement
  policy_update
}

enum PmCorrectiveActionStatus {
  draft
  open
  assigned
  in_progress
  verification_pending
  verified
  closed
  cancelled
}

enum PmCapaAssigneeRole {
  primary
  secondary
  delegate
  verifier
}

model PmCapaCompanyConfig {
  id              Int      @id @default(autoincrement())
  companyId       Int      @unique
  dueDaysLow      Int      @default(30)
  dueDaysMedium   Int      @default(14)
  dueDaysHigh     Int      @default(7)
  dueDaysCritical Int      @default(1)
