  assignmentRules Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("pm_capa_company_config")
}

model PmCorrectiveAction {
  id                           String                   @id @default(uuid())
  cailEntryId                  String                   @unique
  companyId                    Int
  projectId                    Int
  siteId                       Int?
  sourceModule                 String
  sourceId                     String
  sourceItemId                 String                   @default("")
  deficiencyId                 String?
  actionType                   PmCorrectiveActionType   @default(permanent)
  status                       PmCorrectiveActionStatus @default(draft)
  title                        String
  description                  String?                  @db.Text
  severityScore                Int                      @default(50)
  priorityScore                Int                      @default(50)
  escalationLevel              Int                      @default(0)
  dueAt                        DateTime?
  overdueAt                    DateTime?
  equipmentId                  Int?
  workerId                     Int?
  subcontractorCompanyId       Int?
  requiresVerification         Boolean                  @default(true)
  verifiedAt                   DateTime?
  closedAt                     DateTime?
  createdByUserId              Int
  verifiedByUserId             Int?
  parentActionId               String?
  hazardId                     String?
  controlId                    String?
  rootCauseId                  String?
  publishVersion               Int                      @default(1)
  publishedAt                  DateTime?
  severityLevel                String                   @default("medium")
  priorityLevel                String                   @default("medium")
  evidenceRequirementsJson     Json                     @default("{}")
  verificationRequirementsJson Json                     @default("{}")
  clientSyncId                 String?                  @unique
  deletedAt                    DateTime?
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt

  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site         Site?                @relation(fields: [siteId], references: [id], onDelete: SetNull)
  cailEntry    CailEntry            @relation(fields: [cailEntryId], references: [id], onDelete: Cascade)
  equipment    Equipment?           @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  worker       Worker?              @relation(fields: [workerId], references: [id], onDelete: SetNull)
  createdBy    User                 @relation("PmCorrectiveActionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  verifiedBy   User?                @relation("PmCorrectiveActionVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  parentAction PmCorrectiveAction?  @relation("PmCapaDelegation", fields: [parentActionId], references: [id], onDelete: SetNull)
  childActions PmCorrectiveAction[] @relation("PmCapaDelegation")

  assignees            PmCorrectiveActionAssignee[]
  escalations          PmCorrectiveActionEscalation[]
  verifications        PmCorrectiveActionVerification[]
  attachments          PmCorrectiveActionAttachment[]
  signatures           PmCorrectiveActionSignature[]
  auditLogs            PmCorrectiveActionAuditLog[]
  versions             PmCorrectiveActionVersion[]
  moduleLinks          PmCorrectiveActionLink[]
  overrides            PmCorrectiveActionOverride[]
  meetingAttachments   SafetyMeetingAttachment[]
  meetingLinks         SafetyMeetingCorrectiveAction[]
  unifiedHazard        PmUnifiedHazard?                 @relation(fields: [hazardId], references: [id], onDelete: SetNull)
  unifiedControl       PmUnifiedControl?                @relation(fields: [controlId], references: [id], onDelete: SetNull)
  photoFindings        PmInspectionPhotoFinding[]
  contractorDispatches PmInspectionContractorDispatch[]
  hecaCsraAssessments  HecaCsraAssessment[]             @relation("HecaCsraLinkedAction")
  hecaCsraRecommendations HecaCsraRecommendation[]      @relation("HecaCsraRecLinkedAction")

  @@index([projectId, status])
  @@index([companyId, priorityScore])
  @@index([dueAt, status])
  @@index([sourceModule, sourceId])
  @@index([equipmentId, status])
  @@index([hazardId])
  @@index([controlId])
  @@index([workerId, status])
  @@map("corrective_actions")
}

model PmCorrectiveActionAssignee {
  id            String             @id @default(uuid())
