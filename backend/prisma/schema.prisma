  correctiveAction PmCorrectiveAction? @relation(fields: [correctiveActionId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@map("safety_meeting_attachments")
}

model SafetyMeetingCorrectiveAction {
  id                 String   @id @default(uuid())
  meetingId          String
  topicId            String?
  correctiveActionId String
