// -----------------------------------------------------
// VERA CORE — API KEYS, WALLET BUNDLES, OFFLINE SYNC
// -----------------------------------------------------

enum CoreOfflineSyncStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CONFLICT
}

/// Programmatic access keys for Vera Core / provider / wallet integrations.
model VeraApiKey {
  id                 String    @id @default(uuid())
  name               String
  keyHash            String    @unique @map("key_hash")
  keyPrefix          String    @map("key_prefix")
  companyId          Int?      @map("company_id")
  trainingProviderId Int?      @map("training_provider_id")
  scopes             String[]  @default(["read"])
  active             Boolean   @default(true)
  lastUsedAt         DateTime? @map("last_used_at")
  expiresAt          DateTime? @map("expires_at")
  createdById        Int?      @map("created_by_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  company          Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trainingProvider TrainingProvider? @relation(fields: [trainingProviderId], references: [id], onDelete: Cascade)
  createdBy        User?             @relation("VeraApiKeyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([keyPrefix, active])
  @@index([companyId, active])
  @@map("vera_api_keys")
}

/// Persisted worker wallet bundle snapshots (offline QR / blockchain verify).
model WorkerWalletBundle {
  id         String   @id @default(uuid())
  workerId   Int      @map("worker_id")
  companyId  Int?     @map("company_id")
  version    Int      @default(1)
  bundleHash String   @map("bundle_hash")
  qrPayload  String?  @map("qr_payload") @db.Text
  payload    Json
  deviceId   String?  @map("device_id")
  syncedAt   DateTime @default(now()) @map("synced_at")
  createdAt  DateTime @default(now()) @map("created_at")

  worker  Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@unique([workerId, version])
  @@index([workerId, syncedAt])
  @@map("worker_wallet_bundles")
}

/// Field / wallet offline sync submission batches.
model CoreOfflineSyncBatch {
  id            String                @id @default(uuid())
  deviceId      String                @map("device_id")
  workerId      Int?                  @map("worker_id")
  companyId     Int?                  @map("company_id")
  moduleType    String                @map("module_type")
  status        CoreOfflineSyncStatus @default(PENDING)
  itemCount     Int                   @default(0) @map("item_count")
  payload       Json                  @default("{}")
  submittedById Int?                  @map("submitted_by_id")
  submittedAt   DateTime              @default(now()) @map("submitted_at")
  processedAt   DateTime?             @map("processed_at")
  errorMessage  String?               @map("error_message") @db.Text

  worker      Worker?                   @relation(fields: [workerId], references: [id], onDelete: SetNull)
  company     Company?                  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  submittedBy User?                     @relation("CoreOfflineSyncSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  conflicts   CoreOfflineSyncConflict[]

  @@index([deviceId, status])
  @@index([companyId, moduleType, submittedAt])
  @@map("core_offline_sync_batches")
}

model CoreOfflineSyncConflict {
  id            String    @id @default(uuid())
  batchId       String    @map("batch_id")
  deviceId      String    @map("device_id")
  moduleType    String    @map("module_type")
  recordKey     String    @map("record_key")
  localValue    Json      @default("{}") @map("local_value")
  serverValue   Json      @default("{}") @map("server_value")
  resolvedValue Json?     @map("resolved_value")
  resolvedById  Int?      @map("resolved_by_id")
  resolvedAt    DateTime? @map("resolved_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  batch      CoreOfflineSyncBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  resolvedBy User?                @relation("CoreOfflineSyncConflictResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([deviceId, resolvedAt])
  @@index([moduleType, recordKey])
  @@map("core_offline_sync_conflicts")
}

// -----------------------------------------------------
// VERA EVENT BUS — transactional outbox + DLQ
// -----------------------------------------------------

enum EventOutboxStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
  DLQ
}

model EventOutbox {
  id             String            @id @default(uuid())
  eventName      String
  topic          String
  natsSubject    String
  partitionKey   String?
  payload        Json
  status         EventOutboxStatus @default(PENDING)
  attempts       Int               @default(0)
  maxAttempts    Int               @default(5)
  lastError      String?
  publishedAt    DateTime?
  nextRetryAt    DateTime?
  idempotencyKey String?           @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  deadLetters EventDeadLetter[]

  @@index([status, nextRetryAt, createdAt])
  @@index([eventName, createdAt])
  @@map("event_outbox")
}

model EventDeadLetter {
  id            String   @id @default(uuid())
  outboxId      String?
  eventName     String
  topic         String
  payload       Json
  errorMessage  String
  attempts      Int      @default(0)
  consumerGroup String?
  createdAt     DateTime @default(now())

  outbox EventOutbox? @relation(fields: [outboxId], references: [id], onDelete: SetNull)

  @@index([eventName, createdAt])
  @@map("event_dead_letter")
}

