  project        Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  emergencyEvent PmEmergencyEvent?         @relation(fields: [emergencyEventId], references: [id], onDelete: SetNull)
  triggeredBy    User?                     @relation("MusterTriggeredBy", fields: [triggeredByUser], references: [id], onDelete: SetNull)
