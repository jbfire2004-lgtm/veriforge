enum MusterEventStatus {
  activated
  accounting
  all_clear
  cancelled
}

model EmergencyPlan {
  id                   String                @id @default(uuid())
  companyId            Int
  siteId               Int
  projectId            Int?
  title                String
  planType             PmEmergencyPlanType   @default(evacuation)
  status               PmEmergencyPlanStatus @default(draft)
  versionNum           Int                   @default(1)
