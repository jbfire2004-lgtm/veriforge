  signedAt      DateTime @default(now())

  action PmCorrectiveAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId])
  @@map("pm_corrective_action_signature")
}

model PmCorrectiveActionAuditLog {
  id        String   @id @default(uuid())
  actionId  String
  eventType String
