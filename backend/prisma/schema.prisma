  cailEntry    CailEntry?       @relation(fields: [cailEntryId], references: [id], onDelete: SetNull)

  @@index([inspectionId])
  @@map("safety_inspection_item")
}

model BboObservation {
  id                  String               @id @default(uuid())
  projectId           Int
  observedByUserId    Int
  observerCompanyId   Int?
  polarity            ObservationPolarity
  behaviorDescription String               @db.Text
  locationNote        String?              @db.VarChar(500)
  workActivity        String?              @db.VarChar(500)
  workersObservedCount Int?
  behaviorCategory    BboBehaviorCategory?
  safeBehaviors       String?              @db.Text
  atRiskBehaviors     String?              @db.Text
  antecedents         Json?
  feedbackGiven       Boolean              @default(false)
  feedbackNotes       String?              @db.Text
  workerResponse      String?              @db.Text
  actionAgreed        String?              @db.Text
  actionOwnerUserId   Int?
  actionDueAt         DateTime?
  steeringEscalate    Boolean              @default(false)
  siteId              Int?
  equipmentId         Int?
  workerId            Int?
  ownerCompanyId      Int?
  assignedUserId      Int?
  severity            CailSeverity?
  riskCategory        CailRiskCategory?
  cailEntryId         String?              @unique
  aiAnalysis          Json?
  observedAt          DateTime             @default(now())
  createdAt           DateTime             @default(now())

  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  observedBy      User       @relation("BboObserver", fields: [observedByUserId], references: [id], onDelete: Restrict)
  observerCompany Company?   @relation(fields: [observerCompanyId], references: [id], onDelete: SetNull)
  site            Site?      @relation(fields: [siteId], references: [id], onDelete: SetNull)
  equipment       Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  worker          Worker?    @relation(fields: [workerId], references: [id], onDelete: SetNull)
  ownerCompany    Company?   @relation("BboOwner", fields: [ownerCompanyId], references: [id], onDelete: SetNull)
  assignedUser    User?      @relation("BboAssigned", fields: [assignedUserId], references: [id], onDelete: SetNull)
  actionOwner     User?      @relation("BboActionOwner", fields: [actionOwnerUserId], references: [id], onDelete: SetNull)
  cailEntry       CailEntry? @relation(fields: [cailEntryId], references: [id], onDelete: SetNull)

  @@index([projectId, polarity])
  @@index([projectId, behaviorCategory])
  @@index([observedByUserId, observedAt])
  @@map("bbo_observation")
}

