  INACTIVE
  SUSPENDED
}

enum VeriForgeAssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum VeriForgeCheckStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum VeriForgeCheckResult {
