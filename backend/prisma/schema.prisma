  endorsedByUserId Int
  skill            String
  message          String?  @db.Text
  createdAt        DateTime @default(now())

  expertProfile ExpertProfile @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)
  endorsedBy    User          @relation("ExpertEndorsementBy", fields: [endorsedByUserId], references: [id], onDelete: Cascade)

  @@unique([expertProfileId, endorsedByUserId, skill])
  @@index([expertProfileId])
}

// -----------------------------------------------------
// MODERATION — reports, queue, auto-rules, expert verification
// -----------------------------------------------------

enum ModerationTargetType {
  FEED_ITEM
  SOCIAL_POST
  USER
  EXPERT_QA_QUESTION
  EXPERT_QA_ANSWER
  SAFETY_ARTICLE
  SAFETY_COMMENT
  JOB_POST
}

enum ModerationReportReason {
  SPAM
  HARASSMENT
  MISINFORMATION
  OFF_TOPIC
  IMPERSONATION
  SAFETY_RISK
  OTHER
}

enum ModerationCaseStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum ModerationCaseSource {
  USER_REPORT
  AUTO_RULE
}

enum ModerationResolution {
  NO_ACTION
  CONTENT_HIDDEN
  USER_WARNED
  USER_SUSPENDED
  EXPERT_VERIFIED
  EXPERT_REJECTED
}

enum ModerationAutoRuleType {
  KEYWORD_MATCH
  REPORT_THRESHOLD
  REPUTATION_FLOOR
}

enum ModerationAutoAction {
  FLAG
  AUTO_HIDE
}

enum ExpertVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model ModerationAutoRule {
  id         String                 @id @default(uuid())
  name       String
  enabled    Boolean                @default(true)
  targetType ModerationTargetType?
  ruleType   ModerationAutoRuleType
  config     Json
  priority   Int                    @default(0)
  action     ModerationAutoAction   @default(FLAG)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  cases ModerationCase[]

  @@index([enabled, priority(sort: Desc)])
}

model ModerationCase {
  id               String                  @id @default(uuid())
  source           ModerationCaseSource
  targetType       ModerationTargetType
  targetId         String
  reportReason     ModerationReportReason?
  reportDetails    String?                 @db.Text
  reporterUserId   Int?
  autoRuleId       String?
  priority         Int                     @default(0)
  status           ModerationCaseStatus    @default(OPEN)
  resolution       ModerationResolution?
  resolutionNote   String?                 @db.Text
  assignedToUserId Int?
  reviewedByUserId Int?
  reviewedAt       DateTime?
  metadata         Json?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  reporter User?               @relation("ModerationReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  reviewer User?               @relation("ModerationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  assignee User?               @relation("ModerationAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  autoRule ModerationAutoRule? @relation(fields: [autoRuleId], references: [id], onDelete: SetNull)

  @@index([status, priority(sort: Desc), createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([reporterUserId])
}

model ExpertVerificationRequest {
  id               String                   @id @default(uuid())
  userId           Int
  expertProfileId  String
  status           ExpertVerificationStatus @default(PENDING)
  statement        String?                  @db.Text
  tradeEvidence    String?                  @db.Text
  submittedAt      DateTime                 @default(now())
  reviewedAt       DateTime?
  reviewedByUserId Int?
  reviewNote       String?                  @db.Text

  user          User          @relation("ExpertVerificationApplicant", fields: [userId], references: [id], onDelete: Cascade)
  expertProfile ExpertProfile @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)
  reviewer      User?         @relation("ExpertVerificationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([status, submittedAt(sort: Desc)])
  @@index([userId])
}

// -----------------------------------------------------
// VERA PM — UNIFIED SAFETY FORMS SYSTEM
// -----------------------------------------------------

enum SafetyFormStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CLOSED
  CANCELLED
}

enum SafetyFormType {
  JHA
  FLHA
  SIF
  HECA
  ENERGY_WHEEL
  INSPECTION
}

enum SafetyFormSignatureRole {
  WORKER
  SUPERVISOR
  AUTHORIZER
  WITNESS
  OTHER
}

enum SafetyFormActionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Published JSON form definition (versioned catalog).
model SafetyFormDefinition {
  id         String   @id
  name       String
  category   String
  version    Int      @default(1)
  definition Json
  isActive   Boolean  @default(true)
  companyId  Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  versions SafetyFormVersion[]
  forms    SafetyForm[]

  @@index([category, isActive])
  @@index([companyId])
  @@map("safety_form_definitions")
}

/// Immutable snapshot of a definition version.
model SafetyFormVersion {
  id           String   @id @default(uuid())
  definitionId String
  version      Int
  definition   Json
  publishedAt  DateTime @default(now())
  publishedBy  Int?

  formDefinition SafetyFormDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, version])
  @@index([definitionId, version])
  @@map("safety_form_versions")
}

/// Primary safety form submission record.
model SafetyForm {
  id                String           @id @default(uuid())
  definitionId      String
  definitionVersion Int              @default(1)
  formType          SafetyFormType?
  status            SafetyFormStatus @default(DRAFT)
  title             String?
  formData          Json             @default("{}")
  sifFlag           Boolean          @default(false)
  hecaFlag          Boolean          @default(false)

  companyId    Int?
  projectId    Int?
  siteId       Int?
  workerId     Int?
  equipmentId  Int?
  incidentId   Int?
  supervisorId Int?

  createdById   Int?
  submittedById Int?
  reviewedById  Int?
  submittedAt   DateTime?
  reviewedAt    DateTime?

  clientSyncId   String? @unique
  clientVersion  Int     @default(0)
  offlinePending Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  formDefinition SafetyFormDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  company        Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  project        Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  site           Site?                @relation(fields: [siteId], references: [id], onDelete: SetNull)
  worker         Worker?              @relation(fields: [workerId], references: [id], onDelete: SetNull)
  equipment      Equipment?           @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  incident       Incident?            @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  createdBy      User?                @relation("SafetyFormCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  submittedBy    User?                @relation("SafetyFormSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy     User?                @relation("SafetyFormReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  supervisor     User?                @relation("SafetyFormSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)

  submissions SafetyFormSubmission[]
  attachments SafetyFormAttachment[]
  signatures  SafetyFormSignature[]
  actions     SafetyFormAction[]
  auditLogs   SafetyFormAuditLog[]
  cailLinks   SafetyFormCailLink[]

  @@index([formType, status])
  @@index([definitionId, status])
  @@index([companyId, status, updatedAt])
  @@index([projectId, status])
  @@index([projectId, status, updatedAt], map: "idx_safety_form_project_status_updated")
  @@index([workerId, createdAt])
  @@index([siteId, status])
  @@map("safety_forms")
}

/// Versioned data snapshots per submit/save.
model SafetyFormSubmission {
  id            String           @id @default(uuid())
  formId        String
  versionNumber Int
  formData      Json
  status        SafetyFormStatus
  submittedAt   DateTime         @default(now())
  submittedById Int?

  form SafetyForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, versionNumber])
  @@index([formId, submittedAt])
  @@map("safety_form_submissions")
}

model SafetyFormAttachment {
  id         String   @id @default(uuid())
  formId     String
  fieldId    String?
  fileName   String
  mimeType   String?
  storageKey String?
  dataUrl    String?  @db.Text
  sizeBytes  Int?
  createdAt  DateTime @default(now())

  form SafetyForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("safety_form_attachments")
}

/// Optional per-company/project form template overrides.
model SafetyFormTemplate {
  id            String         @id @default(uuid())
  formType      SafetyFormType
  name          String
  schemaVersion Int            @default(1)
  template      Json           @default("{}")
  companyId     Int?
  projectId     Int?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([formType, active])
  @@index([companyId, projectId])
  @@map("safety_form_templates")
}

model SafetyFormSignature {
  id            String                  @id @default(uuid())
  formId        String
  fieldId       String?
  role          SafetyFormSignatureRole @default(WORKER)
  signerName    String?
  signerUserId  Int?
  signatureData String                  @db.Text
  signedAt      DateTime                @default(now())

  form       SafetyForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  signerUser User?      @relation(fields: [signerUserId], references: [id], onDelete: SetNull)

  @@index([formId])
  @@map("safety_form_signatures")
}

model SafetyFormAction {
  id               String                 @id @default(uuid())
  formId           String
  title            String
  description      String?                @db.Text
  status           SafetyFormActionStatus @default(OPEN)
  priority         String                 @default("NORMAL")
  dueAt            DateTime?
  assignedToId     Int?
  coreActionItemId String?
  autoGenerated    Boolean                @default(false)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  form SafetyForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, status])
  @@map("safety_form_actions")
}

model SafetyFormAuditLog {
  id        String   @id @default(uuid())
  formId    String
  eventType String
  actorId   Int?
  payload   Json?
  createdAt DateTime @default(now())

  form  SafetyForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  actor User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([formId, createdAt])
  @@map("safety_form_audit_log")
}

// -----------------------------------------------------
// VERA SAFETY INTELLIGENCE — CAIL (Phase 1)
// -----------------------------------------------------

enum CailSourceType {
  inspection
  bbo
  incident
  equipment
  jha
  flha
  heca
  sif
  training
  general
  safety_meeting
}

enum CailStatus {
  open
  in_progress
  overdue
  resolved
  verified
  cancelled
}

enum CailSeverity {
  low
  medium
  high
  critical
}

enum CailRiskCategory {
  behavior
  equipment
  environment
  process
  ppe
  ergonomic
  other
}

model CailEntry {
  id                            String            @id @default(uuid())
  projectId                     Int
  ownerCompanyId                Int
  assignedUserId                Int?
  sourceType                    CailSourceType
  sourceId                      String
  sourceItemId                  String            @default("")
  title                         String
  description                   String?           @db.Text
  status                        CailStatus        @default(open)
  severity                      CailSeverity      @default(medium)
  riskCategory                  CailRiskCategory?
  dueDate                       DateTime?
  createdAt                     DateTime          @default(now())
  updatedAt                     DateTime          @updatedAt
  closedAt                      DateTime?
  verifiedAt                    DateTime?
  createdByUserId               Int?
  verifiedByUserId              Int?
  evidenceBefore                Json              @default("[]")
  evidenceAfter                 Json              @default("[]")
  rootCauseCategory             String?
  rootCauseNotes                String?           @db.Text
  aiRootCauseSuggestions        Json?
  aiCorrectiveActionSuggestions Json?
  aiClassification              Json?
  lessonsLearnedGenerated       Boolean           @default(false)
  tags                          Json              @default("[]")
  siteId                        Int?
  locationNote                  String?           @db.VarChar(500)
  equipmentId                   Int?
  workerId                      Int?
  overdueAt                     DateTime?
  timeToResolveHours            Float?

  project                Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerCompany           Company                       @relation("CailOwnerCompany", fields: [ownerCompanyId], references: [id], onDelete: Restrict)
  assignedUser           User?                         @relation("CailAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdBy              User?                         @relation("CailCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  verifiedBy             User?                         @relation("CailVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  site                   Site?                         @relation(fields: [siteId], references: [id], onDelete: SetNull)
  equipment              Equipment?                    @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  worker                 Worker?                       @relation(fields: [workerId], references: [id], onDelete: SetNull)
  attachments            CailAttachment[]
  activityLogs           CailActivityLog[]
  inspectionItem         SafetyInspectionItem?
  bboObservation         BboObservation?
  equipmentLinks         EquipmentInspectionCailLink[]
  formLinks              SafetyFormCailLink[]
  incidentCapa           IncidentCorrectiveActionPlan?
  lessonLearned          LessonsLearnedEntry?
  pmInspectionDeficiency PmInspectionDeficiency?
  pmCorrectiveAction     PmCorrectiveAction?
  safetyMeeting          SafetyMeeting?

  @@unique([sourceType, sourceId, sourceItemId])
  @@index([projectId, status])
  @@index([ownerCompanyId, status])
  @@index([dueDate])
  @@index([sourceType, sourceId])
  @@map("cail_entry")
}

model CailAttachment {
  id           String   @id @default(uuid())
  cailId       String
  phase        String
  fileName     String
  storageKey   String?
  mimeType     String?
  dataUrl      String?  @db.Text
  uploadedById Int?
  createdAt    DateTime @default(now())

  cail       CailEntry @relation(fields: [cailId], references: [id], onDelete: Cascade)
  uploadedBy User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([cailId])
  @@map("cail_attachment")
}

model CailActivityLog {
  id        String   @id @default(uuid())
  cailId    String
  eventType String
  actorId   Int?
  payload   Json?
  createdAt DateTime @default(now())

  cail  CailEntry @relation(fields: [cailId], references: [id], onDelete: Cascade)
  actor User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([cailId, createdAt])
  @@map("cail_activity_log")
}

