/// Fall clearance — CSA Z259.16 calculator persistence
enum FallClearanceEquipmentStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model FallClearanceEquipmentProfile {
  id              String                       @id @default(uuid()) @db.Uuid
  type            String                       @db.VarChar(32)
  manufacturer    String                       @db.VarChar(128)
  model           String                       @db.VarChar(128)
  standardRefs    String[]                     @default([]) @map("standard_refs")
  clearanceParams Json                         @map("clearance_params")
  rawManualData   String?                      @map("raw_manual_data") @db.Text
  status          FallClearanceEquipmentStatus @default(DRAFT)
  createdAt       DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  configurations FallClearanceConfiguration[]
  worksheets     FallClearanceWorksheet[]

  @@index([status])
  @@index([type])
  @@map("equipment_profiles")
}

model FallClearanceConfiguration {
  id                   String   @id @default(uuid()) @db.Uuid
  siteId               String?  @map("site_id") @db.Uuid
  projectId            String?  @map("project_id") @db.Uuid
  workerMassKg         Decimal? @map("worker_mass_kg") @db.Decimal(5, 2)
  anchorHeightM        Decimal  @map("anchor_height_m") @db.Decimal(6, 3)
  workSurfaceHeightM   Decimal  @map("work_surface_height_m") @db.Decimal(6, 3)
  horizontalOffsetM    Decimal? @map("horizontal_offset_m") @db.Decimal(6, 3)
  equipmentId          String?  @map("equipment_id") @db.Uuid
  environment          String?  @db.VarChar(32)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  equipment FallClearanceEquipmentProfile? @relation(fields: [equipmentId], references: [id])
  results   FallClearanceCalculationResult[]

  @@index([siteId])
  @@index([projectId])
  @@index([equipmentId])
  @@map("fall_configurations")
}

model FallClearanceCalculationResult {
  id                  String   @id @default(uuid()) @db.Uuid
  configId            String   @map("config_id") @db.Uuid
  requiredClearanceM  Decimal  @map("required_clearance_m") @db.Decimal(6, 3)
  availableClearanceM Decimal  @map("available_clearance_m") @db.Decimal(6, 3)
  status              String   @db.VarChar(16)
  breakdown           Json?
  standardBasis       Json?    @map("standard_basis")
  aiExplanation       String?  @map("ai_explanation") @db.Text
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  config FallClearanceConfiguration @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([status])
  @@map("fall_calculation_results")
}

model FallClearanceAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  configId   String?  @map("config_id") @db.Uuid
  resultId   String?  @map("result_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  siteId     String?  @map("site_id") @db.Uuid
  projectId  String?  @map("project_id") @db.Uuid
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([configId])
  @@index([resultId])
  @@index([siteId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("clearance_audit_logs")
}

/// User-owned clearance worksheet — Vera never asserts PASS/FAIL.
enum FallClearanceWorksheetStatus {
  DRAFT
  SAVED
}

model FallClearanceWorksheet {
  id                String                        @id @default(uuid()) @db.Uuid
  companyId         Int?                          @map("company_id")
  projectId         Int?                          @map("project_id")
  industry          String?                       @db.VarChar(64)
  equipmentId       String?                       @map("equipment_id") @db.Uuid
  referenceParams   Json                          @map("reference_params")
  userParams        Json                          @map("user_params")
  geometry          Json                          @default("{}")
  userRequiredM     Decimal?                      @map("user_required_m") @db.Decimal(6, 3)
  userAvailableM    Decimal?                      @map("user_available_m") @db.Decimal(6, 3)
  userLineSubtotalM Decimal?                      @map("user_line_subtotal_m") @db.Decimal(6, 3)
  userNotes         String?                       @map("user_notes") @db.Text
  status            FallClearanceWorksheetStatus  @default(DRAFT)
  acknowledgedAt    DateTime?                     @map("acknowledged_at") @db.Timestamptz(6)
  acknowledgedBy    String?                       @map("acknowledged_by") @db.VarChar(128)
  createdAt         DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  equipment FallClearanceEquipmentProfile? @relation(fields: [equipmentId], references: [id])

  @@index([companyId, projectId, createdAt(sort: Desc)])
  @@index([equipmentId])
  @@index([status])
  @@map("fall_clearance_worksheets")
}

enum SafetyProgramIngestStatus {
