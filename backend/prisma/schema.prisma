  incidents            Incident[]
  inspections          Inspection[]
  digitalSignoff       DigitalSignoff[]
  safetyStations       SafetyStation[]
  toolboxTalks         ToolboxTalk[]
  siteContacts         SiteContact[]
  pmSafetyWorkflows    PmSafetyWorkflow[]
  safetyObservations   SafetyObservation[]
  coreMeetingRecords   CoreMeetingRecord[]
  coreComplianceNotes  CoreComplianceNote[]
  coreDailyLogs        CoreDailyLog[]
  coreSiteRisks        CoreSiteRisk[]
  projects             Project[]
  safetyForms          SafetyForm[]
  cailEntries          CailEntry[]
  safetyInspections    SafetyInspection[]
  bboObservations      BboObservation[]
  chemicalInventory    ChemicalInventoryItem[]
  emergencyPlans       EmergencyPlan[]
  musterEvents         MusterEvent[]
  pmEmergencyEvents    PmEmergencyEvent[]
  pmAccessPoints       PmAccessPoint[]
  jhaFlhaRecords       JhaFlha[]
  sifHecaEvents        SifHecaEvent[]
  pmInspections             PmInspection[]
