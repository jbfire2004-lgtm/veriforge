  safetyBlocked Boolean  @default(false)
  blockReason   String?
  createdAt     DateTime @default(now())

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    PmPmTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([projectId, startAt])
  @@index([workerId, startAt])
  @@index([equipmentId, startAt])
  @@map("project_schedules")
}

model PmPmWorkerAssignment {
  id             String               @id @default(uuid())
  projectId      Int
  workPackageId  String?
  taskId         String?
  workerId       Int
  role           String               @default("crew")
  status         PmPmAssignmentStatus @default(pending)
