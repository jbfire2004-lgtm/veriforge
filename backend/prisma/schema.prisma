enum SafetyMeetingType {
  toolbox_talk
  tailgate_meeting
  safety_stand_down
  pre_task_meeting
  daily_safety_briefing
  weekly_safety_meeting
  monthly_safety_meeting
  project_kickoff_safety
  incident_review_meeting
  custom
}

enum SafetyMeetingStatus {
  draft
  published
  in_progress
  completed
  reviewed
  locked
}

enum SafetyMeetingReviewStatus {
  not_required
  pending
  approved
  rejected
  changes_requested
}

enum SafetyMeetingTemplateStatus {
  draft
  published
  archived
}

enum TopicLibraryScope {
  company
  project
}

enum TopicLibraryCategoryCode {
  ppe
  fall_protection
  confined_space
  hot_work
  electrical_safety
  equipment_operation
  housekeeping
  environmental
  behavioral_safety
  sif_heca
  general
}

enum SafetyMeetingAttendeeStatus {
  expected
  present
  absent
  excused
}

model TopicLibraryCategory {
  id          String                   @id @default(uuid())
  companyId   Int
  projectId   Int?
  code        TopicLibraryCategoryCode @default(general)
  name        String
  description String?
  sortOrder   Int                      @default(0)
  active      Boolean                  @default(true)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  company Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  topics  TopicLibraryEntry[]

  @@index([companyId])
  @@map("topic_library_categories")
}

model TopicLibraryEntry {
  id                  String            @id @default(uuid())
  companyId           Int
  projectId           Int?
  categoryId          String?
  scope               TopicLibraryScope @default(company)
  title               String
  summary             String?           @db.Text
  discussionPoints    Json              @default("[]")
  requiredControls    Json              @default("[]")
  requiredAttachments Json              @default("[]")
  isHighRisk          Boolean           @default(false)
  requiresSifReview   Boolean           @default(false)
  sifHecaTags         Json              @default("[]")
  sourceRefs          Json              @default("[]")
  usageCount          Int               @default(0)
  active              Boolean           @default(true)
  deletedAt           DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  company       Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project       Project?              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category      TopicLibraryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  meetingTopics SafetyMeetingTopic[]

  @@index([companyId, projectId])
  @@index([categoryId])
  @@index([active])
  @@map("topic_library")
}

model SafetyMeetingTemplate {
  id                String                      @id @default(uuid())
  companyId         Int
  projectId         Int?
  meetingType       SafetyMeetingType
  name              String
  description       String?                     @db.Text
  version           Int                         @default(1)
  status            SafetyMeetingTemplateStatus @default(draft)
  agendaJson        Json                        @default("[]")
  requiredTopicIds  Json                        @default("[]")
  publishedAt       DateTime?
  publishedByUserId Int?
  parentTemplateId  String?
  deletedAt         DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project        Project?                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  publishedBy    User?                   @relation("SafetyMeetingTemplatePublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  parentTemplate SafetyMeetingTemplate?  @relation("SafetyMeetingTemplateVersion", fields: [parentTemplateId], references: [id], onDelete: SetNull)
  childVersions  SafetyMeetingTemplate[] @relation("SafetyMeetingTemplateVersion")
  meetings       SafetyMeeting[]

  @@index([companyId, projectId])
  @@index([meetingType, status])
  @@map("safety_meeting_templates")
}

model SafetyMeeting {
  id                       String                    @id @default(uuid())
  companyId                Int
  projectId                Int
  siteId                   Int?
  templateId               String?
  meetingType              SafetyMeetingType
  customMeetingTypeLabel   String?
  status                   SafetyMeetingStatus       @default(draft)
  title                    String
  locationNote             String?
  scheduledAt              DateTime?
  startedAt                DateTime?
  completedAt              DateTime?
  lockedAt                 DateTime?
  facilitatorWorkerId      Int?
  supervisorUserId         Int?
  requiresSupervisorReview Boolean                   @default(false)
  reviewStatus             SafetyMeetingReviewStatus @default(not_required)
  reviewNotes              String?                   @db.Text
  reviewedAt               DateTime?
  reviewedByUserId         Int?
  qualityScore             Int?
  engagementScore          Int?
  cailEntryId              String?                   @unique
  safetyStationId          Int?
  discussionNotes          String?                   @db.Text
  hazardsDiscussed         Json                      @default("[]")
  controlsDiscussed        Json                      @default("[]")
  metadata                 Json                      @default("{}")
  pmInspectionId           String?                   @unique
  clientSyncId             String?                   @unique
  clientVersion            Int                       @default(1)
  deletedAt                DateTime?
  createdByUserId          Int
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  company          Company                         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project          Project                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site             Site?                           @relation(fields: [siteId], references: [id], onDelete: SetNull)
  template         SafetyMeetingTemplate?          @relation(fields: [templateId], references: [id], onDelete: SetNull)
  facilitator      Worker?                         @relation("SafetyMeetingFacilitator", fields: [facilitatorWorkerId], references: [id], onDelete: SetNull)
  supervisor       User?                           @relation("SafetyMeetingSupervisor", fields: [supervisorUserId], references: [id], onDelete: SetNull)
  reviewedBy       User?                           @relation("SafetyMeetingReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  createdBy        User                            @relation("SafetyMeetingCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  cailEntry        CailEntry?                      @relation(fields: [cailEntryId], references: [id], onDelete: SetNull)
  safetyStation    SafetyStation?                  @relation(fields: [safetyStationId], references: [id], onDelete: SetNull)
  topics           SafetyMeetingTopic[]
  attendees        SafetyMeetingAttendee[]
  signatures       SafetyMeetingSignature[]
  attachments      SafetyMeetingAttachment[]
  correctiveLinks  SafetyMeetingCorrectiveAction[]
  auditLogs        SafetyMeetingAuditLog[]
  sourceInspection PmInspection?                   @relation(fields: [pmInspectionId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([companyId, meetingType])
  @@index([scheduledAt])
  @@index([siteId, status])
  @@index([pmInspectionId])
  @@map("safety_meetings")
}

model SafetyMeetingTopic {
  id               String   @id @default(uuid())
  meetingId        String
  topicLibraryId   String?
  sortOrder        Int      @default(0)
  title            String
  discussionPoints Json     @default("[]")
  requiredControls Json     @default("[]")
  requiredActions  Json     @default("[]")
  notes            String?  @db.Text
  isHighRisk       Boolean  @default(false)
  sourceModule     String?
  sourceId         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  meeting         SafetyMeeting                   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  topicLibrary    TopicLibraryEntry?              @relation(fields: [topicLibraryId], references: [id], onDelete: SetNull)
  attachments     SafetyMeetingAttachment[]
  correctiveLinks SafetyMeetingCorrectiveAction[]

  @@index([meetingId])
  @@map("safety_meeting_topics")
}

model SafetyMeetingAttendee {
  id                  String                      @id @default(uuid())
  meetingId           String
  workerId            Int
  status              SafetyMeetingAttendeeStatus @default(expected)
  checkedInAt         DateTime?
  trainingValid       Boolean?
  equipmentAuthorized Boolean?
  identityVerified    Boolean                     @default(false)
  verificationMethod  String?
  notes               String?
  clientSyncId        String?                     @unique
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  meeting    SafetyMeeting            @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  worker     Worker                   @relation(fields: [workerId], references: [id], onDelete: Cascade)
