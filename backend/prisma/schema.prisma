// -----------------------------------------------------
// ADOPTION & USAGE ANALYTICS
// -----------------------------------------------------
model CompanyAnalytics {
  id             Int       @id @default(autoincrement())
  companyId      Int       @unique @map("company_id")
  lastLogin      DateTime? @map("last_login")
  activeUsers30d Int       @default(0) @map("active_users_30d")
  modulesUsed    Json      @default("{}") @map("modules_used")
  totalWorkers   Int       @default(0) @map("total_workers")
  totalEquipment Int       @default(0) @map("total_equipment")
  totalProjects  Int       @default(0) @map("total_projects")
  churnRiskScore Float     @default(0) @map("churn_risk_score")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_analytics")
}

model AnalyticsEvent {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  userId    Int?     @map("user_id")
  eventType String   @map("event_type")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation("AnalyticsEventUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([eventType, createdAt])
  @@map("analytics_events")
}

model CompanyUsageDaily {
  id                 Int      @id @default(autoincrement())
  companyId          Int      @map("company_id")
  date               DateTime @db.Date
  trainingEvents     Int      @default(0) @map("training_events")
  verificationEvents Int      @default(0) @map("verification_events")
  signoffEvents      Int      @default(0) @map("signoff_events")
  incidentEvents     Int      @default(0) @map("incident_events")
  projectEvents      Int      @default(0) @map("project_events")
  jhaEvents          Int      @default(0) @map("jha_events")
  flhaEvents         Int      @default(0) @map("flha_events")
  sifEvents          Int      @default(0) @map("sif_events")
  equipmentEvents    Int      @default(0) @map("equipment_events")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@index([date])
  @@map("company_usage_daily")
}

model FeedbackRequest {
  id            Int                   @id @default(autoincrement())
  companyId     Int?                  @map("company_id")
  userId        Int?                  @map("user_id")
  title         String
  description   String                @db.Text
  category      String                @default("general")
  status        FeedbackRequestStatus @default(NEW)
  upvotes       Int                   @default(0)
  internalNotes String?               @map("internal_notes") @db.Text
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  company Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User?          @relation("FeedbackRequestUser", fields: [userId], references: [id], onDelete: SetNull)
  votes   FeedbackVote[]

  @@index([status, upvotes])
  @@map("feedback_requests")
}

model FeedbackVote {
  id         Int      @id @default(autoincrement())
  feedbackId Int      @map("feedback_id")
  userId     Int      @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  feedback FeedbackRequest @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user     User            @relation("FeedbackVoteUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, userId])
  @@map("feedback_votes")
}

// -----------------------------------------------------
// TRAINING INGESTION (file upload pipeline audit trail)
// -----------------------------------------------------
model TrainingIngestionRun {
  id               Int       @id @default(autoincrement())
  companyId        Int
  status           String    @default("PENDING")
  sourceChannel    String    @default("upload")
  sourceMime       String
  originalFilename String
  sizeBytes        Int
  coreFileId       Int?
  ocrText          String?   @db.Text
  ocrExtracted     Json?
  ocrConfidence    Float?
  metadataSnapshot Json?
  validationErrors Json?
  resultSummary    Json?
  errorMessage     String?   @db.Text
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  coreFile       CoreFile?        @relation(fields: [coreFileId], references: [id], onDelete: SetNull)
  createdRecords TrainingRecord[] @relation("TrainingRecordIngestionSource")

  @@index([companyId, createdAt])
  @@index([companyId, status, createdAt])
  @@index([sourceChannel, createdAt])
}

// -----------------------------------------------------
// COMPANY TRAINING REQUIREMENTS
// -----------------------------------------------------
model TrainingRequirement {
  id            Int      @id @default(autoincrement())
  companyId     Int
  courseName    String
  expiresInDays Int
  createdAt     DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, courseName])
}

