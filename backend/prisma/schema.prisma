model ExpertQaQuestionTag {
  questionId String
  tagId      String

  question ExpertQaQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      ExpertQaTag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
}

model ExpertQaAttachment {
  id         String                 @id @default(uuid())
  questionId String
  fileName   String
  fileUrl    String
  mimeType   String
  type       ExpertQaAttachmentType @default(OTHER)
  sizeBytes  Int?
  createdAt  DateTime               @default(now())

  question ExpertQaQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model ExpertQaAnswer {
  id               String                   @id @default(uuid())
  questionId       String
  authorUserId     Int
  expertProfileId  String?
  body             String                   @db.Text
  voteScore        Int                      @default(0)
  isExpertAnswer   Boolean                  @default(false)
  moderationStatus ExpertQaModerationStatus @default(VISIBLE)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  question      ExpertQaQuestion     @relation("QuestionAnswers", fields: [questionId], references: [id], onDelete: Cascade)
  acceptedFor   ExpertQaQuestion?    @relation("AcceptedAnswer")
  author        User                 @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  expertProfile ExpertProfile?       @relation(fields: [expertProfileId], references: [id], onDelete: SetNull)
  votes         ExpertQaAnswerVote[]

  @@index([questionId, voteScore(sort: Desc)])
  @@index([authorUserId])
}

model ExpertQaAnswerVote {
