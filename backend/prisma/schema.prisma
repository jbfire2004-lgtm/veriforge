// -----------------------------------------------------
// VERA CORE — COMPLIANCE NOTES (audit / regulatory tracking)
// -----------------------------------------------------
enum CoreComplianceNoteCategory {
  REGULATORY
  AUDIT
  INTERNAL
  CLIENT
  OTHER
}

enum CoreComplianceNoteStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CoreComplianceNotePriority {
  LOW
  NORMAL
  HIGH
}

model CoreComplianceNote {
  id              Int                        @id @default(autoincrement())
  title           String
  body            String?                    @db.Text
  category        CoreComplianceNoteCategory @default(INTERNAL)
  status          CoreComplianceNoteStatus   @default(DRAFT)
  priority        CoreComplianceNotePriority @default(NORMAL)
  dueAt           DateTime?
  companyId       Int?
  siteId          Int?
  createdByUserId Int?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("CoreComplianceNoteAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([siteId, status])
  @@index([category])
  @@index([dueAt])
}

// -----------------------------------------------------
// VERA CORE — DAILY LOG (shift / site safety log entry)
// -----------------------------------------------------
enum CoreDailyLogShift {
  DAY
  NIGHT
  OTHER
}

model CoreDailyLog {
  id                Int               @id @default(autoincrement())
  title             String
  /// Legacy narrative; prefer `activities` (kept for older rows/clients)
  body              String?           @db.Text
  /// Work / shift activities for the day (schema: activities)
  activities        String?           @db.Text
  /// Safety observations / notes (schema: safety_notes)
  safetyNotes       String?           @db.Text
  logDate           DateTime
  shift             CoreDailyLogShift @default(DAY)
  companyId         Int?
  siteId            Int?
  createdByUserId   Int?
  /// Supervising user for the log (schema: supervisor)
  supervisorUserId  Int?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  company     Company?                 @relation(fields: [companyId], references: [id], onDelete: SetNull)
  site        Site?                    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  createdBy   User?                    @relation("CoreDailyLogAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)
  supervisor  User?                    @relation("CoreDailyLogSupervisor", fields: [supervisorUserId], references: [id], onDelete: SetNull)
  attachments CoreDailyLogAttachment[]

  coreActionItems CoreActionItem[]

  @@index([companyId, logDate])
  @@index([siteId, logDate])
  @@index([shift])
  @@index([supervisorUserId])
}

/// Links a daily log to Document Storage CoreFile rows (schema: attachments).
model CoreDailyLogAttachment {
  id          Int      @id @default(autoincrement())
  dailyLogId  Int
  coreFileId  Int
  createdAt   DateTime @default(now())

  dailyLog CoreDailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  coreFile CoreFile     @relation(fields: [coreFileId], references: [id], onDelete: Cascade)

  @@unique([dailyLogId, coreFileId])
  @@index([dailyLogId])
  @@index([coreFileId])
}

// -----------------------------------------------------
// VERA CORE — SITE RISK REGISTER (tracked hazards / mitigations)
// -----------------------------------------------------
enum CoreSiteRiskCategory {
  STRUCTURAL
  ELECTRICAL
  ERGONOMIC
  ENVIRONMENTAL
  OTHER
}

enum CoreSiteRiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CoreSiteRiskStatus {
  OPEN
  IN_PROGRESS
  MITIGATED
  CLOSED
}

model CoreSiteRisk {
  id           Int                  @id @default(autoincrement())
  title        String
  description  String?              @db.Text
  category     CoreSiteRiskCategory @default(OTHER)
  severity     CoreSiteRiskSeverity @default(MEDIUM)
  status       CoreSiteRiskStatus   @default(OPEN)
  identifiedAt DateTime
  mitigatedAt  DateTime?
  locationNote String?              @db.VarChar(500)
  companyId    Int?
  siteId       Int?
  ownerUserId  Int?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  site    Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  owner   User?    @relation("CoreSiteRiskOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([siteId, identifiedAt])
  @@index([category])
  @@index([severity])
}

// -----------------------------------------------------
// VERA CORE — SAFETY OBSERVATIONS (field hazard / positive safety notes)
// -----------------------------------------------------
enum SafetyObservationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SafetyObservationStatus {
  OPEN
  REVIEWED
  CLOSED
}

model SafetyObservation {
  id               Int                       @id @default(autoincrement())
  title            String
  description      String?                   @db.Text
  severity         SafetyObservationSeverity @default(MEDIUM)
  status           SafetyObservationStatus   @default(OPEN)
  observedAt       DateTime
  locationNote     String?                   @db.VarChar(500)
  companyId        Int?
  siteId           Int?
  reportedByUserId Int?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  site       Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  reportedBy User?    @relation("SafetyObservationReporter", fields: [reportedByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, observedAt])
  @@index([siteId, observedAt])
  @@index([status])
}

// -----------------------------------------------------
// VERA CORE — MEETING RECORDS (toolbox / team safety minutes)
// -----------------------------------------------------
enum CoreMeetingRecordType {
  TEAM_SAFETY
  TOOLBOX
  MANAGEMENT_REVIEW
  OTHER
}

model CoreMeetingRecord {
  id               Int                   @id @default(autoincrement())
  title            String
  body             String?               @db.Text
  meetingType      CoreMeetingRecordType @default(TOOLBOX)
  heldAt           DateTime
  companyId        Int?
  siteId           Int?
  recordedByUserId Int?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  site       Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  recordedBy User?    @relation("CoreMeetingRecordRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  coreActionItems CoreActionItem[]

  @@index([companyId, heldAt])
  @@index([siteId, heldAt])
  @@index([meetingType])
}

// -----------------------------------------------------
// VERA PM — PROJECT SAFETY WORKFLOWS (permit / JSA)
// -----------------------------------------------------
enum PmSafetyWorkflowKind {
  PERMIT_TO_WORK
  JOB_SAFETY_ANALYSIS
  JHA
  FLHA
  SIF
  HECA
  ENERGY_WHEEL
  INSPECTION
}

enum PmSafetyWorkflowStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CLOSED
  CANCELLED
}

model PmSafetyWorkflow {
  id              Int                    @id @default(autoincrement())
  kind            PmSafetyWorkflowKind   @default(PERMIT_TO_WORK)
  title           String
  status          PmSafetyWorkflowStatus @default(DRAFT)
  companyId       Int?
  siteId          Int?
  workDescription String?                @db.Text
  hazardSummary   String?                @db.Text
  controlMeasures String?                @db.Text
  jobLocation     String?                @db.VarChar(500)
  taskStepsJson   Json?
  validFrom       DateTime?
  validTo         DateTime?

  workerUserId            Int?
  workerSignedAt          DateTime?
  workerSignatureText     String?   @db.Text
  supervisorUserId        Int?
  supervisorApprovedAt    DateTime?
  supervisorSignatureText String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company?                @relation(fields: [companyId], references: [id], onDelete: SetNull)
  site           Site?                   @relation(fields: [siteId], references: [id], onDelete: SetNull)
  workerUser     User?                   @relation("PmSafetyWorkerSignoff", fields: [workerUserId], references: [id], onDelete: SetNull)
  supervisorUser User?                   @relation("PmSafetySupervisorApproval", fields: [supervisorUserId], references: [id], onDelete: SetNull)
  events         PmSafetyWorkflowEvent[]

  @@index([companyId, status])
  @@index([siteId, status])
  @@index([status, updatedAt])
  @@index([companyId, status, updatedAt])
  @@index([siteId, status, updatedAt])
}

model PmSafetyWorkflowEvent {
  id         Int      @id @default(autoincrement())
  workflowId Int
  eventType  String
  channel    String?
  payload    Json?
  createdAt  DateTime @default(now())

  workflow PmSafetyWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, createdAt])
  @@index([workflowId, eventType, createdAt], map: "idx_pm_workflow_event_type_created")
}

// -----------------------------------------------------
// SITE CONTACTS (people / escalation for a site)
// -----------------------------------------------------
model SiteContact {
  id        Int      @id @default(autoincrement())
  siteId    Int
  fullName  String
  email     String?
  phone     String?
  role      String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

// -----------------------------------------------------
// TOOLBOX TALKS (site safety briefings)
// -----------------------------------------------------
model ToolboxTalk {
  id                  Int      @id @default(autoincrement())
  siteId              Int
  title               String
  topic               String?
  notes               String?
  conductedAt         DateTime
  facilitatorWorkerId Int?
  createdAt           DateTime @default(now())

  site        Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  facilitator Worker? @relation("ToolboxTalkFacilitator", fields: [facilitatorWorkerId], references: [id], onDelete: SetNull)

  @@index([siteId, conductedAt])
}

// -----------------------------------------------------
// SAFETY STATIONS
// -----------------------------------------------------
model SafetyStation {
  id                   Int                        @id @default(autoincrement())
  companyId            Int?
  projectId            Int?
  siteId               Int?
  equipmentId          Int?
  code                 String?                    @unique
  hardwareId           String?                    @unique
  name                 String
  location             String?
  zoneCode             String                     @default("SITE")
  stationType          PmSafetyStationType        @default(zone)
  status               PmSafetyStationStatus      @default(pending)
  networkMode          PmSafetyStationNetworkMode @default(online)
  firmwareVersion      String?
  latitude             Float?
  longitude            Float?
  heartbeatIntervalSec Int                        @default(60)
  emergencyModeActive  Boolean                    @default(false)
  purpose              String?
  type                 String                     @default("DIGITAL")
  active               Boolean                    @default(true)
  lastPing             DateTime?
  lastSyncAt           DateTime?
  metadataJson         Json                       @default("{}")
  clientSyncId         String?                    @unique
  deletedAt            DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  company        Company?                      @relation("CompanySafetyStations", fields: [companyId], references: [id], onDelete: SetNull)
  project        Project?                      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  site           Site?                         @relation(fields: [siteId], references: [id], onDelete: SetNull)
  equipment      Equipment?                    @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  heartbeats     SafetyStationHeartbeat[]
  safetyMeetings SafetyMeeting[]
  accessLogs     PmSafetyStationAccessLog[]
  equipmentLogs  PmSafetyStationEquipmentLog[]
  musterLogs     PmSafetyStationMusterLog[]
  offlineCaches  PmSafetyStationOfflineCache[]
  attachments    PmSafetyStationAttachment[]

  @@index([siteId, active])
  @@index([companyId, projectId])
  @@index([stationType, status])
  @@index([deletedAt])
}

// -----------------------------------------------------
// EQUIPMENT
// -----------------------------------------------------
model EquipmentCategory {
  id          Int      @id @default(autoincrement())
  companyId   Int?
  name        String
  code        String?
  description String?
  createdAt   DateTime @default(now())

  company   Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  types     EquipmentType[]
  equipment Equipment[]

  @@unique([companyId, name])
  @@index([companyId])
}

model EquipmentType {
  id             Int      @id @default(autoincrement())
  categoryId     Int
  name           String
  code           String?
  catalogTypeKey String?
  createdAt      DateTime @default(now())

  category              EquipmentCategory                   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  equipment             Equipment[]
  competencyRequirement EquipmentTypeCompetencyRequirement?

  @@unique([categoryId, name])
  @@index([catalogTypeKey])
}

model Equipment {
  id            Int                   @id @default(autoincrement())
  name          String
  serialNumber  String?
  assetTag      String?
  qrToken       String?               @unique
  safetyStatus  EquipmentSafetyStatus @default(OK)
  companyId     Int?
  categoryId    Int?
  typeId        Int?
  photoUrl      String?
  description   String?               @db.Text
  manufacturer  String?
  model         String?
  yearMade      Int?
  lockedOutAt   DateTime?
  lockoutReason String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  /// Catalog bucket for inspection cadence + default templates (see Vera Core equipment safety).
  catalogCategory EquipmentCatalogCategory?
  /// Display key from predefined list (e.g. "Skid Steer") or "Other" with custom `name`.
  catalogTypeKey  String?
  /// Operating hours meter (used with formal inspection 250h rule for mobile equipment).
  meterHours      Float                     @default(0)

  /// Real-time compliance snapshot (recalculated by equipment-compliance engine).
  complianceStatus     LinkComplianceStatus         @default(COMPLIANT)
  lastInspectionAt     DateTime?
  nextInspectionAt     DateTime?
  lockoutStatus        EquipmentLockoutStatus       @default(CLEAR)
  competencyRequired   Boolean                      @default(false)
  trainingRequired     Boolean                      @default(false)
  complianceUpdatedAt  DateTime?
  operationalStatus    PmEquipmentOperationalStatus @default(active)
  safetyCategory       PmEquipmentSafetyCategory?
  capacity             String?
  loadChartJson        Json                         @default("{}")
  pmSafetyMetadataJson Json                         @default("{}")
  deletedAt            DateTime?

  company                       Company?                         @relation(fields: [companyId], references: [id])
  category                      EquipmentCategory?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  type                          EquipmentType?                   @relation(fields: [typeId], references: [id], onDelete: SetNull)
  equipmentLinks                EquipmentLink[]
  assignments                   WorkerAssignment[]
  equipmentAssignments          EquipmentAssignment[]
  incidents                     Incident[]
  trainingRequirements          EquipmentTrainingRequirement[]
  digitalSignoff                DigitalSignoff[]                 @relation("EquipmentSignoff")
  inspections                   Inspection[]
  documents                     Document[]
  competencyEvaluations         CompetencyEvaluation[]
  competencyRequirements        EquipmentCompetencyRequirement[]
  workerWalletItems             WorkerWalletItem[]
  equipmentAuditRows            CompanyEquipmentAuditView[]      @relation("EquipmentAuditRow")
  projectAssignments            EquipmentProjectAssignment[]
  mergeRecordsAsSurvivor        EquipmentMergeRecord[]           @relation("EquipmentMergeSurvivor")
  mergeRecordsAsMerged          EquipmentMergeRecord[]           @relation("EquipmentMergeMerged")
  attachments                   EquipmentAttachment[]
  maintenanceRecords            EquipmentMaintenance[]
  calibrations                  EquipmentCalibration[]
  maintenanceSchedules          MaintenanceSchedule[]
  calibrationSchedules          CalibrationSchedule[]
  lockoutHistory                EquipmentLockout[]
  complianceHistory             EquipmentComplianceStatus[]
  safetyForms                   SafetyForm[]
  cailEntries                   CailEntry[]
  safetyInspectionItems         SafetyInspectionItem[]
  bboObservations               BboObservation[]
  jhaFlhaLinks                  JhaFlhaEquipment[]
  sifHecaEvents                 SifHecaEvent[]
  pmInspections                 PmInspection[]
  pmSafetyEventEquipment        PmSafetyEventEquipment[]
  pmCorrectiveActions           PmCorrectiveAction[]
  pmControlledDocuments         PmControlledDocument[]
  pmManufacturerInstructions    PmManufacturerInstruction[]
  pmCertifications              PmEquipmentCertification[]
  pmEquipmentInspections        PmEquipmentInspection[]
  pmFailures                    PmEquipmentFailure[]
  pmLotoEvents                  PmEquipmentLoto[]
  pmConditionScores             PmEquipmentConditionScore[]
  workerAuthorizations          PmWorkerEquipmentAuthorization[]
  pmAssignmentAudits            PmEquipmentAssignmentAudit[]
  pmEquipmentAccessRequirements PmEquipmentAccessRequirement[]
  safetyStations                SafetyStation[]
  pmSafetyStationEquipmentLogs  PmSafetyStationEquipmentLog[]
  pmPmEquipmentAssignments      PmPmEquipmentAssignment[]

  @@index([companyId], map: "idx_equipment_company")
  @@index([operationalStatus])
  @@index([deletedAt])
  @@index([categoryId], map: "idx_equipment_category")
  @@index([typeId], map: "idx_equipment_type")
  @@index([catalogTypeKey])
  @@index([serialNumber], map: "idx_equipment_serial")
  @@index([assetTag], map: "idx_equipment_asset_tag")
  @@index([complianceStatus])
  @@index([nextInspectionAt])
  @@index([lockoutStatus])
}

model EquipmentAttachment {
  id          Int                     @id @default(autoincrement())
  equipmentId Int
  type        EquipmentAttachmentType @default(OTHER)
  name        String
  url         String
  notes       String?
  createdAt   DateTime                @default(now())

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId, createdAt])
}

model EquipmentMaintenance {
  id          Int                      @id @default(autoincrement())
  equipmentId Int
  type        EquipmentMaintenanceType @default(PREVENTIVE)
  performedAt DateTime                 @default(now())
  performedBy Int?
  notes       String?                  @db.Text
  nextDueAt   DateTime?
  meterHours  Float?
  createdAt   DateTime                 @default(now())

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId, performedAt])
}

model EquipmentCalibration {
  id                Int       @id @default(autoincrement())
  equipmentId       Int
  calibratedAt      DateTime  @default(now())
  calibratedBy      Int?
  certificateNumber String?
  expiresAt         DateTime?
  passed            Boolean   @default(true)
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId, calibratedAt])
  @@index([equipmentId, expiresAt])
}

/// Recurring maintenance plan for an asset (records live in `EquipmentMaintenance`).
model MaintenanceSchedule {
  id              Int                      @id @default(autoincrement())
  equipmentId     Int
  type            EquipmentMaintenanceType @default(PREVENTIVE)
  intervalDays    Int                      @default(90)
  intervalHours   Float?
  nextDueAt       DateTime?
  lastPerformedAt DateTime?
  active          Boolean                  @default(true)
  notes           String?                  @db.Text
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId, active])
  @@index([nextDueAt])
}

/// Recurring calibration plan for an asset (records live in `EquipmentCalibration`).
model CalibrationSchedule {
  id               Int       @id @default(autoincrement())
  equipmentId      Int
  intervalDays     Int       @default(365)
  nextDueAt        DateTime?
  lastCalibratedAt DateTime?
  active           Boolean   @default(true)
  notes            String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId, active])
  @@index([nextDueAt])
}

model EquipmentLockout {
  id               Int       @id @default(autoincrement())
  equipmentId      Int
  companyId        Int?
  reason           String    @db.Text
  lockedAt         DateTime  @default(now())
  unlockedAt       DateTime?
  lockedByUserId   Int?
  unlockedByUserId Int?

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([equipmentId, lockedAt])
  @@index([companyId, lockedAt])
}

model EquipmentComplianceStatus {
  id               Int                  @id @default(autoincrement())
  equipmentId      Int
  companyId        Int?
  status           LinkComplianceStatus
  assessedAt       DateTime             @default(now())
  assessedByUserId Int?
  notes            String?              @db.Text
  inspectionId     Int?

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([equipmentId, assessedAt])
  @@index([companyId, status])
}

// -----------------------------------------------------
// INCIDENTS
// -----------------------------------------------------
model Incident {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?
  /// Report category from the field app (e.g. NEAR_MISS, INJURY)
  category     String?
  latitude     Float?
  longitude    Float?
  /// Optional JSON: notes, signature blobs, client-only fields
  metadata     Json?
  status       String   @default("OPEN")
  severity     String   @default("LOW")
  workerId     Int?
  equipmentId  Int?
  companyId    Int?
  siteId       Int?
  createdById  Int?
  assignedToId Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  worker     Worker?    @relation(fields: [workerId], references: [id])
  equipment  Equipment? @relation(fields: [equipmentId], references: [id])
  company    Company?   @relation(fields: [companyId], references: [id])
  site       Site?      @relation(fields: [siteId], references: [id])
  createdBy  User?      @relation("IncidentCreatedBy", fields: [createdById], references: [id])
  assignedTo User?      @relation("IncidentAssignedTo", fields: [assignedToId], references: [id])

  comments          IncidentComment[]
  investigations    Investigation[]
  safetyForms       SafetyForm[]
  vsiInvestigation  VsiIncidentInvestigation?
  incidentCapaPlans IncidentCorrectiveActionPlan[]

  @@index([companyId, status, createdAt])
  @@index([siteId, status, createdAt])
  @@index([workerId, createdAt])
  @@index([equipmentId, createdAt])
}

// -----------------------------------------------------
// INCIDENT COMMENTS
// -----------------------------------------------------
model IncidentComment {
  id         Int      @id @default(autoincrement())
  incidentId Int
  userId     Int
  message    String
  createdAt  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([incidentId, createdAt], map: "idx_incident_comment_incident_created")
}

// -----------------------------------------------------
// TRAINING
// -----------------------------------------------------
model TrainingRecord {
  id                              Int       @id @default(autoincrement())
  workerId                        Int
  certificationId                 Int
  providerId                      Int?
  trainingProviderId              Int?
  courseId                        Int?
  instructorId                    Int?
  companyId                       Int?
  projectId                       Int?
  expiresAt                       DateTime?
  issuedAt                        DateTime  @default(now())
  /// Issuer / card certificate reference (optional)
  certificateNumber               String?
  certificateUrl                  String?
  certificateQrToken              String?   @unique
  certificateSignedAt             DateTime?
  certificateSignedByInstructorId Int?
  /// Set when training is explicitly marked complete (e.g. admin / PATCH complete).
  completedAt                     DateTime?
  /// Last structured verification outcome (VERIFIED | ATTENTION | INVALID).
  lastVerificationStatus          String?
  /// JSON snapshot of the most recent verification checks.
  lastVerificationChecks          Json?
  /// When the last structured verification was run.
  verifiedAt                      DateTime?
  /// Populated when this row was created from the training-ingestion upload pipeline.
  ingestionRunId                  Int?

  worker              Worker                @relation(fields: [workerId], references: [id])
  certification       Certification         @relation(fields: [certificationId], references: [id])
  provider            Provider?             @relation(fields: [providerId], references: [id])
  trainingProvider    TrainingProvider?     @relation(fields: [trainingProviderId], references: [id], onDelete: SetNull)
  course              TrainingCourse?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  instructor          TrainingInstructor?   @relation("TrainingRecordInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  certificateSignedBy TrainingInstructor?   @relation("CertificateSignedBy", fields: [certificateSignedByInstructorId], references: [id], onDelete: SetNull)
  company             Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  project             Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  ingestionRun        TrainingIngestionRun? @relation("TrainingRecordIngestionSource", fields: [ingestionRunId], references: [id], onDelete: SetNull)

  attestations        TrainingAttestation[]
  validationResults   TrainingValidationResult[]
  regulatoryDecisions RegulatoryVerificationDecision[]
  credentialNft       TrainingCredentialNft?
  nftMintJobs         NftMintJob[]
  walletItem          WorkerWalletItem?
  unionHallReceipts   UnionHallTrainingReceipt[]
  verificationRuns    TrainingVerificationRun[]
  ledgerEvents        CredentialLedgerEvent[]

  @@index([workerId, expiresAt])
  @@index([certificationId])
  @@index([providerId])
  @@index([trainingProviderId])
  @@index([courseId])
  @@index([companyId])
  @@index([projectId])
  @@index([ingestionRunId])
  @@index([certificateQrToken])
  @@index([lastVerificationStatus])
}

/// Audit row for each Training Verification Engine run.
model TrainingVerificationRun {
  id                 Int      @id @default(autoincrement())
  trainingRecordId   Int
  overallStatus      String
  authenticityStatus String
  regulatoryStatus   String?
  standardsOutcome   String?
  jurisdictionCode   String?
  checks             Json?
  propagation        Json?
  actorId            Int?
  createdAt          DateTime @default(now())

  trainingRecord TrainingRecord @relation(fields: [trainingRecordId], references: [id], onDelete: Cascade)

  @@index([trainingRecordId, createdAt])
}

/// Append-only audit trail for training credentials (TrainingRecord).
model CredentialLedgerEvent {
  id            Int                       @id @default(autoincrement())
  occurredAt    DateTime                  @default(now())
  actorId       Int?
  actorType     CredentialLedgerActorType @default(SYSTEM)
  eventType     CredentialLedgerEventType
  /// TrainingRecord.id — Vera's canonical worker credential.
  credentialId  Int
  workerId      Int?
  providerId    Int?
  projectId     Int?
  companyId     Int?
  correlationId String?
  payload       Json                      @default("{}")

  credential TrainingRecord @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId, occurredAt])
  @@index([workerId, occurredAt])
  @@index([providerId, occurredAt])
  @@index([companyId, occurredAt])
  @@map("credential_ledger_events")
}

/// Signed / logged confirmation tied to a training record (verification workflow).
model TrainingAttestation {
  id                 Int                     @id @default(autoincrement())
  trainingRecordId   Int
  attestedByWorkerId Int
  role               TrainingAttestationRole @default(OTHER)
  notes              String?
  createdAt          DateTime                @default(now())

  trainingRecord TrainingRecord @relation(fields: [trainingRecordId], references: [id], onDelete: Cascade)
  attestedBy     Worker         @relation(fields: [attestedByWorkerId], references: [id], onDelete: Restrict)

  @@index([trainingRecordId, createdAt], map: "idx_training_attestation_record_created")
  @@index([attestedByWorkerId])
  @@index([createdAt])
}

model Certification {
  id                              Int                                  @id @default(autoincrement())
  name                            String
  code                            String?
  description                     String?
  trainingRecords                 TrainingRecord[]
  trainingCourses                 TrainingCourse[]
  jurisdictionRequirements        JurisdictionRequirement[]
  equipmentRequirements           EquipmentTrainingRequirement[]
  equipmentCompetencyRequirements EquipmentCompetencyRequirement[]
  typeCompetencyRequirements      EquipmentTypeCompetencyRequirement[] @relation("TypeCompetencyCert")
  credentials                     Credential[]
  projectComplianceRules          ProjectComplianceRule[]
}

/// Project-scoped credential requirement (MyComply-style rules).
model ProjectComplianceRule {
  id                       Int                       @id @default(autoincrement())
  projectId                Int
  companyId                Int
  ruleType                 ProjectComplianceRuleType
  requiredCredentialTypeId Int
  metadata                 Json                      @default("{}")
  active                   Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  project       Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company       Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  certification Certification            @relation(fields: [requiredCredentialTypeId], references: [id], onDelete: Restrict)
  alerts        ProjectComplianceAlert[]

  @@index([projectId, active], map: "idx_project_compliance_rule_project_active")
  @@map("project_compliance_rules")
}

/// Open compliance gap for a worker on a project.
model ProjectComplianceAlert {
  id           Int                        @id @default(autoincrement())
  projectId    Int
  workerId     Int
  ruleId       Int?
  credentialId Int?
  type         ProjectComplianceAlertType
  createdAt    DateTime                   @default(now())
  resolvedAt   DateTime?

  project Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  worker  Worker                 @relation(fields: [workerId], references: [id], onDelete: Cascade)
  rule    ProjectComplianceRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([projectId, resolvedAt], map: "idx_project_compliance_alert_project_resolved")
  @@index([workerId, resolvedAt], map: "idx_project_compliance_alert_worker_resolved")
  @@map("project_compliance_alerts")
}

// -----------------------------------------------------
// PROVIDERS
// -----------------------------------------------------
model Provider {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  trainingRecords TrainingRecord[]
}

// -----------------------------------------------------
// TRAINING PROVIDER MODULE
// -----------------------------------------------------
model TrainingProvider {
  id             Int                    @id @default(autoincrement())
  name           String
  code           String?                @unique
  email          String?                @unique
  phone          String?
  website        String?
  address        String?
  logoUrl        String?
  qrToken        String?                @unique
  approvalStatus ProviderApprovalStatus @default(PENDING)
  active         Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  users                        User[]
  courses                      TrainingCourse[]
  instructors                  TrainingInstructor[]
  trainingRecords              TrainingRecord[]
  approvals                    ProviderApproval[]
  complianceStatuses           ProviderComplianceStatus[]
  validationResults            TrainingValidationResult[]
  providerQualificationRules   ProviderQualificationRule[]
  instructorQualificationRules InstructorQualificationRule[]
  unionHallLinks               UnionHallProviderLink[]
  providerProfile              ProviderProfile?
  socialPosts                  SocialPost[]
  syncConfig                   ProviderSyncConfig?
  syncRuns                     ProviderSyncRun[]
  veraApiKeys                  VeraApiKey[]
}

model ProviderSyncConfig {
  id                  Int       @id @default(autoincrement())
  providerId          Int       @unique
  syncMode            String    @default("webhook")
  pollUrl             String?
  pollIntervalMinutes Int       @default(60)
  apiKeyEnvVar        String?
  webhookSecret       String?
  enabled             Boolean   @default(true)
  lastPollAt          DateTime?
  lastSyncAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  provider TrainingProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model ProviderSyncRun {
  id              Int       @id @default(autoincrement())
  providerId      Int
  status          String    @default("PENDING")
  recordsFetched  Int       @default(0)
  recordsVerified Int       @default(0)
  recordsPushed   Int       @default(0)
  errorMessage    String?
  details         Json?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  provider TrainingProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, startedAt])
}

model TrainingInstructor {
  id                     Int                           @id @default(autoincrement())
  providerId             Int
  firstName              String
  lastName               String
  email                  String?
  licenseNumber          String?
  qualifiedCourseCodes   String[]                      @default([])
  qualificationExpiresAt DateTime?
  qualificationStatus    InstructorQualificationStatus @default(ACTIVE)
  userId                 Int?                          @unique
  active                 Boolean                       @default(true)
  createdAt              DateTime                      @default(now())

  provider           TrainingProvider           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user               User?                      @relation("TrainingInstructorUser", fields: [userId], references: [id], onDelete: SetNull)
  trainingRecords    TrainingRecord[]           @relation("TrainingRecordInstructor")
  signedCertificates TrainingRecord[]           @relation("CertificateSignedBy")
  courses            TrainingCourse[]           @relation("CourseInstructors")
  validationResults  TrainingValidationResult[]

  @@index([providerId, active])
}

model TrainingCourse {
  id              Int      @id @default(autoincrement())
  providerId      Int
  certificationId Int?
  code            String
  name            String
  description     String?
  durationHours   Float?
  validityDays    Int?
  contentText     String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  provider          TrainingProvider           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  certification     Certification?             @relation(fields: [certificationId], references: [id], onDelete: SetNull)
  standards         TrainingCourseStandard[]
  trainingRecords   TrainingRecord[]
  instructors       TrainingInstructor[]       @relation("CourseInstructors")
  validationResults TrainingValidationResult[]

  @@unique([providerId, code])
  @@index([providerId, active])
}

model TrainingCourseStandard {
  id          Int     @id @default(autoincrement())
  courseId    Int
  standardKey String
  title       String
  description String?
  required    Boolean @default(true)
  minScore    Int?

  course TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model ProviderApproval {
  id         Int                    @id @default(autoincrement())
  providerId Int
  status     ProviderApprovalStatus
  reviewedBy Int?
  notes      String?
  createdAt  DateTime               @default(now())

  provider       TrainingProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  reviewedByUser User?            @relation("ProviderApprovalReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([providerId, createdAt])
}

model ProviderComplianceStatus {
  id         Int                     @id @default(autoincrement())
  providerId Int
  status     ProviderComplianceLevel
  score      Int?
  gaps       Json?
  assessedAt DateTime                @default(now())
  notes      String?

  provider TrainingProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, assessedAt])
}

// -----------------------------------------------------
// TRAINING STANDARDS COMPLIANCE ENGINE
// -----------------------------------------------------
model TrainingStandard {
  id                  Int                  @id @default(autoincrement())
  code                String               @unique
  title               String
  kind                TrainingStandardKind
  jurisdictionCode    String?
  description         String?
  keywords            String[]             @default([])
  defaultValidityDays Int?
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())

  jurisdictionRequirements JurisdictionRequirement[]

  @@index([kind, active])
  @@index([jurisdictionCode])
}

model JurisdictionRequirement {
  id               Int     @id @default(autoincrement())
  jurisdictionCode String
  regionName       String
  standardCode     String
  required         Boolean @default(true)
  tradeCode        String?
  certificationId  Int?
  notes            String?

  standard      TrainingStandard @relation(fields: [standardCode], references: [code], onDelete: Cascade)
  certification Certification?   @relation(fields: [certificationId], references: [id], onDelete: SetNull)

  @@unique([jurisdictionCode, standardCode, tradeCode])
  @@index([jurisdictionCode, required])
}

model ProviderQualificationRule {
  id                     Int                     @id @default(autoincrement())
  trainingProviderId     Int?
  ruleKey                String
  description            String?
  requiredApprovalStatus ProviderApprovalStatus?
  requiredStandardCodes  String[]                @default([])
  minProviderScore       Int?
  requiresActiveProvider Boolean                 @default(true)
  active                 Boolean                 @default(true)

  trainingProvider TrainingProvider? @relation(fields: [trainingProviderId], references: [id], onDelete: Cascade)

  @@unique([trainingProviderId, ruleKey])
}

model InstructorQualificationRule {
  id                      Int      @id @default(autoincrement())
  trainingProviderId      Int?
  ruleKey                 String
  description             String?
  courseCodePattern       String?
  requiresLicense         Boolean  @default(false)
  maxQualificationAgeDays Int?
  requiredStandardCodes   String[] @default([])
  active                  Boolean  @default(true)

  trainingProvider TrainingProvider? @relation(fields: [trainingProviderId], references: [id], onDelete: Cascade)

  @@unique([trainingProviderId, ruleKey])
}

model TrainingRejectionReason {
  id          Int                       @id @default(autoincrement())
  code        String                    @unique
  title       String
  description String?
  severity    TrainingRejectionSeverity @default(ERROR)
  category    TrainingRejectionCategory
  active      Boolean                   @default(true)

  validationLinks TrainingValidationRejection[]
}

model TrainingValidationResult {
  id                   Int                       @id @default(autoincrement())
  subjectType          TrainingValidationSubject
  outcome              TrainingValidationOutcome @default(PENDING)
  score                Int?
  jurisdictionCode     String?
  matchedStandardCodes String[]                  @default([])
  missingStandardCodes String[]                  @default([])
  details              Json?
  validatedAt          DateTime                  @default(now())
  validatedBy          Int?
  trainingRecordId     Int?
  trainingProviderId   Int?
  instructorId         Int?
  courseId             Int?
  certificateQrToken   String?

  trainingRecord      TrainingRecord?                  @relation(fields: [trainingRecordId], references: [id], onDelete: Cascade)
  trainingProvider    TrainingProvider?                @relation(fields: [trainingProviderId], references: [id], onDelete: Cascade)
  instructor          TrainingInstructor?              @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  course              TrainingCourse?                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  validatedByUser     User?                            @relation("TrainingValidationReviewer", fields: [validatedBy], references: [id], onDelete: SetNull)
  rejections          TrainingValidationRejection[]
  regulatoryDecisions RegulatoryVerificationDecision[]

  @@index([subjectType, outcome, validatedAt])
  @@index([outcome, validatedAt], map: "idx_training_validation_outcome_validated")
  @@index([trainingRecordId, validatedAt])
  @@index([trainingProviderId, validatedAt])
  @@index([certificateQrToken])
}

model TrainingValidationRejection {
  validationResultId Int
  rejectionReasonId  Int
  message            String?

  validationResult TrainingValidationResult @relation(fields: [validationResultId], references: [id], onDelete: Cascade)
  rejectionReason  TrainingRejectionReason  @relation(fields: [rejectionReasonId], references: [id], onDelete: Cascade)

  @@id([validationResultId, rejectionReasonId])
}

/// Cross-jurisdiction acceptance for a standard (e.g. AB training recognized in SK).
model RegulatoryEquivalency {
  id               Int      @id @default(autoincrement())
  fromJurisdiction String   @map("from_jurisdiction")
  toJurisdiction   String   @map("to_jurisdiction")
  standardCode     String   @map("standard_code")
  notes            String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([fromJurisdiction, toJurisdiction, standardCode], map: "regulatory_equivalency_unique")
  @@index([fromJurisdiction, standardCode], map: "regulatory_equivalency_from_std_idx")
  @@index([toJurisdiction, standardCode], map: "regulatory_equivalency_to_std_idx")
  @@map("regulatory_equivalencies")
}

/// Append-only regulatory decision audit (does not replace TrainingValidationResult).
model RegulatoryVerificationDecision {
  id                         Int                        @id @default(autoincrement())
  trainingRecordId           Int                        @map("training_record_id")
  regulatoryComplianceStatus RegulatoryComplianceStatus @map("regulatory_compliance_status")
  complianceScore            Int                        @map("compliance_score")
  jurisdictionCode           String                     @map("jurisdiction_code")
  matchedStandards           String[]                   @default([]) @map("matched_standards")
  jurisdictionCoverage       String[]                   @default([]) @map("jurisdiction_coverage")
  reasons                    String[]                   @default([])
  validationResultId         Int?                       @map("validation_result_id")
  recommendedAction          String                     @map("recommended_action")
  decisionHash               String?                    @map("decision_hash")
  details                    Json?
  createdAt                  DateTime                   @default(now()) @map("created_at")

  trainingRecord   TrainingRecord            @relation(fields: [trainingRecordId], references: [id], onDelete: Cascade)
  validationResult TrainingValidationResult? @relation(fields: [validationResultId], references: [id], onDelete: SetNull)
  credentialNfts   TrainingCredentialNft[]

  @@index([trainingRecordId, createdAt], map: "regulatory_decision_record_created_idx")
  @@index([regulatoryComplianceStatus], map: "regulatory_decision_status_idx")
  @@map("regulatory_verification_decisions")
}

/// NFT lock for a verified training credential (not a blockchain wallet).
model TrainingCredentialNft {
  id                               Int                             @id @default(autoincrement())
  trainingRecordId                 Int                             @unique @map("training_record_id")
  workerId                         Int                             @map("worker_id")
  regulatoryVerificationDecisionId Int                             @map("regulatory_verification_decision_id")
  nftTokenId                       String?                         @map("nft_token_id")
  chain                            String                          @default("vera-stub")
  transactionHash                  String?                         @map("transaction_hash")
  mintStatus                       TrainingCredentialNftMintStatus @default(PENDING_MINT) @map("mint_status")
  regulatoryDecisionHash           String                          @map("regulatory_decision_hash")
  originalDocumentHash             String?                         @map("original_document_hash")
  metadata                         Json?
  mintedAt                         DateTime?                       @map("minted_at")
  createdAt                        DateTime                        @default(now()) @map("created_at")

  trainingRecord     TrainingRecord                 @relation(fields: [trainingRecordId], references: [id], onDelete: Cascade)
  worker             Worker                         @relation(fields: [workerId], references: [id], onDelete: Restrict)
  regulatoryDecision RegulatoryVerificationDecision @relation(fields: [regulatoryVerificationDecisionId], references: [id], onDelete: Restrict)

  @@index([workerId], map: "training_credential_nft_worker_idx")
  @@index([mintStatus], map: "training_credential_nft_mint_status_idx")
  @@map("training_credential_nfts")
}

/// Outbox for async NFT mint (idempotent per training record).
model NftMintJob {
  id               Int              @id @default(autoincrement())
  trainingRecordId Int              @map("training_record_id")
  status           NftMintJobStatus @default(PENDING)
  attempts         Int              @default(0)
  lastError        String?          @map("last_error") @db.Text
  idempotencyKey   String           @unique @map("idempotency_key")
  createdAt        DateTime         @default(now()) @map("created_at")
  processedAt      DateTime?        @map("processed_at")

  trainingRecord TrainingRecord @relation(fields: [trainingRecordId], references: [id], onDelete: Cascade)

  @@index([status, createdAt], map: "nft_mint_job_status_created_idx")
  @@map("nft_mint_jobs")
}

// -----------------------------------------------------
// CREDENTIALS
// -----------------------------------------------------
model Credential {
  id              Int       @id @default(autoincrement())
  workerId        Int
  name            String
  value           String
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?
  issuedAt        DateTime  @default(now())
  certificationId Int?

  worker        Worker         @relation(fields: [workerId], references: [id])
  certification Certification? @relation(fields: [certificationId], references: [id])

  @@index([workerId], map: "idx_credential_worker")
}

// -----------------------------------------------------
// ASSIGNMENTS
// -----------------------------------------------------
model WorkerAssignment {
  id          Int  @id @default(autoincrement())
  workerId    Int
  equipmentId Int?
  siteId      Int?
  companyId   Int?
  assignedBy  Int?

  assignedAt DateTime  @default(now())
  endedAt    DateTime?

  startAt     DateTime?
  endAt       DateTime?
  autoStarted Boolean   @default(false)
  autoEnded   Boolean   @default(false)

  worker         Worker     @relation(fields: [workerId], references: [id])
  equipment      Equipment? @relation(fields: [equipmentId], references: [id])
  site           Site?      @relation(fields: [siteId], references: [id])
  company        Company?   @relation(fields: [companyId], references: [id])
  assignedByUser User?      @relation("WorkerAssignmentsAssigned", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@index([workerId, endedAt], map: "idx_worker_assignment_worker_ended")
  @@index([equipmentId, endedAt], map: "idx_worker_assignment_equipment_ended")
  @@index([siteId, endedAt], map: "idx_worker_assignment_site_ended")
  @@index([companyId], map: "idx_worker_assignment_company")
}

// -----------------------------------------------------
// EQUIPMENT ASSIGNMENTS
// -----------------------------------------------------
model EquipmentAssignment {
  id          Int       @id @default(autoincrement())
  workerId    Int
  equipmentId Int?
  siteId      Int?
  companyId   Int?
  assignedBy  Int?
  assignedAt  DateTime  @default(now())
  endedAt     DateTime?
  startAt     DateTime?
  endAt       DateTime?
  autoStarted Boolean   @default(false)
  autoEnded   Boolean   @default(false)

  worker         Worker     @relation(fields: [workerId], references: [id])
  equipment      Equipment? @relation(fields: [equipmentId], references: [id])
  site           Site?      @relation(fields: [siteId], references: [id])
  company        Company?   @relation(fields: [companyId], references: [id])
  assignedByUser User?      @relation("EquipmentAssignmentsAssigned", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@index([equipmentId, endedAt], map: "idx_equipment_assignment_equipment_ended")
  @@index([workerId, endedAt], map: "idx_equipment_assignment_worker_ended")
  @@index([companyId], map: "idx_equipment_assignment_company")
}

// -----------------------------------------------------
// SITE ACCESS RULES
// -----------------------------------------------------
model WorkerSiteAccess {
  workerId  Int
  siteId    Int
  status    WorkerSiteStatus @default(ALLOWED)
  approved  Boolean          @default(false)
  notes     String?
  updatedAt DateTime         @default(now())

  worker Worker @relation(fields: [workerId], references: [id])
  site   Site   @relation(fields: [siteId], references: [id])

  @@id([workerId, siteId])
}

// -----------------------------------------------------
// EQUIPMENT TRAINING REQUIREMENTS
// -----------------------------------------------------
model EquipmentTrainingRequirement {
  id              Int @id @default(autoincrement())
  equipmentId     Int
  certificationId Int

  equipment     Equipment     @relation(fields: [equipmentId], references: [id])
  certification Certification @relation(fields: [certificationId], references: [id])

  @@unique([equipmentId, certificationId])
}

// -----------------------------------------------------
// DIGITAL SIGNOFF
// -----------------------------------------------------
model DigitalSignoff {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  workerId     Int?
  equipmentId  Int?
  supervisorId Int?
  siteId       Int?

  checklist           Json
  workerSignature     String?
  supervisorSignature String
  notes               String?

  worker     Worker?    @relation("WorkerSignoff", fields: [workerId], references: [id])
  equipment  Equipment? @relation("EquipmentSignoff", fields: [equipmentId], references: [id])
  supervisor User?      @relation("SupervisorSignoff", fields: [supervisorId], references: [id])
  site       Site?      @relation(fields: [siteId], references: [id])

  @@index([siteId, createdAt], map: "idx_digital_signoff_site_created")
  @@index([workerId, createdAt], map: "idx_digital_signoff_worker_created")
}

// -----------------------------------------------------
// INSPECTIONS
// -----------------------------------------------------
model InspectionChecklist {
  id             Int                         @id @default(autoincrement())
  seedKey        String?                     @unique @map("seed_key")
  name           String
  category       InspectionChecklistCategory
  inspectionType InspectionType
  /// Array of `{ id, label, required? }` line items.
  items          Json
  /// Default days until next inspection after a pass (null = use type default).
  intervalDays   Int?
  intervalHours  Int?
  active         Boolean                     @default(true)
  seedVersion    Int                         @default(1) @map("seed_version")
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  inspections Inspection[]

  @@index([inspectionType, active])
  @@index([category, active])
}

model Inspection {
  id           Int      @id @default(autoincrement())
  workerId     Int?
  equipmentId  Int?
  siteId       Int?
  supervisorId Int?
  checklistId  Int?
  status       String   @default("PENDING")
  notes        String?
  createdAt    DateTime @default(now())

  kind               InspectionKind @default(PRE_USE)
  inspectionType     InspectionType @default(PRE_USE)
  /// Checklist answers: `{ itemId: boolean | string | { passed, notes? } }`.
  checklist          Json?
  passed             Boolean?
  completedAt        DateTime?
  signature          String?
  meterReading       Float?
  photos             Json?
  correctiveActions  String?        @db.Text
  lockoutTriggered   Boolean        @default(false)
  nextInspectionDate DateTime?

  worker            Worker?                       @relation(fields: [workerId], references: [id])
  equipment         Equipment?                    @relation(fields: [equipmentId], references: [id])
  site              Site?                         @relation(fields: [siteId], references: [id])
  supervisor        User?                         @relation(fields: [supervisorId], references: [id])
  checklistTemplate InspectionChecklist?          @relation(fields: [checklistId], references: [id], onDelete: SetNull)
  cailLinks         EquipmentInspectionCailLink[]

  @@index([siteId, status], map: "idx_inspection_site_status")
  @@index([equipmentId], map: "idx_inspection_equipment")
  @@index([workerId], map: "idx_inspection_worker")
  @@index([equipmentId, kind, createdAt])
  @@index([equipmentId, inspectionType, completedAt])
  @@index([nextInspectionDate])
  @@index([passed, lockoutTriggered])
}

/// Pre-use / formal checklist definitions keyed by `catalogTypeKey` (seeded from Vera Core templates).
model InspectionTemplate {
  id              Int                      @id @default(autoincrement())
  catalogTypeKey  String
  catalogCategory EquipmentCatalogCategory
  kind            InspectionKind
  /// Array of `{ id, label }` checklist line items.
  items           Json
  seedVersion     Int                      @default(1) @map("seed_version")
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@unique([catalogTypeKey, kind])
  @@index([catalogCategory, kind])
}

/// Practical evaluation for a worker on a specific equipment asset (Vera Core competency).
model CompetencyEvaluation {
  id                 Int       @id @default(autoincrement())
  workerId           Int
  equipmentId        Int
  evaluatorUserId    Int?
  /// Denormalized catalog key copy for reporting when asset is retyped.
  equipmentTypeKey   String
  score              Int
  passed             Boolean
  /// When the practical evaluation was performed (may differ from createdAt).
  evaluationDate     DateTime  @default(now())
  /// Null = no expiry; after this date competency is invalid until re-evaluated.
  expiresAt          DateTime?
  notes              String?   @db.Text
  evidenceNotes      String?   @db.Text
  /// JSON array of photo URLs or document ids.
  evidencePhotos     Json?
  workerSignature    String?
  evaluatorSignature String?
  createdAt          DateTime  @default(now())

  worker    Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  evaluator User?     @relation("CompetencyEvaluator", fields: [evaluatorUserId], references: [id], onDelete: SetNull)

  @@index([workerId, equipmentId, evaluationDate])
  @@index([equipmentId, evaluationDate])
  @@index([workerId, expiresAt])
  @@index([expiresAt])
}

/// Minimum score / optional linked certification for competency gate on an equipment record.
model EquipmentCompetencyRequirement {
  id                Int     @id @default(autoincrement())
  equipmentId       Int     @unique
  minPassingScore   Int     @default(70)
  expiryDays        Int?
  requireEvaluation Boolean @default(true)
  certificationId   Int?

  equipment     Equipment      @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  certification Certification? @relation(fields: [certificationId], references: [id], onDelete: SetNull)
}

/// Default competency rules for an equipment type (applies to all assets of that type).
model EquipmentTypeCompetencyRequirement {
  id                Int     @id @default(autoincrement())
  equipmentTypeId   Int     @unique
  minPassingScore   Int     @default(70)
  expiryDays        Int?
  requireEvaluation Boolean @default(true)
  certificationId   Int?

  equipmentType EquipmentType  @relation(fields: [equipmentTypeId], references: [id], onDelete: Cascade)
  certification Certification? @relation("TypeCompetencyCert", fields: [certificationId], references: [id], onDelete: SetNull)
}

/// Explicit “authorized for this equipment type / asset” rows shown in the worker wallet.
model WorkerWalletItem {
  id               Int      @id @default(autoincrement())
  workerId         Int
  catalogTypeKey   String
  equipmentId      Int?
  companyId        Int?
  trainingRecordId Int?     @unique
  status           String   @default("ACTIVE")
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  worker         Worker          @relation(fields: [workerId], references: [id], onDelete: Cascade)
  equipment      Equipment?      @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  company        Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  trainingRecord TrainingRecord? @relation(fields: [trainingRecordId], references: [id], onDelete: SetNull)

  @@index([workerId, status])
  @@index([companyId, catalogTypeKey])
  @@index([trainingRecordId])
}

/// Denormalized audit row for company equipment dashboards / CSV export (upserted by services).
model CompanyEquipmentAuditView {
  id                       Int       @id @default(autoincrement())
  companyId                Int
  equipmentId              Int
  lastPreUseAt             DateTime?
  lastFormalAt             DateTime?
  preUseCompliant7d        Boolean   @default(false)
  formalCompliant          Boolean   @default(false)
  trainingOperatorsOk      Int       @default(0)
  trainingOperatorsTotal   Int       @default(0)
  competencyOperatorsOk    Int       @default(0)
  competencyOperatorsTotal Int       @default(0)
  updatedAt                DateTime  @updatedAt

  company   Company   @relation("CompanyEquipmentAudit", fields: [companyId], references: [id], onDelete: Cascade)
  equipment Equipment @relation("EquipmentAuditRow", fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([companyId, equipmentId])
}

// -----------------------------------------------------
// INVESTIGATIONS (UPDATED WITH STATUS)
// -----------------------------------------------------
model Investigation {
  id             Int      @id @default(autoincrement())
  incidentId     Int
  investigatorId Int?
  findings       String?
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())

  incident     Incident @relation(fields: [incidentId], references: [id])
  investigator User?    @relation("InvestigatorIncidents", fields: [investigatorId], references: [id])

  @@index([incidentId], map: "idx_investigation_incident")
}

// -----------------------------------------------------
// VERA CORE — GENERIC FILE UPLOAD METADATA
// -----------------------------------------------------
enum CoreUploadStorage {
  LOCAL
  S3
  DIRECT_S3
}

enum CoreUploadStatus {
  PENDING
  COMPLETED
  FAILED
}

model CoreFile {
  id           Int               @id @default(autoincrement())
  storage      CoreUploadStorage
  status       CoreUploadStatus  @default(COMPLETED)
  bucket       String?
  objectKey    String            @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  /// Public URL when completed; null while DIRECT_S3 upload is in progress
  publicUrl    String?
  /// Canonical purpose tag (e.g. training_ingestion, document_storage)
  purpose      String?
  failedReason String?
  createdAt    DateTime          @default(now())
  completedAt  DateTime?
  userId       Int?
  /// Tenant ownership for Document Storage library scoping
  companyId    Int?
  /// Optional project link (Document Storage linked_project_id)
  projectId    Int?

  user                   User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  company                Company?                @relation(fields: [companyId], references: [id], onDelete: SetNull)
  project                Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  trainingIngestionRuns  TrainingIngestionRun[]
  pmInspectionSignatures PmInspectionSignature[]
  dailyLogAttachments    CoreDailyLogAttachment[]

  @@index([createdAt])
  @@index([userId])
  @@index([companyId])
  @@index([projectId])
  @@index([purpose])
  @@index([status])
  @@index([status, createdAt], map: "idx_core_file_status_created")
  @@index([userId, createdAt], map: "idx_core_file_user_created")
  @@index([companyId, createdAt], map: "idx_core_file_company_created")
  @@index([companyId, purpose, createdAt], map: "idx_core_file_company_purpose_created")
  @@index([projectId, createdAt], map: "idx_core_file_project_created")
}

// -----------------------------------------------------
// DOCUMENTS
// -----------------------------------------------------
model Document {
  id          Int      @id @default(autoincrement())
  type        String
  name        String
  url         String
  description String?
  workerId    Int?
  equipmentId Int?
  companyId   Int?
  tags        String[]
  version     Int      @default(1)
  deleted     Boolean  @default(false)
  createdAt   DateTime @default(now())

  worker    Worker?    @relation(fields: [workerId], references: [id])
  equipment Equipment? @relation(fields: [equipmentId], references: [id])
  company   Company?   @relation(fields: [companyId], references: [id])

  @@index([workerId, createdAt])
  @@index([equipmentId, createdAt])
  @@index([companyId, createdAt])
  @@index([type, deleted, createdAt])
}

// -----------------------------------------------------
// CHAT SYSTEM
// -----------------------------------------------------
model ChatRoom {
  id        Int      @id @default(autoincrement())
  name      String?
  type      String
  createdAt DateTime @default(now())

  messages         ChatMessage[]
  members          ChatMember[]
  channel          ChatChannel?
  moderationEvents ChatModerationEvent[]
  jobApplication   JobBoardApplication?
}

model ChatMember {
  id       Int      @id @default(autoincrement())
  roomId   Int
  userId   Int
  joinedAt DateTime @default(now())

  room ChatRoom @relation(fields: [roomId], references: [id])
  user User     @relation(fields: [userId], references: [id])

  @@unique([roomId, userId], map: "ChatMember_roomId_userId_key")
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  roomId    Int
  senderId  Int
  content   String
  createdAt DateTime @default(now())
  readBy    Json?

  room   ChatRoom @relation(fields: [roomId], references: [id])
  sender User     @relation(fields: [senderId], references: [id])

  files         ChatFile[]
  reactions     ChatReaction[]
  threadParent  ChatThread[]   @relation("ThreadParent")
  threadReplies ChatThread[]   @relation("ThreadMessage")

  @@index([roomId, createdAt], map: "idx_chat_message_room_created")
}

model ChatFile {
  id        Int      @id @default(autoincrement())
  messageId Int
  url       String
  type      String
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id])
}

model ChatChannel {
  id     Int    @id @default(autoincrement())
  name   String
  slug   String @unique
  roomId Int?   @unique

  room ChatRoom? @relation(fields: [roomId], references: [id])
}

model ChatModerationEvent {
  id        Int      @id @default(autoincrement())
  roomId    Int
  userId    Int
  action    String
  reason    String?
  createdAt DateTime @default(now())

  room ChatRoom @relation(fields: [roomId], references: [id])
  user User     @relation(fields: [userId], references: [id])
}

model ChatReaction {
  id        Int      @id @default(autoincrement())
  messageId Int
  userId    Int
  emoji     String
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id])
  user    User        @relation(fields: [userId], references: [id])
}

model ChatThread {
  id        Int      @id @default(autoincrement())
  parentId  Int?
  messageId Int
  createdAt DateTime @default(now())

  parent  ChatMessage? @relation("ThreadParent", fields: [parentId], references: [id])
  message ChatMessage  @relation("ThreadMessage", fields: [messageId], references: [id])
}

// -----------------------------------------------------
// NOTIFICATIONS
// -----------------------------------------------------
model Notification {
  id           Int                 @id @default(autoincrement())
  userId       Int?
  channel      NotificationChannel @default(IN_APP)
  type         String
  title        String?
  body         String?
  payload      Json
  status       NotificationStatus  @default(PENDING)
  readAt       DateTime?
  dedupeKey    String?
  scheduledFor DateTime?
  sentAt       DateTime?
  createdAt    DateTime            @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dedupeKey], map: "notification_dedupe_key")
  @@index([userId, createdAt], map: "idx_notification_user_created")
  @@index([userId, readAt], map: "idx_notification_user_read")
}

model UserNotificationPreference {
  userId           Int     @id
  emailEnabled     Boolean @default(true)
  smsEnabled       Boolean @default(false)
  pushEnabled      Boolean @default(true)
  inAppEnabled     Boolean @default(true)
  inspectionDue    Boolean @default(true)
  competencyExpiry Boolean @default(true)
  ppeExpiry        Boolean @default(true)
  maintenanceDue   Boolean @default(true)
  calibrationDue   Boolean @default(true)
  assignmentAlerts Boolean @default(true)
  quietHoursStart  String?
  quietHoursEnd    String?
  phone            String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------
// AUDIT LOG
// -----------------------------------------------------
model AuditLog {
  id           Int      @id @default(autoincrement())
  actorId      Int?     @map("userId")
  tenantId     Int?
  action       String
  entityType   String?  @map("entity")
  entityId     String?
  metadataJson Json?    @map("metadata")
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt], map: "idx_audit_log_user_created")
  @@index([tenantId, createdAt], map: "idx_audit_log_tenant_created")
  @@index([entityType, entityId], map: "idx_audit_log_entity")
}

// -----------------------------------------------------
// VERA CORE — actionable follow-ups (UUID PK)
// Rename model / fields to match your [NAME] / [FIELDS] template.
// -----------------------------------------------------
model CoreActionItem {
  id          String    @id @default(uuid())
  title       String
  description String?
  status      String    @default("OPEN")
  dueAt       DateTime?
  priority    String    @default("NORMAL")

  companyId           Int?
  createdById         Int?
  coreMeetingRecordId Int?
  coreDailyLogId      Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company           Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdBy         User?              @relation("CoreActionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  coreMeetingRecord CoreMeetingRecord? @relation(fields: [coreMeetingRecordId], references: [id], onDelete: SetNull)
  coreDailyLog      CoreDailyLog?      @relation(fields: [coreDailyLogId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([status])
  @@index([dueAt])
  @@index([createdById])
  @@index([createdAt])
  @@index([coreMeetingRecordId])
  @@index([coreDailyLogId])
  @@index([companyId, status, dueAt], map: "idx_core_action_item_company_status_due")
}

// -----------------------------------------------------
// TRAINING MATRIX EXAMPLE
// -----------------------------------------------------
model Example {
  id    Int     @id @default(autoincrement())
  name  String
  value String?
}

// -----------------------------------------------------
// VERA CORE — GLOBAL REGISTRY & COMPANY/PROJECT LINKS
// -----------------------------------------------------

/// Worker ↔ Company employment link (per-company active state).
model CompanyLink {
  id              Int       @id @default(autoincrement())
  workerId        Int
  companyId       Int
  active          Boolean   @default(true)
  startDate       DateTime  @default(now())
  endDate         DateTime?
  role            String?
  trade           String?
  visibilityRules Json?

  worker  Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, active], map: "idx_company_link_company_active")
  @@index([workerId, active], map: "idx_company_link_worker_active")
  @@index([workerId, companyId], map: "idx_company_link_worker_company")
}

/// Equipment ↔ Company fleet link (per-company active state).
model EquipmentLink {
  id               Int                  @id @default(autoincrement())
  equipmentId      Int
  companyId        Int
  active           Boolean              @default(true)
  startDate        DateTime             @default(now())
  endDate          DateTime?
  complianceStatus LinkComplianceStatus @default(COMPLIANT)

  equipment       Equipment             @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  company         Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedWorkers EquipmentLinkWorker[]

  @@index([companyId, active], map: "idx_equipment_link_company_active")
  @@index([equipmentId, active], map: "idx_equipment_link_equipment_active")
}

/// Workers assigned to equipment under a company link.
model EquipmentLinkWorker {
  equipmentLinkId Int
  workerId        Int
  assignedAt      DateTime @default(now())

  equipmentLink EquipmentLink @relation(fields: [equipmentLinkId], references: [id], onDelete: Cascade)
  worker        Worker        @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@id([equipmentLinkId, workerId])
}

/// Job / project under a company (distinct from physical Site).
model Project {
  id        Int           @id @default(autoincrement())
  companyId Int
  siteId    Int?
  name      String
  code      String?
  client    String?
  status    ProjectStatus @default(ACTIVE)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime      @default(now())

  company                         Company                          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site                            Site?                            @relation(fields: [siteId], references: [id], onDelete: SetNull)
  workerAssignments               ProjectAssignment[]
  equipmentAssignments            EquipmentProjectAssignment[]
  toolAssignments                 ToolAssignment[]
  ppeAssignments                  PPEAssignment[]
  trainingRecords                 TrainingRecord[]
  hubFeedItems                    FeedItem[]
  expertQaQuestions               ExpertQaQuestion[]
  jobPosts                        JobPost[]
  safetyForms                     SafetyForm[]
  cailEntries                     CailEntry[]
  safetyInspections               SafetyInspection[]
  bboObservations                 BboObservation[]
  ppePreUseInspections            PpePreUseInspection[]
  vsiIncidentInvestigations       VsiIncidentInvestigation[]
  lessonsLearned                  LessonsLearnedEntry[]
  projectSafetyRoles              ProjectSafetyRole[]
  safetyRiskSnapshots             ProjectSafetyRiskSnapshot[]
  siteAccessRules                 SiteAccessRule[]
  siteAccessGrants                SiteAccessGrant[]
  musterEvents                    MusterEvent[]
  safetyPlan                      ProjectSafetyPlan?
  jhaFlhaRecords                  JhaFlha[]
  jhaTaskLibrary                  JhaTaskLibraryEntry[]
  hazardLibrary                   HazardLibraryEntry[]
  controlLibrary                  ControlLibraryEntry[]
  sifIndicators                   SifIndicatorLibrary[]
  hecaCategories                  HecaCategoryLibrary[]
  sifHecaEvents                   SifHecaEvent[]
  hecaCsraAssessments             HecaCsraAssessment[]
  pmInspectionTemplates           PmInspectionTemplate[]
  pmInspections                   PmInspection[]
  pmSafetyEvents                  PmSafetyEvent[]
  veraAssessmentRuns              VeraAssessmentRun[]
  pmSubstanceTestEvents           PmSubstanceTestEvent[]
  pmSubstanceTestPools            PmSubstanceTestPool[]
  pmPredictiveSafetyForecasts     PmPredictiveSafetyForecast[]
  contractorPortalMemberships     PmContractorPortalMembership[]
  pmSafetyHubSnapshots            PmSafetyHubSnapshot[]
  pmSafetyEvidenceIndex           PmSafetyEvidenceIndex[]
  pmSafetyHubEventLogs            PmSafetyHubEventLog[]
  pmSmsRiskContexts               PmSmsRiskContext[]
  pmSmsHecaLibrary                PmSmsHecaLibraryEntry[]
  pmSmsWeeklyForecasts            PmSmsWeeklyRiskForecast[]
  pmSafetyEventTypeLibrary        PmSafetyEventTypeLibrary[]
  pmCorrectiveActions             PmCorrectiveAction[]
  topicLibraryCategories          TopicLibraryCategory[]
  topicLibraryEntries             TopicLibraryEntry[]
  safetyMeetingTemplates          SafetyMeetingTemplate[]
  safetyMeetings                  SafetyMeeting[]
  siteAccessMeetingRequirements   SiteAccessMeetingRequirement[]
  sdsDocuments                    SdsDocument[]
  policyDocuments                 PolicyDocument[]
  chemicalInventory               ChemicalInventoryItem[]
  pmControlledDocuments           PmControlledDocument[]
  emergencyPlans                  EmergencyPlan[]
  pmEmergencyEvents               PmEmergencyEvent[]
  pmSiteEmergencyLocks            PmSiteEmergencyLock[]
  pmAccessPoints                  PmAccessPoint[]
  pmAccessAttempts                PmAccessAttempt[]
  pmAccessOverrides               PmAccessOverride[]
  safetyStations                  SafetyStation[]
  pmProjectSafetyProfile          PmProjectSafetyProfile?
  pmProjectHazards                PmProjectHazard[]
  pmProjectControls               PmProjectControl[]
  pmProjectSafetyOverrides        PmProjectSafetyOverride[]
  pmProjectSafetyOfflineCaches    PmProjectSafetyOfflineCache[]
  pmProjectConfig                 PmProjectConfig?
  pmWorkPackages                  PmWorkPackage[]
  pmPmTasks                       PmPmTask[]
  pmProjectSchedules              PmProjectSchedule[]
  pmPmWorkerAssignments           PmPmWorkerAssignment[]
  pmPmEquipmentAssignments        PmPmEquipmentAssignment[]
  pmPermits                       PmPermit[]
  veripmPermits                   VeripmPermit[]
  coreFiles                       CoreFile[]
  pmPmAttachments                 PmPmAttachment[]
  pmProjectOfflineCaches          PmProjectOfflineCache[]
  pmUnifiedHazards                PmUnifiedHazard[]
  pmUnifiedControls               PmUnifiedControl[]
  pmUnifiedHcOfflineCaches        PmUnifiedHcOfflineCache[]
  pmCorrectiveActionOfflineCaches PmCorrectiveActionOfflineCache[]
  cailPredictions                 CailPrediction[]
  cailScores                      CailScore[]
  cailRecommendations             CailRecommendation[]
  cailCorrelations                CailCorrelation[]
  cailExplainabilityRecords       CailExplainability[]
  cailInferenceLogs               CailInferenceLog[]
  cailOfflineCaches               CailOfflineCache[]
  cailTrainingData                CailTrainingData[]
  pmOfflineCaches                 PmOfflineCache[]
  orientationPackages             OrientationPackage[]
  orientationRequirements         OrientationRequirement[]
  orientationCompletions          OrientationCompletion[]
  complianceRules                 ProjectComplianceRule[]
  complianceAlerts                ProjectComplianceAlert[]
  safetyFormTemplates             SafetyFormTemplate[]

  @@index([companyId, status], map: "idx_project_company_status")
  @@index([siteId], map: "idx_project_site")
}

/// Worker ↔ Project assignment.
model ProjectAssignment {
  id         Int              @id @default(autoincrement())
  workerId   Int
  projectId  Int
  companyId  Int
  assignedBy Int?
  assignedAt DateTime         @default(now())
  status     AssignmentStatus @default(ACTIVE)
  role       String?
  endedAt    DateTime?

  worker         Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company        Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedByUser User?   @relation("ProjectAssignmentAssigner", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@index([projectId, status], map: "idx_project_assignment_project_status")
  @@index([projectId, status, endedAt], map: "idx_project_assignment_project_status_ended")
  @@index([workerId, status], map: "idx_project_assignment_worker_status")
  @@index([companyId], map: "idx_project_assignment_company")
}

/// Equipment ↔ Project assignment.
model EquipmentProjectAssignment {
  id          Int              @id @default(autoincrement())
  equipmentId Int
  projectId   Int
  companyId   Int
  assignedBy  Int?
  assignedAt  DateTime         @default(now())
  status      AssignmentStatus @default(ACTIVE)
  endedAt     DateTime?

  equipment      Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedByUser User?     @relation("EquipmentProjectAssignmentAssigner", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@index([projectId, status], map: "idx_equipment_project_assignment_project_status")
  @@index([equipmentId, status], map: "idx_equipment_project_assignment_equipment_status")
}

// -----------------------------------------------------
// UNION HALL
// -----------------------------------------------------
model UnionHall {
  id          Int      @id @default(autoincrement())
  name        String
  localNumber String?
  region      String?
  createdAt   DateTime @default(now())

  memberships      UnionMembership[]
  dispatches       UnionDispatch[]
  users            User[]                     @relation("UnionHallUsers")
  providerLinks    UnionHallProviderLink[]
  trainingReceipts UnionHallTrainingReceipt[]
  hubFeedItems     FeedItem[]
}

model UnionMembership {
  id           Int                   @id @default(autoincrement())
  unionHallId  Int
  workerId     Int
  memberNumber String?
  status       UnionMembershipStatus @default(ACTIVE)
  joinedAt     DateTime              @default(now())
  endedAt      DateTime?

  unionHall UnionHall @relation(fields: [unionHallId], references: [id], onDelete: Cascade)
  worker    Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([unionHallId, workerId], map: "union_membership_hall_worker")
  @@index([workerId, status], map: "idx_union_membership_worker_status")
}

model UnionDispatch {
  id           Int       @id @default(autoincrement())
  unionHallId  Int
  workerId     Int
  companyId    Int
  dispatchedBy Int?
  dispatchedAt DateTime  @default(now())
  notes        String?
  recalledAt   DateTime?

  unionHall        UnionHall @relation(fields: [unionHallId], references: [id], onDelete: Cascade)
  worker           Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dispatchedByUser User?     @relation("UnionDispatchBy", fields: [dispatchedBy], references: [id], onDelete: SetNull)

  @@index([unionHallId, dispatchedAt], map: "idx_union_dispatch_hall_date")
  @@index([workerId], map: "idx_union_dispatch_worker")
}

/// Approved training providers for a union hall.
model UnionHallProviderLink {
  id                 Int      @id @default(autoincrement())
  unionHallId        Int
  trainingProviderId Int
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())

  unionHall        UnionHall        @relation(fields: [unionHallId], references: [id], onDelete: Cascade)
  trainingProvider TrainingProvider @relation(fields: [trainingProviderId], references: [id], onDelete: Cascade)

  @@unique([unionHallId, trainingProviderId], map: "union_hall_provider_unique")
  @@index([unionHallId, active])
}

/// Union hall workflow for provider-issued training (accept → validate → push).
model UnionHallTrainingReceipt {
  id               Int                     @id @default(autoincrement())
  unionHallId      Int
  trainingRecordId Int
  status           UnionHallTrainingStatus @default(PENDING)
  acceptedAt       DateTime?
  acceptedByUserId Int?
  validatedAt      DateTime?
  pushedAt         DateTime?
  pushedCompanyId  Int?
  pushedProjectId  Int?
  notes            String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  unionHall      UnionHall      @relation(fields: [unionHallId], references: [id], onDelete: Cascade)
  trainingRecord TrainingRecord @relation(fields: [trainingRecordId], references: [id], onDelete: Cascade)
  acceptedBy     User?          @relation("UnionHallTrainingAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@unique([unionHallId, trainingRecordId], map: "union_hall_training_receipt_unique")
  @@index([unionHallId, status])
  @@index([unionHallId, createdAt])
  @@index([trainingRecordId])
}

// -----------------------------------------------------
// REGISTRY MERGE AUDIT
// -----------------------------------------------------
model WorkerMergeRecord {
  id               Int      @id @default(autoincrement())
  survivorWorkerId Int
  mergedWorkerId   Int
  mergedByUserId   Int?
  reason           String?
  createdAt        DateTime @default(now())

  survivor Worker @relation("WorkerMergeSurvivor", fields: [survivorWorkerId], references: [id], onDelete: Cascade)
  merged   Worker @relation("WorkerMergeMerged", fields: [mergedWorkerId], references: [id], onDelete: Cascade)
}

model EquipmentMergeRecord {
  id                  Int      @id @default(autoincrement())
  survivorEquipmentId Int
  mergedEquipmentId   Int
  mergedByUserId      Int?
  reason              String?
  createdAt           DateTime @default(now())

  survivor Equipment @relation("EquipmentMergeSurvivor", fields: [survivorEquipmentId], references: [id], onDelete: Cascade)
  merged   Equipment @relation("EquipmentMergeMerged", fields: [mergedEquipmentId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------
// TOOLS & PPE
// -----------------------------------------------------
model Tool {
  id                     Int        @id @default(autoincrement())
  companyId              Int
  name                   String
  serialNumber           String?
  assetTag               String?
  category               String?
  status                 ToolStatus @default(ACTIVE)
  inspectionIntervalDays Int        @default(90)
  lastInspectionAt       DateTime?
  nextInspectionAt       DateTime?
  qrToken                String?    @unique
  notes                  String?    @db.Text
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inspections ToolInspection[]
  assignments ToolAssignment[]

  @@index([companyId, status])
  @@index([nextInspectionAt])
}

model PPE {
  id           Int       @id @default(autoincrement())
  companyId    Int
  name         String
  ppeType      PpeType   @default(OTHER)
  serialNumber String?
  status       PpeStatus @default(ACTIVE)
  issuedAt     DateTime  @default(now())
  expiresAt    DateTime
  condition    String?
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inspections PPEInspection[]
  assignments PPEAssignment[]

  @@index([companyId, status])
  @@index([expiresAt])
  @@index([ppeType])
}

model ToolInspection {
  id                 Int       @id @default(autoincrement())
  toolId             Int
  inspectorUserId    Int?
  workerId           Int?
  passed             Boolean
  checklist          Json?
  notes              String?   @db.Text
  completedAt        DateTime  @default(now())
  nextInspectionDate DateTime?
  createdAt          DateTime  @default(now())

  tool      Tool    @relation(fields: [toolId], references: [id], onDelete: Cascade)
  inspector User?   @relation(fields: [inspectorUserId], references: [id], onDelete: SetNull)
  worker    Worker? @relation(fields: [workerId], references: [id], onDelete: SetNull)

  @@index([toolId, completedAt])
}

model PPEInspection {
  id                Int       @id @default(autoincrement())
  ppeId             Int
  inspectorUserId   Int?
  workerId          Int?
  passed            Boolean
  checklist         Json?
  notes             String?   @db.Text
  completedAt       DateTime  @default(now())
  extendedExpiresAt DateTime?
  createdAt         DateTime  @default(now())

  ppe       PPE     @relation(fields: [ppeId], references: [id], onDelete: Cascade)
  inspector User?   @relation(fields: [inspectorUserId], references: [id], onDelete: SetNull)
  worker    Worker? @relation(fields: [workerId], references: [id], onDelete: SetNull)

  @@index([ppeId, completedAt])
}

model ToolAssignment {
  id         Int                      @id @default(autoincrement())
  toolId     Int
  workerId   Int?
  projectId  Int?
  companyId  Int
  status     ToolsPpeAssignmentStatus @default(ACTIVE)
  assignedBy Int?
  assignedAt DateTime                 @default(now())
  returnedAt DateTime?

  tool           Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  worker         Worker?  @relation(fields: [workerId], references: [id], onDelete: SetNull)
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedByUser User?    @relation("ToolAssignmentAssigner", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@index([toolId, status])
  @@index([workerId, status])
  @@index([projectId, status])
}

model PPEAssignment {
  id         Int                      @id @default(autoincrement())
  ppeId      Int
  workerId   Int
  projectId  Int?
  companyId  Int
  status     ToolsPpeAssignmentStatus @default(ACTIVE)
  assignedBy Int?
  assignedAt DateTime                 @default(now())
  returnedAt DateTime?

  ppe            PPE      @relation(fields: [ppeId], references: [id], onDelete: Cascade)
  worker         Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedByUser User?    @relation("PPEAssignmentAssigner", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@index([ppeId, status])
  @@index([workerId, status])
  @@index([projectId, status])
}

// -----------------------------------------------------
// VERA HUB HOMEPAGE
// -----------------------------------------------------

enum FeedSource {
  VERA_CORE_TRAINING
  TRAINING_EXPIRY
  VERA_CORE_PROJECT
  VERA_CORE_EQUIPMENT
  JOB_BOARD
  SAFETY_BLOG
  COMPANY_ANNOUNCEMENT
  WORKER_ACHIEVEMENT
  WORKER_VERIFICATION
  EXPERT_ANSWER
  UNION_DISPATCH
  SYSTEM
  SOCIAL_POST
}

enum SocialPostType {
  PROVIDER_POST
  COMPANY_ANNOUNCEMENT
  SAFETY_BULLETIN
  JOB_POSTING
  WORKER_MILESTONE
  TRAINING_UPLOAD
  SYSTEM_UPDATE
}

enum SocialPostVisibility {
  PUBLIC
  COMPANY
  FOLLOWERS
}

enum SocialFollowTargetType {
  COMPANY
  PROVIDER
  USER
}

enum FeedInteractionType {
  LIKE
  COMMENT
  SHARE
}

enum FeedSubscriptionTargetType {
  SOURCE
  COMPANY
  PROJECT
  TRADE
  EXPERT
  USER
}

enum SocialActivityVerb {
  LIKE
  UNLIKE
  COMMENT
  SHARE
  FOLLOW
  UNFOLLOW
  SUBSCRIBE
}

enum SocialActivityTargetType {
  FEED_ITEM
  USER
  FEED_SOURCE
  COMPANY
  PROJECT
  TRADE
  EXPERT
}

enum WeatherAlertSeverity {
  INFO
  WATCH
  WARNING
  EMERGENCY
}

enum HubHomepageRole {
  WORKER
  SUPERVISOR
  COMPANY_ADMIN
  UNION_HALL
}

model FeedItem {
  id             String     @id @default(uuid())
  source         FeedSource
  externalId     String?
  title          String
  summary        String?    @db.Text
  body           String?    @db.Text
  imageUrl       String?
  url            String?
  publishedAt    DateTime   @default(now())
  companyId      Int?
  unionHallId    Int?
  workerId       Int?
  projectId      Int?
  trade          String?
  safetyPriority Int        @default(0)
  metadata       Json?
  rankScore      Float      @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  company      Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  unionHall    UnionHall?        @relation(fields: [unionHallId], references: [id], onDelete: SetNull)
  worker       Worker?           @relation(fields: [workerId], references: [id], onDelete: SetNull)
  project      Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  interactions FeedInteraction[]

  @@unique([source, externalId])
  @@index([publishedAt(sort: Desc)])
  @@index([companyId, publishedAt(sort: Desc)])
  @@index([unionHallId, publishedAt(sort: Desc)])
  @@index([source, publishedAt(sort: Desc)])
  @@index([projectId, publishedAt(sort: Desc)])
}

model FeedInteraction {
  id         String              @id @default(uuid())
  feedItemId String
  userId     Int
  type       FeedInteractionType
  body       String?             @db.Text
  parentId   String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  feedItem FeedItem          @relation(fields: [feedItemId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   FeedInteraction?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: SetNull)
  replies  FeedInteraction[] @relation("CommentThread")

  @@index([feedItemId, type])
  @@index([userId, createdAt(sort: Desc)])
  @@index([parentId])
}

model SocialUserFollow {
  id          String   @id @default(uuid())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())

  follower  User @relation("SocialFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("SocialFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model SocialActivityLog {
  id          String                   @id @default(uuid())
  actorUserId Int
  verb        SocialActivityVerb
  targetType  SocialActivityTargetType
  targetId    String
  summary     String?
  feedItemId  String?
  metadata    Json?
  createdAt   DateTime                 @default(now())

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([feedItemId])
}

model FeedSubscription {
  id         String                     @id @default(uuid())
  userId     Int
  targetType FeedSubscriptionTargetType
  targetKey  String
  createdAt  DateTime                   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetKey])
  @@index([userId])
}

/// User-authored and system social posts (Verus Social Homepage).
model SocialPost {
  id                 String               @id @default(uuid())
  authorUserId       Int
  postType           SocialPostType       @default(PROVIDER_POST)
  title              String?
  body               String               @db.Text
  companyId          Int?
  trainingProviderId Int?
  workerId           Int?
  visibility         SocialPostVisibility @default(PUBLIC)
  shareCount         Int                  @default(0)
  publishedAt        DateTime             @default(now())
  deletedAt          DateTime?
  metadata           Json?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  author           User                 @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  company          Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  trainingProvider TrainingProvider?    @relation(fields: [trainingProviderId], references: [id], onDelete: SetNull)
  worker           Worker?              @relation(fields: [workerId], references: [id], onDelete: SetNull)
  likes            PostLike[]
  comments         PostComment[]
  media            MediaAttachment[]
  moderationFlags  PostModerationFlag[]
  trendingMetric   PostTrendingMetric?
  pinnedEntry      PinnedPost?
  savedBy          SavedPost[]

  @@index([publishedAt(sort: Desc)])
  @@index([authorUserId, publishedAt(sort: Desc)])
  @@index([companyId, publishedAt(sort: Desc)])
  @@index([trainingProviderId, publishedAt(sort: Desc)])
  @@index([postType, publishedAt(sort: Desc)])
  @@map("posts")
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  userId    Int
  createdAt DateTime @default(now())

  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@map("post_likes")
}

model PostComment {
  id        String    @id @default(uuid())
  postId    String
  userId    Int
  parentId  String?
  body      String    @db.Text
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

