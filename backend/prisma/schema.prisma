  @@unique([musterEventId, workerId])
  @@index([musterEventId])
  @@map("muster_attendance")
}

model SafetyStationHeartbeat {
  id               String   @id @default(uuid())
  stationId        Int
  payload          Json?
  batteryLevel     Float?
  storageFreeMb    Float?
  sensorHealthJson Json     @default("{}")
  firmwareVersion  String?
  alertsJson       Json     @default("[]")
  online           Boolean  @default(true)
  createdAt        DateTime @default(now())

  station SafetyStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId, createdAt])
  @@map("safety_station_heartbeat")
}

// -----------------------------------------------------
// JHA / FLHA — dedicated job hazard analysis system
// -----------------------------------------------------

enum JhaFlhaKind {
  FLHA
  JHA
}

enum JhaFlhaStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  LOCKED
  REJECTED
}

enum JhaEnergyType {
  mechanical
  electrical
  chemical
  thermal
  radiation
  biological
  gravity
  pressure
  motion
}

enum JhaFlhaSignatureRole {
  WORKER
  SUPERVISOR
  AUTHORIZER
}

model JhaFlha {
  id                       String        @id @default(uuid())
  kind                     JhaFlhaKind   @default(FLHA)
  status                   JhaFlhaStatus @default(DRAFT)
  companyId                Int
  projectId                Int
  siteId                   Int?
  workPackageId            String?
  taskId                   String?       @unique
  taskLibraryId            String?
  taskDescription          String        @db.Text
  workScope                String?       @db.Text
  locationNote             String?       @db.VarChar(500)
  environmentalJson        Json          @default("{}")
  sifPotential             Boolean       @default(false)
  sifScore                 Int           @default(0)
  hecaCategoryKey          String?
  highEnergyFlag           Boolean       @default(false)
  qualityScore             Int?
  riskScore                Int?
  taskRiskScore            Int?
  aiAnalysis               Json?
  requiresSupervisorReview Boolean       @default(false)
  controlsAdequate         Boolean?
  reviewNotes              String?       @db.Text
  createdByUserId          Int?
  submittedAt              DateTime?
  approvedAt               DateTime?
  lockedAt                 DateTime?
  clientSyncId             String?       @unique
  clientVersion            Int           @default(0)
  currentVersion           Int           @default(1)
  deletedAt                DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site        Site?                @relation(fields: [siteId], references: [id], onDelete: SetNull)
  createdBy   User?                @relation("JhaFlhaCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  taskEntry   JhaTaskLibraryEntry? @relation(fields: [taskLibraryId], references: [id], onDelete: SetNull)
  workPackage PmWorkPackage?       @relation(fields: [workPackageId], references: [id], onDelete: SetNull)
  pmTask      PmPmTask?            @relation("JhaFlhaPmTask", fields: [taskId], references: [id], onDelete: SetNull)

  versions          JhaFlhaVersion[]
  hazards           JhaFlhaHazard[]
  controls          JhaFlhaControl[]
  energySources     JhaFlhaEnergySource[]
  workers           JhaFlhaWorker[]
  equipmentLinks    JhaFlhaEquipment[]
  signatures        JhaFlhaSignature[]
  attachments       JhaFlhaAttachment[]
  correctiveActions JhaFlhaCorrectiveAction[]
  auditLogs         JhaFlhaAuditLog[]

  @@index([projectId, status])
  @@index([companyId, createdAt])
  @@index([siteId, status])
  @@index([workPackageId])
  @@index([taskId])
  @@map("jha_flha")
}

model JhaFlhaVersion {
  id              String   @id @default(uuid())
  jhaFlhaId       String
  versionNumber   Int
  snapshotJson    Json
  changedByUserId Int?
  changeReason    String?
  createdAt       DateTime @default(now())

  jhaFlha   JhaFlha @relation(fields: [jhaFlhaId], references: [id], onDelete: Cascade)
  changedBy User?   @relation("JhaFlhaVersionAuthor", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@unique([jhaFlhaId, versionNumber])
  @@map("jha_flha_version")
}

model JhaFlhaHazard {
  id             String   @id @default(uuid())
  jhaFlhaId      String
  sortOrder      Int      @default(0)
  libraryEntryId String?
  category       String?
  subcategory    String?
  description    String   @db.Text
  severity       Int      @default(3)
  likelihood     Int      @default(3)
  riskScore      Int      @default(9)
  energyTypes    Json     @default("[]")
  sifIndicator   Boolean  @default(false)
  createdAt      DateTime @default(now())

  jhaFlha  JhaFlha          @relation(fields: [jhaFlhaId], references: [id], onDelete: Cascade)
  controls JhaFlhaControl[]

  @@index([jhaFlhaId, sortOrder])
  @@map("jha_flha_hazard")
}

model JhaFlhaControl {
  id                 String    @id @default(uuid())
  jhaFlhaId          String
  hazardId           String?
  libraryEntryId     String?
  controlType        String    @default("administrative")
  description        String    @db.Text
  adequate           Boolean?
  effectivenessScore Int?
  verified           Boolean   @default(false)
  verifiedAt         DateTime?
  ppeRequired        Boolean   @default(false)
  createdAt          DateTime  @default(now())

  jhaFlha JhaFlha        @relation(fields: [jhaFlhaId], references: [id], onDelete: Cascade)
  hazard  JhaFlhaHazard? @relation(fields: [hazardId], references: [id], onDelete: SetNull)

  @@index([jhaFlhaId])
  @@index([hazardId])
  @@map("jha_flha_control")
}

model JhaFlhaEnergySource {
  id              String        @id @default(uuid())
  jhaFlhaId       String
  energyType      JhaEnergyType
  exposureLevel   Int           @default(1)
  controlsSummary String?       @db.Text

  jhaFlha JhaFlha @relation(fields: [jhaFlhaId], references: [id], onDelete: Cascade)

  @@unique([jhaFlhaId, energyType])
  @@map("jha_flha_energy_source")
}

model JhaFlhaWorker {
  id                  String    @id @default(uuid())
  jhaFlhaId           String
  workerId            Int
  role                String    @default("crew")
  trainingVerified    Boolean   @default(false)
  competencyVerified  Boolean   @default(false)
  equipmentAuthorized Boolean   @default(false)
  hazardAcknowledged  Boolean   @default(false)
  signedAt            DateTime?

  jhaFlha JhaFlha @relation(fields: [jhaFlhaId], references: [id], onDelete: Cascade)
  worker  Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([jhaFlhaId, workerId])
  @@map("jha_flha_worker")
}

model JhaFlhaEquipment {
  id                 String   @id @default(uuid())
  jhaFlhaId          String
  equipmentId        Int
  authorized         Boolean  @default(false)
  preUseInspectionOk Boolean?

  jhaFlha   JhaFlha   @relation(fields: [jhaFlhaId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([jhaFlhaId, equipmentId])
  @@map("jha_flha_equipment")
}

model JhaFlhaSignature {
  id            String               @id @default(uuid())
  jhaFlhaId     String
  role          JhaFlhaSignatureRole
  signerUserId  Int?
  signerName    String?
  signatureData String               @db.Text
  signedAt      DateTime             @default(now())

  jhaFlha    JhaFlha @relation(fields: [jhaFlhaId], references: [id], onDelete: Cascade)
  signerUser User?   @relation("JhaFlhaSigner", fields: [signerUserId], references: [id], onDelete: SetNull)

  @@index([jhaFlhaId])
  @@map("jha_flha_signature")
}

model JhaFlhaAttachment {
  id         String   @id @default(uuid())
  jhaFlhaId  String
  fileName   String
  mimeType   String?
  storageKey String?
  dataUrl    String?  @db.Text
  annotation Json?
  createdAt  DateTime @default(now())

  jhaFlha JhaFlha @relation(fields: [jhaFlhaId], references: [id], onDelete: Cascade)

  @@index([jhaFlhaId])
  @@map("jha_flha_attachment")
}

model JhaFlhaCorrectiveAction {
  id          String   @id @default(uuid())
  jhaFlhaId   String
  title       String
  description String?  @db.Text
  cailEntryId String?
  status      String   @default("open")
  createdAt   DateTime @default(now())

  jhaFlha JhaFlha @relation(fields: [jhaFlhaId], references: [id], onDelete: Cascade)

  @@index([jhaFlhaId])
  @@map("jha_flha_corrective_action")
}

model HazardLibraryEntry {
  id                 String   @id @default(uuid())
  seedKey            String?  @map("seed_key")
  companyId          Int?
  projectId          Int?
  category           String
  subcategory        String?
  description        String   @db.Text
  defaultSeverity    Int      @default(3)
  defaultLikelihood  Int      @default(3)
  defaultEnergyTypes Json     @default("[]")
  defaultControlKeys Json     @default("[]") @map("default_control_keys")
  taskTypes          Json     @default("[]")
  active             Boolean  @default(true)
  seedVersion        Int      @default(1) @map("seed_version")
  createdAt          DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([seedKey, companyId])
  @@index([companyId, category])
  @@index([projectId, category])
  @@map("hazard_library")
}

model ControlLibraryEntry {
  id               String   @id @default(uuid())
  seedKey          String?  @map("seed_key")
  companyId        Int?
  projectId        Int?
  controlType      String
  description      String   @db.Text
  hazardCategories Json     @default("[]")
  energyTypes      Json     @default("[]")
  ppeRequired      Boolean  @default(false)
  active           Boolean  @default(true)
  seedVersion      Int      @default(1) @map("seed_version")
  createdAt        DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([seedKey, companyId])
  @@index([companyId, controlType])
  @@map("control_library")
}

/// Global catalog entries for permit types, smart inspection categories, and other system defaults.
model SystemCatalogEntry {
  id          String   @id
  catalogType String   @map("catalog_type")
  name        String
  description String?  @db.Text
  version     Int      @default(1)
  payload     Json     @default("{}")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([catalogType, active])
  @@map("system_catalog")
}

model JhaTaskLibraryEntry {
  id               String   @id @default(uuid())
  companyId        Int?
  projectId        Int?
  taskCode         String
  title            String
  description      String?  @db.Text
  defaultHazardIds Json     @default("[]")
  requiredTraining Json     @default("[]")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  company    Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jhaRecords JhaFlha[]

  @@index([companyId, taskCode])
  @@index([projectId, taskCode])
  @@map("jha_task_library")
}

model JhaFlhaAuditLog {
  id        String   @id @default(uuid())
  jhaFlhaId String
  eventType String
  actorId   Int?
  payload   Json?
  createdAt DateTime @default(now())

  jhaFlha JhaFlha @relation(fields: [jhaFlhaId], references: [id], onDelete: Cascade)
  actor   User?   @relation("JhaFlhaAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([jhaFlhaId, createdAt])
  @@map("jha_flha_audit_log")
}

// -----------------------------------------------------
// SIF / HECA ENGINE
// -----------------------------------------------------

enum SifHecaSourceType {
  jha_flha
  safety_form
  inspection
  incident
  equipment
  competency
  bbo
  general
}

enum SifHecaEventStatus {
  ingested
  scored
  review_required
  approved
  rejected
  closed
}

enum SifPotentialCategory {
  low
  medium
  high
  critical
}

model SifIndicatorLibrary {
  id          String   @id @default(uuid())
  companyId   Int?
  projectId   Int?
  code        String
  label       String
  description String?  @db.Text
  weight      Int      @default(10)
  triggerRule Json     @default("{}")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId, code])
  @@index([projectId, code])
  @@map("sif_indicator")
}

model HecaCategoryLibrary {
  id              String   @id @default(uuid())
  companyId       Int?
  projectId       Int?
  code            String
  label           String
  description     String?  @db.Text
  keywordPatterns Json     @default("[]")
  energyTypes     Json     @default("[]")
  severityDefault Int      @default(3)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId, code])
  @@map("heca_category")
}

model SifHecaEvent {
  id           String             @id @default(uuid())
  companyId    Int
  projectId    Int
  siteId       Int?
  workerId     Int?
  equipmentId  Int?
  sourceType   SifHecaSourceType
  sourceId     String
  sourceItemId String             @default("")
  status       SifHecaEventStatus @default(ingested)
  title        String
  description  String?            @db.Text
  rawPayload   Json               @default("{}")
  deletedAt    DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site      Site?      @relation(fields: [siteId], references: [id], onDelete: SetNull)
  worker    Worker?    @relation(fields: [workerId], references: [id], onDelete: SetNull)
  equipment Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)

  sifScore          SifScore?
  hecaScore         HecaScore?
  csraAssessment    HecaCsraAssessment?
  links             SifHecaLink[]
  correctiveActions SifHecaCorrectiveAction[]
  auditLogs         SifHecaAuditLog[]

  @@unique([sourceType, sourceId, sourceItemId])
  @@index([projectId, status])
  @@index([companyId, createdAt])
  @@index([workerId, status])
  @@map("sif_heca_event")
}

model SifScore {
  id                       String               @id @default(uuid())
  eventId                  String               @unique
  version                  Int                  @default(1)
  sifScore                 Int
  sifCategory              SifPotentialCategory
  severityComponent        Int                  @default(0)
  likelihoodComponent      Int                  @default(0)
  energyComponent          Int                  @default(0)
  controlComponent         Int                  @default(0)
  competencyComponent      Int                  @default(0)
  equipmentComponent       Int                  @default(0)
  environmentComponent     Int                  @default(0)
  historyComponent         Int                  @default(0)
  requiresSupervisorReview Boolean              @default(false)
  requiredControls         Json                 @default("[]")
  requiredActions          Json                 @default("[]")
  explainability           Json                 @default("[]")
  computedAt               DateTime             @default(now())

  event SifHecaEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("sif_score")
}

model HecaScore {
  id                 String   @id @default(uuid())
  eventId            String   @unique
  version            Int      @default(1)
  hecaCategoryCode   String
  hecaCategoryLabel  String
  severity           Int
  likelihood         Int
  hecaRiskScore      Int
  highEnergyFlag     Boolean  @default(false)
  requiredControls   Json     @default("[]")
  requiredCorrective Json     @default("[]")
  explainability     Json     @default("[]")
  computedAt         DateTime @default(now())

  event SifHecaEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([hecaCategoryCode])
  @@map("heca_score")
}

model SifHecaLink {
  id           String            @id @default(uuid())
  eventId      String
  linkedType   SifHecaSourceType
  linkedId     String
  linkedItemId String            @default("")
  correlation  Float?

  event SifHecaEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("sif_heca_link")
}

model SifHecaCorrectiveAction {
  id                 String    @id @default(uuid())
  eventId            String
  title              String
  description        String?   @db.Text
  assignedUserId     Int?
  cailEntryId        String?
  /// Primary Action Management (CAPA) link
  linkedActionId     String?   @map("linked_action_id")
  correctiveActionId String?
  status             String    @default("open")
  dueAt              DateTime?
  verifiedAt         DateTime?
  createdAt          DateTime  @default(now())

  event SifHecaEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, status])
  @@index([linkedActionId])
  @@map("sif_heca_corrective_action")
}

model SifHecaAuditLog {
  id        String   @id @default(uuid())
  eventId   String
  eventType String
  actorId   Int?
  payload   Json?
  createdAt DateTime @default(now())

  event SifHecaEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actor User?        @relation("SifHecaAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@map("sif_heca_audit")
}

// -----------------------------------------------------
// HECA CSRA ASSESSMENT (structured CSRA methodology)
// Fields: energy_source, exposure_level, control_type,
// sif_potential, verification_status, recommendations,
// attachments, linked_action_id
// -----------------------------------------------------

enum HecaEnergySourceType {
  gravity
  motion
  mechanical
  electrical
  pressure
  chemical
  thermal
  radiation
  biological
}

enum HecaControlType {
  elimination
  substitution
  engineering
  administrative
  ppe
}

enum HecaControlClass {
  direct
  alternative
}

enum HecaSifPotential {
  none
  low
  medium
  high
  critical
}

enum HecaVerificationStatus {
  not_started
  pending
  verified
  failed
  waived
}

enum HecaProximity {
  contact
  near
  zone
  remote
}

enum HecaRecommendationPriority {
  critical
  high
  medium
  low
}

enum HecaRecommendationStatus {
  open
  accepted
  dismissed
  implemented
  linked
}

/// Parent CSRA / HECA assessment record.
model HecaCsraAssessment {
  id                 String                 @id @default(uuid())
  eventId            String?                @unique
  companyId          Int
  projectId          Int
  title              String
  description        String?                @db.Text
  workScope          String?                @db.Text
  locationNote       String?                @db.VarChar(500)
  environmentNote    String?                @db.Text
  equipmentNote      String?                @db.Text
  /// Overall exposure magnitude (1–5)
  exposureLevel      Int                    @default(3) @map("exposure_level")
  proximity          HecaProximity          @default(zone)
  /// SIF potential classification from CSRA step 4
  sifPotential       HecaSifPotential       @default(none) @map("sif_potential")
  sifScore           Int                    @default(0)
  sifApplies         Boolean                @default(false)
  /// Assessment-level critical-control verification state
  verificationStatus HecaVerificationStatus @default(not_started) @map("verification_status")
  /// Primary Action Management link for this assessment
  linkedActionId     String?                @map("linked_action_id")
  methodology        String                 @default("CSRA")
  revision           String?
  readyForWork       Boolean                @default(false)
  highEnergyFlag     Boolean                @default(false)
  documentJson       Json                   @default("{}")
  verifiedAt         DateTime?
  verifiedByUserId   Int?
  deletedAt          DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  event          SifHecaEvent?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  linkedAction   PmCorrectiveAction?  @relation("HecaCsraLinkedAction", fields: [linkedActionId], references: [id], onDelete: SetNull)
  verifiedByUser User?                @relation("HecaCsraVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  energySources    HecaCsraEnergySource[]
  controls         HecaCsraControl[]
  recommendations  HecaCsraRecommendation[]
  attachments      HecaCsraAttachment[]

  @@index([projectId, verificationStatus])
  @@index([companyId, createdAt])
  @@index([sifPotential])
  @@index([linkedActionId])
  @@map("heca_csra_assessment")
}

/// Identified energy source on a CSRA assessment (energy_source + per-source exposure_level).
model HecaCsraEnergySource {
  id            String               @id @default(uuid())
  assessmentId  String
  energySource  HecaEnergySourceType @map("energy_source")
  label         String
  /// Per-source exposure level (1–5)
  exposureLevel Int                  @default(1) @map("exposure_level")
  magnitude     Int                  @default(1)
  highEnergy    Boolean              @default(false)
  evidenceJson  Json                 @default("[]")
  sortOrder     Int                  @default(0)
  createdAt     DateTime             @default(now())

  assessment HecaCsraAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, energySource])
  @@index([assessmentId])
  @@map("heca_csra_energy_source")
}

/// Declared control on a CSRA assessment (control_type + verification_status).
model HecaCsraControl {
  id                 String                 @id @default(uuid())
  assessmentId       String
  controlType        HecaControlType        @map("control_type")
  controlClass       HecaControlClass       @default(alternative)
  description        String                 @db.Text
  adequate           Boolean?
  effectivenessScore Int?
  verificationStatus HecaVerificationStatus @default(not_started) @map("verification_status")
  verified           Boolean                @default(false)
  verifiedAt         DateTime?
  linkedEnergiesJson Json                   @default("[]")
  sortOrder          Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  assessment HecaCsraAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId, controlType])
  @@index([assessmentId, verificationStatus])
  @@map("heca_csra_control")
}

/// Missing-control / AI recommendations (recommendations + optional linked_action_id).
model HecaCsraRecommendation {
  id             String                     @id @default(uuid())
  assessmentId   String
  priority       HecaRecommendationPriority @default(medium)
  status         HecaRecommendationStatus   @default(open)
  controlType    HecaControlType            @map("control_type")
  controlClass   HecaControlClass           @default(direct)
  description    String                     @db.Text
  energySource   HecaEnergySourceType?      @map("energy_source")
  reason         String?                    @db.Text
  /// Action Management CAPA created from this recommendation
  linkedActionId String?                    @map("linked_action_id")
  sortOrder      Int                        @default(0)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  assessment   HecaCsraAssessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  linkedAction PmCorrectiveAction? @relation("HecaCsraRecLinkedAction", fields: [linkedActionId], references: [id], onDelete: SetNull)

  @@index([assessmentId, status])
  @@index([linkedActionId])
  @@map("heca_csra_recommendation")
}

/// Evidence / photos / docs attached to a CSRA assessment (attachments).
model HecaCsraAttachment {
  id               String   @id @default(uuid())
  assessmentId     String
  fileName         String
  mimeType         String?
  storageKey       String?
  dataUrl          String?  @db.Text
  byteSize         Int?
  annotationJson   Json?
  uploadedByUserId Int?
  createdAt        DateTime @default(now())

  assessment HecaCsraAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  uploadedBy User?              @relation("HecaCsraAttachmentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([assessmentId])
  @@map("heca_csra_attachment")
}

// -----------------------------------------------------
// PM INSPECTIONS & CHECKLISTS
// -----------------------------------------------------

enum PmInspectionTemplateCategory {
  PME
  CRANE
  VEHICLE
  TOOL
  SITE
  HOUSEKEEPING
  ENVIRONMENTAL
  ACCESS_EGRESS
  FALL_PROTECTION
  CONFINED_SPACE
  HOT_WORK
  EXCAVATION
  SCAFFOLDING
  TEMPORARY_POWER
  FIRE_PROTECTION
  CUSTOM
}

enum PmInspectionTemplateStatus {
  draft
  review
  published
  archived
}

enum PmInspectionStatus {
  draft
  in_progress
  submitted
  review_required
  approved
  rejected
  closed
}

enum PmDeficiencyStatus {
  open
  assigned
  in_progress
  verification_pending
  closed
}

enum PmDeficiencySeverity {
  low
  medium
  high
  critical
}

enum PmInspectionScoringMode {
  pass_fail
  numeric
  weighted
}

/// Checklist template with versioning and publish workflow.
model PmInspectionTemplate {
  id                  String                       @id @default(uuid())
  companyId           Int
  projectId           Int?
  name                String
  category            PmInspectionTemplateCategory
  description         String?                      @db.Text
  version             Int                          @default(1)
  status              PmInspectionTemplateStatus   @default(draft)
  scoringMode         PmInspectionScoringMode      @default(pass_fail)
  /// Items: `{ id, label, type, required?, weight?, showIf?, options?, failValues? }`
  items               Json                         @default("[]")
  scoringRules        Json                         @default("{}")
  requiredAttachments Json                         @default("[]")
  requiredSignatures  Json                         @default("[]")
  equipmentTypeKeys   Json                         @default("[]")
  parentTemplateId    String?
  seedKey             String?                      @map("seed_key")
  seedVersion         Int                          @default(1) @map("seed_version")
  publishedAt         DateTime?
  publishedByUserId   Int?
  clientSyncId        String?                      @unique
  deletedAt           DateTime?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  company        Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project        Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  publishedBy    User?                  @relation("PmInspectionTemplatePublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  parentTemplate PmInspectionTemplate?  @relation("PmInspectionTemplateVersion", fields: [parentTemplateId], references: [id], onDelete: SetNull)
  childVersions  PmInspectionTemplate[] @relation("PmInspectionTemplateVersion")
  inspections    PmInspection[]

  @@unique([seedKey, companyId])
  @@index([companyId, category, status])
  @@index([projectId, status])
  @@index([parentTemplateId])
  @@map("pm_inspection_template")
}

/// Field inspection instance created from a published template.
model PmInspection {
  id                       String             @id @default(uuid())
  templateId               String
  templateVersion          Int
  companyId                Int
  projectId                Int
  siteId                   Int?
  equipmentId              Int?
  workerId                 Int?
  inspectorUserId          Int
  status                   PmInspectionStatus @default(draft)
  title                    String?
  locationNote             String?            @db.VarChar(500)
  /// Answers keyed by checklist item id.
  answers                  Json               @default("{}")
  scorePercent             Float?
  passed                   Boolean?
  riskScore                Int?
  requiresSupervisorReview Boolean            @default(false)
  reviewNotes              String?            @db.Text
  reviewedByUserId         Int?
  reviewedAt               DateTime?
  submittedAt              DateTime?
  closedAt                 DateTime?
  clientSyncId             String?            @unique
  deletedAt                DateTime?
  /// Report sharing: contractors / workers on the project when enabled by owner.
  sharingJson              Json               @default("{\"shareReportWithContractors\":false,\"shareReportWithWorkers\":false}") @map("sharing_json")
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  template   PmInspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  company    Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project    Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site       Site?                @relation(fields: [siteId], references: [id], onDelete: SetNull)
  equipment  Equipment?           @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  worker     Worker?              @relation("PmInspectionSubjectWorker", fields: [workerId], references: [id], onDelete: SetNull)
  inspector  User                 @relation("PmInspectionInspector", fields: [inspectorUserId], references: [id], onDelete: Restrict)
  reviewedBy User?                @relation("PmInspectionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  deficiencies          PmInspectionDeficiency[]
  attachments           PmInspectionAttachment[]
  signatures            PmInspectionSignature[]
  correctiveActions     PmInspectionCorrectiveAction[]
  auditLogs             PmInspectionAuditLog[]
  photoFindings         PmInspectionPhotoFinding[]
  pmEquipmentInspection PmEquipmentInspection?
  safetyEvents          PmSafetyEvent[]
  safetyMeetings        SafetyMeeting[]

  @@index([projectId, status])
  @@index([companyId, createdAt])
  @@index([equipmentId, status])
  @@index([inspectorUserId, createdAt])
  @@index([workerId, status])
  @@map("pm_inspection")
}

model PmInspectionDeficiency {
  id                     String               @id @default(uuid())
  inspectionId           String
  itemId                 String
  title                  String
  description            String?              @db.Text
  severity               PmDeficiencySeverity @default(medium)
  category               String?
  status                 PmDeficiencyStatus   @default(open)
  assignedUserId         Int?
  assignedWorkerId       Int?
  subcontractorCompanyId Int?
  dueAt                  DateTime?
  verifiedAt             DateTime?
  closedAt               DateTime?
  cailEntryId            String?              @unique
  sifEventId             String?
  autoGenerated          Boolean              @default(true)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  inspection                PmInspection                        @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  assignedUser              User?                               @relation("PmInspectionDeficiencyAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedWorker            Worker?                             @relation(fields: [assignedWorkerId], references: [id], onDelete: SetNull)
  subcontractorCompany      Company?                            @relation("PmInspectionDeficiencySubcontractor", fields: [subcontractorCompanyId], references: [id], onDelete: SetNull)
  contractorAcknowledgments PmContractorFindingAcknowledgment[]
  cailEntry                 CailEntry?                          @relation(fields: [cailEntryId], references: [id], onDelete: SetNull)

  attachments   PmInspectionAttachment[]
  photoFindings PmInspectionPhotoFinding[]

  @@index([inspectionId, status])
  @@index([severity, status])
  @@map("pm_inspection_deficiency")
}

model PmInspectionAttachment {
  id             String   @id @default(uuid())
  inspectionId   String
  deficiencyId   String?
  correctiveId   String?
  storageKey     String?
  fileName       String?
  mimeType       String?
  dataUrl        String?  @db.Text
  coreFileId     Int?
  annotationJson Json?
  clientSyncId   String?  @unique
  createdAt      DateTime @default(now())

  inspection    PmInspection                  @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  deficiency    PmInspectionDeficiency?       @relation(fields: [deficiencyId], references: [id], onDelete: Cascade)
  corrective    PmInspectionCorrectiveAction? @relation(fields: [correctiveId], references: [id], onDelete: Cascade)
  photoFindings PmInspectionPhotoFinding[]

  analysisStatus String? @map("analysis_status")
  analysisJson   Json?   @map("analysis_json")

  @@index([inspectionId])
  @@map("pm_inspection_attachment")
}

model PmInspectionSignature {
  id            String   @id @default(uuid())
  inspectionId  String
  role          String
  signerName    String?
  signerUserId  Int?
  signatureData String?  @db.Text
  coreFileId    Int?     @map("core_file_id")
  signedAt      DateTime @default(now())
  clientSyncId  String?  @unique

  inspection PmInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  signer     User?        @relation(fields: [signerUserId], references: [id], onDelete: SetNull)
  coreFile   CoreFile?    @relation(fields: [coreFileId], references: [id], onDelete: SetNull)

  @@unique([inspectionId, role])
  @@index([inspectionId])
  @@map("pm_inspection_signature")
}

model PmInspectionCorrectiveAction {
  id             String    @id @default(uuid())
  inspectionId   String
  deficiencyId   String?
  title          String
  description    String?   @db.Text
  assignedUserId Int?
  cailEntryId    String?   @unique
  status         String    @default("open")
  dueAt          DateTime?
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())

  inspection  PmInspection             @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  attachments PmInspectionAttachment[]

  @@index([inspectionId, status])
  @@map("pm_inspection_corrective_action")
}

model PmInspectionAuditLog {
  id           String   @id @default(uuid())
  inspectionId String
  eventType    String
  actorId      Int?
  payload      Json?
  createdAt    DateTime @default(now())

  inspection PmInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  actor      User?        @relation("PmInspectionAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([inspectionId, createdAt])
  @@map("pm_inspection_audit")
}

