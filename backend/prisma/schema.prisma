  completed
  cancelled
}

enum PmPmTaskStatus {
  draft
  scheduled
  blocked
  in_progress
  completed
  cancelled
}

enum PmPermitType {
  hot_work
  confined_space
  electrical
  excavation
  loto
  chemical_handling
  crane_lift
  fall_protection
  live_line
  open_hole
  custom
}

enum PmPermitStatus {
  draft
  pending_approval
  approved
  active
  expired
  closed
  rejected
}

enum PmPmAssignmentStatus {
  pending
  active
  blocked
  completed
  revoked
}

model PmProjectConfig {
  id               String   @id @default(uuid())
  projectId        Int      @unique
  projectType      String?
  scopeOfWorkJson  Json     @default("{}")
  locationsJson    Json     @default("[]")
  zonesJson        Json     @default("[]")
  scheduleJson     Json     @default("{}")
  subcontractorIds Json     @default("[]")
  projectManagerId Int?
  setupComplete    Boolean  @default(false)
  safetyScore      Int      @default(100)
  progressPct      Float    @default(0)
  metadataJson     Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPackages PmWorkPackage[]

  @@map("pm_project_config")
}

model PmWorkPackage {
  id                   String              @id @default(uuid())
  projectId            Int
  configId             String?
  code                 String
  title                String
  description          String?             @db.Text
  status               PmWorkPackageStatus @default(draft)
  version              Int                 @default(1)
  locationNote         String?
  zoneCode             String?
  tasksJson            Json                @default("[]")
  requiredEquipmentIds Json                @default("[]")
  requiredWorkerIds    Json                @default("[]")
  requiredTraining     Json                @default("[]")
  requiredJhaIds       Json                @default("[]")
  requiredPermitTypes  Json                @default("[]")
  hazardIds            Json                @default("[]")
  controlIds           Json                @default("[]")
  sifPotential         Boolean             @default(false)
  progressPct          Float               @default(0)
  publishedAt          DateTime?
  clientSyncId         String?             @unique
  deletedAt            DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  config          PmProjectConfig?   @relation(fields: [configId], references: [id], onDelete: SetNull)
  tasks           PmPmTask[]
  permits         PmPermit[]
  unifiedHazards  PmUnifiedHazard[]
  unifiedControls PmUnifiedControl[]
  jhaFlhaRecords  JhaFlha[]

  @@unique([projectId, code])
  @@index([projectId, status])
  @@map("work_packages")
}

model PmPmTask {
  id                   String         @id @default(uuid())
  projectId            Int
  workPackageId        String?
  code                 String
  title                String
  taskType             String         @default("general")
  status               PmPmTaskStatus @default(draft)
  requiredSkills       Json           @default("[]")
  requiredTraining     Json           @default("[]")
  requiredEquipmentIds Json           @default("[]")
  requiredJhaId        String?
  requiredControls     Json           @default("[]")
  requiredPpe          Json           @default("[]")
  requiredInspections  Json           @default("[]")
  hazardIds            Json           @default("[]")
  zoneCode             String?
  sifReviewRequired    Boolean        @default(false)
  progressPct          Float          @default(0)
  plannedStart         DateTime?
  plannedEnd           DateTime?
  actualStart          DateTime?
  actualEnd            DateTime?
  blockedReason        String?
  clientSyncId         String?        @unique
  deletedAt            DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  project              Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPackage          PmWorkPackage?            @relation(fields: [workPackageId], references: [id], onDelete: SetNull)
  workerAssignments    PmPmWorkerAssignment[]
  equipmentAssignments PmPmEquipmentAssignment[]
  scheduleEntries      PmProjectSchedule[]
  unifiedHazards       PmUnifiedHazard[]
  unifiedControls      PmUnifiedControl[]
  linkedJhaFlha        JhaFlha?                  @relation("JhaFlhaPmTask")

  @@index([projectId, status])
  @@index([workPackageId])
  @@map("tasks")
}

model PmProjectSchedule {
  id            String   @id @default(uuid())
