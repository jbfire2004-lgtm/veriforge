  @@unique([meetingId, workerId])
  @@index([workerId])
  @@map("safety_meeting_attendees")
}

model SafetyMeetingSignature {
  id             String   @id @default(uuid())
  meetingId      String
  attendeeId     String?
  role           String
  signerUserId   Int?
  signerWorkerId Int?
  signatureData  String?  @db.Text
  signedAt       DateTime @default(now())
  clientSyncId   String?  @unique

  meeting      SafetyMeeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  attendee     SafetyMeetingAttendee? @relation(fields: [attendeeId], references: [id], onDelete: SetNull)
  signerUser   User?                  @relation("SafetyMeetingSigUser", fields: [signerUserId], references: [id], onDelete: SetNull)
  signerWorker Worker?                @relation("SafetyMeetingSigWorker", fields: [signerWorkerId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@map("safety_meeting_signatures")
}

model SafetyMeetingAttachment {
  id                 String   @id @default(uuid())
  meetingId          String
  topicId            String?
  correctiveActionId String?
  fileName           String?
  mimeType           String?
  storageKey         String?
  dataUrl            String?  @db.Text
  annotationJson     Json?
  phase              String   @default("evidence")
  clientSyncId       String?  @unique
  createdAt          DateTime @default(now())

  meeting          SafetyMeeting       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
