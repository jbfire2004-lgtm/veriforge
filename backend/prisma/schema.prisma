model MusterCheckin {
  id                 String    @id @default(uuid())
  musterEventId      String
  workerId           Int
  checkedInAt        DateTime  @default(now())
  checkedOutAt       DateTime?
  method             String    @default("manual")
  musterPointCode    String?
  identityVerified   Boolean   @default(false)
