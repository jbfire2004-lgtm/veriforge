  createdAt DateTime @default(now())

  answer ExpertQaAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  user   User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([answerId, voterKey])
  @@index([answerId])
