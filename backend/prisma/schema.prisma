// ─── VeriHub Industry Safety Intelligence (VISI) dual-dashboard ─────────────
// Project and company planes are isolated: no cross-plane foreign keys.

enum VisiDataPlane {
  project
  company
}

enum VisiTrendReportKind {
  cohort
  heca
  trif_ltif
  seasonal
  leading
  root_cause
  workforce
  predictive
  full_trends
}

model VisiAnonymizedToken {
  id           String       @id @default(cuid())
  plane        VisiDataPlane
  token        String       @unique
  saltVersion  String       @map("salt_version")
  sourceIdHash String?      @map("source_id_hash")
  createdAt    DateTime     @default(now()) @map("created_at")

  industryProject  VisiIndustryProject?
  industryCompany  VisiIndustryCompany?
  leadingIndicators VisiLeadingIndicator[]
  correctiveActions VisiCorrectiveAction[]
  competencyProfiles VisiCompetencyProfile[]

  @@index([plane])
  @@index([sourceIdHash])
  @@map("anonymized_tokens")
}

model VisiIndustryProject {
  id                 String   @id @default(cuid())
  token              String   @unique
  industry           String
  subtype            String
  scale              String
  regionBand         String?  @map("region_band")
  normalizerVersion  String   @map("normalizer_version")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  anonymizedToken VisiAnonymizedToken @relation(fields: [token], references: [token], onDelete: Cascade)
  metrics         VisiProjectMetric[]

  @@index([industry, subtype, scale])
  @@map("industry_projects")
}

model VisiIndustryCompany {
  id                 String   @id @default(cuid())
  token              String   @unique
  industry           String
  subtype            String
  scale              String
  regionBand         String?  @map("region_band")
  normalizerVersion  String   @map("normalizer_version")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  anonymizedToken VisiAnonymizedToken @relation(fields: [token], references: [token], onDelete: Cascade)
  metrics         VisiCompanyMetric[]

  @@index([industry, subtype, scale])
  @@map("industry_companies")
}

model VisiProjectMetric {
  id                        String   @id @default(cuid())
  projectId                 String   @map("project_id")
  period                    String
  hoursBasis                Int      @default(200000) @map("hours_basis")
  hoursWorked               Float?   @map("hours_worked")
  incidentRatePer200k       Float?   @map("incident_rate_per_200k")
  recordableRatePer200k     Float?   @map("recordable_rate_per_200k")
  lostTimeRatePer200k       Float?   @map("lost_time_rate_per_200k")
  nearMissRatePer200k       Float?   @map("near_miss_rate_per_200k")
  severityIndex             Float?   @map("severity_index")
  hecaHighEnergyRate        Float?   @map("heca_high_energy_rate")
  hecaControlsVerifiedRate  Float?   @map("heca_controls_verified_rate")
  hecaDistribution          Json     @default("{}") @map("heca_distribution")
  normalizedAt              DateTime @map("normalized_at")
  normalizerVersion         String   @map("normalizer_version")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  project VisiIndustryProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, period])
  @@index([period])
  @@map("project_metrics")
}

model VisiCompanyMetric {
  id                        String   @id @default(cuid())
  companyId                 String   @map("company_id")
  period                    String
  hoursBasis                Int      @default(200000) @map("hours_basis")
  hoursWorked               Float?   @map("hours_worked")
  incidentRatePer200k       Float?   @map("incident_rate_per_200k")
  recordableRatePer200k     Float?   @map("recordable_rate_per_200k")
  lostTimeRatePer200k       Float?   @map("lost_time_rate_per_200k")
  nearMissRatePer200k       Float?   @map("near_miss_rate_per_200k")
  severityIndex             Float?   @map("severity_index")
  hecaHighEnergyRate        Float?   @map("heca_high_energy_rate")
  hecaControlsVerifiedRate  Float?   @map("heca_controls_verified_rate")
  hecaDistribution          Json     @default("{}") @map("heca_distribution")
  normalizedAt              DateTime @map("normalized_at")
  normalizerVersion         String   @map("normalizer_version")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  company VisiIndustryCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, period])
  @@index([period])
  @@map("company_metrics")
}

model VisiLeadingIndicator {
  id                         String       @id @default(cuid())
  entityType                 VisiDataPlane @map("entity_type")
  token                      String
  period                     String
  observationRate            Float?       @map("observation_rate")
  inspectionCompletionRate   Float?       @map("inspection_completion_rate")
  trainingCurrencyRate       Float?       @map("training_currency_rate")
  nearMissReportingIndex     Float?       @map("near_miss_reporting_index")
  controlsVerifiedRate       Float?       @map("controls_verified_rate")
  leadingComposite           Float?       @map("leading_composite")
  normalizedAt               DateTime     @map("normalized_at")
  normalizerVersion          String       @map("normalizer_version")
  createdAt                  DateTime     @default(now()) @map("created_at")
  updatedAt                  DateTime     @updatedAt @map("updated_at")

  anonymizedToken VisiAnonymizedToken @relation(fields: [token], references: [token], onDelete: Cascade)

  @@unique([entityType, token, period])
  @@index([entityType, period])
  @@map("leading_indicators")
}

model VisiCorrectiveAction {
  id                String       @id @default(cuid())
  entityType        VisiDataPlane @map("entity_type")
  token             String
  period            String
  onTimeRate        Float?       @map("on_time_rate")
  openAvg           Float?       @map("open_avg")
  overdueCountAvg   Float?       @map("overdue_count_avg")
  aging             Json         @default("{}")
  normalizedAt      DateTime     @map("normalized_at")
  normalizerVersion String       @map("normalizer_version")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  anonymizedToken VisiAnonymizedToken @relation(fields: [token], references: [token], onDelete: Cascade)

  @@unique([entityType, token, period])
  @@index([entityType, period])
  @@map("visi_corrective_actions")
}

model VisiCompetencyProfile {
  id                String       @id @default(cuid())
  entityType        VisiDataPlane @map("entity_type")
  token             String
  period            String
  currentRate       Float?       @map("current_rate")
  expiring30dRate   Float?       @map("expiring_30d_rate")
  expiring60dRate   Float?       @map("expiring_60d_rate")
  expiring90dRate   Float?       @map("expiring_90d_rate")
  roleDistribution  Json?        @map("role_distribution")
  normalizedAt      DateTime     @map("normalized_at")
  normalizerVersion String       @map("normalizer_version")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  anonymizedToken VisiAnonymizedToken @relation(fields: [token], references: [token], onDelete: Cascade)

  @@unique([entityType, token, period])
  @@index([entityType, period])
  @@map("competency_profiles")
}

/// Industry aggregates + trend payloads — partitioned by entityType (never mixed).
model VisiTrendCache {
  id          String             @id @default(cuid())
  entityType  VisiDataPlane      @map("entity_type")
  industry    String
  subtype     String
  scale       String
  period      String
  reportKind  VisiTrendReportKind @map("report_kind")
  /// Empty string when not predictive; avoids NULL unique-index gaps.
  horizon     String              @default("")
  payload     Json
  suppressed  Boolean            @default(false)
  entityCount Int?               @map("entity_count")
  minSample   Int                @default(5) @map("min_sample")
  computedAt  DateTime           @default(now()) @map("computed_at")
  expiresAt   DateTime?          @map("expires_at")

  @@unique([entityType, industry, subtype, scale, period, reportKind, horizon], map: "trend_cache_cohort_key")
  @@index([entityType, period])
  @@index([expiresAt])
  @@map("trend_cache")
}

model VisiSelectorState {
  id         String       @id @default(cuid())
  userId     Int          @unique @map("user_id")
  entityType VisiDataPlane @map("entity_type")
  industry   String
  subtype    String
  scale      String
  period     String
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@index([entityType])
  @@map("selector_state")
}

// ═══════════════════════════════════════════════════════════════════════════
// VeriSuite SMS — production projection layer (Final Data Model)
// Physical tables use sms_ prefix to avoid VISI company_metrics / project_metrics.
// Appended into schema.prisma by build; keep in sync.
//
// SoR note: sor_* FK columns (sorJhaFlhaId, sorActionId, sorMeetingId,
// sorEmergencyPlanId) are String (UUID) — Nest SoR (JhaFlha, PmCorrectiveAction,
// SafetyMeeting, EmergencyPlan) uses UUID primary keys, not Int. This is an
// intentional deviation from the canvas table literal ("INT") which predates
// the SoR's UUID PK convention.
// ═══════════════════════════════════════════════════════════════════════════

enum SmsAccessPlane {
  project
  company
  subcontractor
}

enum SmsPeriodGrain {
  day
  week
  month
  quarter
}

enum SmsGeoLevel {
  global
  continent
  country
  province
  region
  city
  site
}

enum SmsFlhaStatus {
  draft
  active
  closed
  void
}

enum SmsQualityBand {
  pass
  warn
  fail
}

enum SmsFieldOsSyncStatus {
  pending
  synced
  error
  na
}

enum SmsJhaStatus {
  draft
  in_review
  approved
  archived
}

enum SmsErpScenario {
  electrical
  fall
  trench
  chemical
  rollover
  general
}

enum SmsErpStatus {
  draft
  active
  archived
}

enum SmsActionKind {
  corrective
  preventive
}

enum SmsActionStatus {
  open
  in_progress
  pending_verify
  closed
  void
}

enum SmsPriority {
  low
  medium
  high
  critical
}

enum SmsSourceModule {
  incident
  inspection
  jha
  flha
  meeting
  manual
  ai
}

enum SmsMeetingType {
  toolbox
  orientation
  emergency_drill_brief
  other
}

enum SmsMeetingStatus {
  scheduled
  completed
  cancelled
}

enum SmsAiModelTier {
  D0
  D1
  L1
  L2
}

enum SmsAiTone {
  neutral
  positive
  caution
  alert
}

enum SmsAiSource {
  rules
  scorer
  llm
  fallback
}

enum SmsAiStatus {
  active
  accepted
  rejected
  expired
  superseded
}

enum SmsDrillRosterStatus {
  expected
  accounted
  missing
  excused
}

enum SmsEntitlementReason {
  no_data
  license
  denied
}

model SmsGeoNode {
  id              String         @id @default(uuid())
  companyId       Int            @map("company_id")
  parentGeoNodeId String?        @map("parent_geo_node_id")
  geoLevel        SmsGeoLevel    @map("geo_level")
  geoCode         String         @map("geo_code")
  displayName     String         @map("display_name")
  isoCountry      String?        @map("iso_country")
  admin1Code      String?        @map("admin1_code")
  timezone        String?
  centroidLat     Float?         @map("centroid_lat")
  centroidLng     Float?         @map("centroid_lng")
  pathLtree       String?        @map("path_ltree")
  depth           Int            @default(0)
  sortOrder       Int            @default(0) @map("sort_order")
  isActive        Boolean        @default(true) @map("is_active")
  accessPlane     SmsAccessPlane @default(company) @map("access_plane")
  visibilityRoles String[]       @default([]) @map("visibility_roles")
  createdByUserId Int?           @map("created_by_user_id")
  updatedByUserId Int?           @map("updated_by_user_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")
  rowVersion      Int            @default(1) @map("row_version")

  parent          SmsGeoNode?            @relation("SmsGeoHierarchy", fields: [parentGeoNodeId], references: [id], onDelete: Restrict)
