  category         PmSdsCategory    @default(CHEMICAL)
  status           PmDocumentStatus @default(draft)
  version          Int              @default(1)
  parentDocumentId String?
  casNumbers       Json             @default("[]")
  hazardClasses    Json             @default("[]")
  whmisJson        Json             @default("{}")
  metadataJson     Json             @default("{}")
  storageKey       String?
  revisionDate     DateTime?
  expiresAt        DateTime?
  reviewDueAt      DateTime?
  requiresAck      Boolean          @default(false)
  publishedAt      DateTime?
  clientSyncId     String?          @unique
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  company         Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project         Project?                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentDocument  SdsDocument?               @relation("SdsDocumentVersionChain", fields: [parentDocumentId], references: [id], onDelete: SetNull)
  childVersions   SdsDocument[]              @relation("SdsDocumentVersionChain")
  inventory       ChemicalInventoryItem[]
  versions        SdsDocumentVersion[]
  attachments     SdsDocumentAttachment[]
  acknowledgments PmDocumentAcknowledgment[]

  @@index([companyId, productName])
  @@index([projectId, status])
  @@index([expiresAt])
  @@index([parentDocumentId])
  @@map("sds_document")
}

model ChemicalInventoryItem {
  id               String    @id @default(uuid())
  companyId        Int
  projectId        Int?
  siteId           Int
  sdsDocumentId    String?
  productName      String?
  quantity         Decimal?  @db.Decimal(12, 3)
  unit             String?
  containerSize    String?
  locationNote     String?   @db.VarChar(500)
  storageClass     String?
  incompatibleWith Json      @default("[]")
  chemicalExpiry   DateTime?
  missingSdsFlag   Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site        Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  sdsDocument SdsDocument? @relation(fields: [sdsDocumentId], references: [id], onDelete: SetNull)

  @@index([siteId])
  @@index([projectId])
  @@index([sdsDocumentId])
  @@index([chemicalExpiry])
  @@map("chemical_inventory_item")
}

model PolicyDocument {
  id                   String           @id @default(uuid())
  companyId            Int
  projectId            Int?
  title                String
  version              String           @default("1.0")
  versionNum           Int              @default(1)
  status               PmDocumentStatus @default(draft)
