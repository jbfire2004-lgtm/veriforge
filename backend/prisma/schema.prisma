// -----------------------------------------------------
// VERA ADMIN CONTROL PANEL (ACP)
// -----------------------------------------------------
enum AcpTenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum AcpSubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIAL
}

model AcpTenant {
  id        String          @id @default(uuid())
  slug      String          @unique
  name      String
  companyId Int?            @unique @map("company_id")
  status    AcpTenantStatus @default(ACTIVE)
  metadata  Json            @default("{}")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  company            Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  users              User[]
  userRoles          AcpUserRole[]
  roles              AcpRole[]
  subscription       AcpTenantSubscription?
  tenantFeatureFlags AcpTenantFeatureFlag[]
  auditLogs          AcpAuditLog[]

  @@map("acp_tenants")
}

model AcpRole {
  id          String   @id @default(uuid())
  key         String
  name        String
  description String?
  tenantId    String?  @map("tenant_id")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      AcpTenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles   AcpUserRole[]
  permissions AcpRolePermission[]

  @@unique([tenantId, key])
  @@map("acp_roles")
}

model AcpUserRole {
  id        String   @id @default(uuid())
  userId    Int      @map("user_id")
  roleId    String   @map("role_id")
  tenantId  String?  @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   AcpRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant AcpTenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@map("acp_user_roles")
}

model AcpPermission {
  id          String   @id @default(uuid())
  key         String   @unique
  module      String
  action      String   @default("access")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles AcpRolePermission[]

  @@index([module])
  @@map("acp_permissions")
}

model AcpRolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       AcpRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AcpPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("acp_role_permissions")
}

model AcpSubscriptionTier {
  id           String   @id @default(uuid())
  key          String   @unique
  name         String
  description  String?
  sortOrder    Int      @default(0) @map("sort_order")
  limitsJson   Json     @default("{}") @map("limits_json")
  featuresJson Json     @default("[]") @map("features_json")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  subscriptions AcpTenantSubscription[]

  @@map("acp_subscription_tiers")
}

model AcpTenantSubscription {
  id             String                @id @default(uuid())
  tenantId       String                @unique @map("tenant_id")
  tierId         String                @map("tier_id")
  status         AcpSubscriptionStatus @default(ACTIVE)
  seatsPurchased Int                   @default(10) @map("seats_purchased")
  modulesEnabled Json                  @default("[]") @map("modules_enabled")
  renewalDate    DateTime?             @map("renewal_date")
  startsAt       DateTime              @default(now()) @map("starts_at")
  endsAt         DateTime?             @map("ends_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  tenant AcpTenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tier   AcpSubscriptionTier @relation(fields: [tierId], references: [id], onDelete: Restrict)

  @@map("acp_tenant_subscriptions")
}

model AcpFeatureFlag {
  id              String   @id @default(uuid())
  key             String   @unique
  name            String
  description     String?
  defaultEnabled  Boolean  @default(false) @map("default_enabled")
  requiredTierKey String?  @map("required_tier_key")
  module          String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenantOverrides AcpTenantFeatureFlag[]

  @@map("acp_feature_flags")
}

model AcpTenantFeatureFlag {
  tenantId      String  @map("tenant_id")
  featureFlagId String  @map("feature_flag_id")
  enabled       Boolean @default(false)

  tenant      AcpTenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  featureFlag AcpFeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)

  @@id([tenantId, featureFlagId])
  @@map("acp_tenant_feature_flags")
}

model AcpAuditLog {
  id          String   @id @default(uuid())
  tenantId    String?  @map("tenant_id")
  actorUserId Int?     @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json     @default("{}")
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant AcpTenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor  User?      @relation("AcpAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@map("acp_audit_logs")
}

