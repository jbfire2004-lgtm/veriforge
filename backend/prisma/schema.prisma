model MusterEvent {
  id                    String            @id @default(uuid())
  companyId             Int
  siteId                Int
  projectId             Int?
  emergencyEventId      String?
  status                MusterEventStatus @default(activated)
  evacuationPhase       String            @default("muster")
  musterPointCode       String?
  siteAccessLocked      Boolean           @default(true)
  triggeredAt           DateTime          @default(now())
  triggeredByUser       Int?
  allClearAt            DateTime?
  supervisorConfirmedAt DateTime?
  notes                 String?           @db.Text
  expectedWorkerIds     Json              @default("[]")
  missingWorkerIds      Json              @default("[]")
  dangerZoneWorkerIds   Json              @default("[]")
