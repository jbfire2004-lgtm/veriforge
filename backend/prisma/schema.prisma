model SafetyInspectionItem {
  id              String              @id @default(uuid())
  inspectionId    String
  polarity        ObservationPolarity
  photoStorageKey String?
  photoDataUrl    String?             @db.Text
  coreFileId      Int?
  caption         String?             @db.Text
  ownerCompanyId  Int?
  assignedUserId  Int?
  equipmentId     Int?
  riskCategory    CailRiskCategory?
  severity        CailSeverity?
  notes           String?             @db.Text
  cailEntryId     String?             @unique
  aiSuggestions   Json?
  createdAt       DateTime            @default(now())

  inspection   SafetyInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  ownerCompany Company?         @relation("SafetyInspectionItemOwner", fields: [ownerCompanyId], references: [id], onDelete: SetNull)
  assignedUser User?            @relation("SafetyInspectionItemAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
