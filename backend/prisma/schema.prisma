enum ExpertQaQuestionStatus {
  OPEN
  CLOSED
  ARCHIVED
  HIDDEN
}

enum ExpertQaModerationStatus {
  VISIBLE
  PENDING
  HIDDEN
}

enum ExpertBadgeLevel {
  CONTRIBUTOR
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum ExpertQaAttachmentType {
  IMAGE
  PDF
  OTHER
}

model ExpertProfile {
  id              String           @id @default(uuid())
  userId          Int              @unique
  headline        String?
  bio             String?          @db.Text
  trade           String?
  verifiedAt      DateTime?
  reputationScore Int              @default(0)
  badgeLevel      ExpertBadgeLevel @default(CONTRIBUTOR)
  answerCount     Int              @default(0)
  acceptedCount   Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user                 User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers              ExpertQaAnswer[]
  endorsements         ExpertEndorsement[]
  verificationRequests ExpertVerificationRequest[]

  @@index([reputationScore(sort: Desc)])
  @@index([badgeLevel])
}

model ExpertQaTag {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  questions ExpertQaQuestionTag[]
}

model ExpertQaQuestion {
  id               String                   @id @default(uuid())
  slug             String                   @unique
  title            String
  body             String                   @db.Text
  trade            String?
  companyId        Int?
  projectId        Int?
  authorUserId     Int?
  anonymous        Boolean                  @default(false)
  status           ExpertQaQuestionStatus   @default(OPEN)
  moderationStatus ExpertQaModerationStatus @default(PENDING)
  viewCount        Int                      @default(0)
  voteScore        Int                      @default(0)
  acceptedAnswerId String?                  @unique
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  author         User?                 @relation("ExpertQaQuestionAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  company        Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  project        Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  acceptedAnswer ExpertQaAnswer?       @relation("AcceptedAnswer", fields: [acceptedAnswerId], references: [id], onDelete: SetNull)
  tags           ExpertQaQuestionTag[]
  attachments    ExpertQaAttachment[]
  answers        ExpertQaAnswer[]      @relation("QuestionAnswers")

  @@index([status, createdAt(sort: Desc)])
  @@index([moderationStatus, createdAt(sort: Desc)])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([trade])
  @@index([voteScore(sort: Desc)])
