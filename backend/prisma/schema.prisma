model PmPermit {
  id                   String         @id @default(uuid())
  projectId            Int
  workPackageId        String?
  taskId               String?
  permitType           PmPermitType
  title                String
  status               PmPermitStatus @default(draft)
  version              Int            @default(1)
  requiredTraining     Json           @default("[]")
  requiredControls     Json           @default("[]")
  requiredJhaId        String?
  requiredEquipmentIds Json           @default("[]")
  workflowJson         Json           @default("{}")
  validFrom            DateTime?
  validTo              DateTime?
  approvedById         Int?
  approvedAt           DateTime?
  legacyWorkflowId     Int?
  clientSyncId         String?        @unique
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPackage PmWorkPackage?    @relation(fields: [workPackageId], references: [id], onDelete: SetNull)
  versions    PmPermitVersion[]
  fieldOsLink VeripmPermit?

  @@index([projectId, permitType, status])
  @@map("permits")
}

// VERIPM ↔ FieldOS permit integration registry (bridges PmPermit + FieldOS tasks + VERICore safety).
enum VeripmPermitRiskLevel {
  low
  medium
  high
  critical
}

enum VeripmPermitSyncStatus {
  draft
  queued
  open
  in_progress
  awaiting_signatures
  active
  closed
  cancelled
  sync_error
}

model VeripmPermit {
  permitId            String                 @id @default(uuid()) @map("permit_id")
  companyId           Int                    @map("company_id")
  projectId           Int                    @map("project_id")
  jobId               String?                @map("job_id")
  assetId             String?                @map("asset_id")
  contractorId        Int?                   @map("contractor_id")
  pmPermitId          String?                @unique @map("pm_permit_id")
  fieldosTaskId       String?                @unique @map("fieldos_task_id")
  permitType          String                 @map("permit_type")
  riskLevel           VeripmPermitRiskLevel  @default(medium) @map("risk_level")
  status              VeripmPermitSyncStatus @default(draft)
  requiredSignatures  Json                   @default("[]") @map("required_signatures")
  requiredDocuments   Json                   @default("[]") @map("required_documents")
  requiredPpe         Json                   @default("[]") @map("required_ppe")
  startTime           DateTime?              @map("start_time")
  endTime             DateTime?              @map("end_time")
  createdByUserId     Int?                   @map("created_by_user_id")
  // FieldOS webhook payload + activity (signatures, photos, notes, hazard controls)
  fieldosMetadataJson Json                   @default("{}") @map("fieldos_metadata_json")
  // Linked FLHA/JHA/incident/work-order IDs for VERICore + PM dashboards
  safetyLinksJson     Json                   @default("{}") @map("safety_links_json")
  workOrderIdsJson    Json                   @default("[]") @map("work_order_ids_json")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  company    Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project    Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pmPermit   PmPermit?              @relation(fields: [pmPermitId], references: [id], onDelete: SetNull)
  createdBy  User?                  @relation("VeripmPermitCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  activities VeripmPermitActivity[]

  @@index([companyId, status])
  @@index([projectId, permitType, status])
  @@index([contractorId])
  @@index([fieldosTaskId])
  @@map("veripm_permits")
}

enum VeripmPermitActivityKind {
  created
  fieldos_pushed
  fieldos_webhook
  status_changed
  signature
  photo
  note
  hazard_control
  safety_linked
  work_order_updated
  incident_linked
  css_impact
  closed
}

model VeripmPermitActivity {
  activityId      String                    @id @default(uuid()) @map("activity_id")
  permitId        String                    @map("permit_id")
