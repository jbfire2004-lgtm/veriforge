  parentDocumentId     String?
  reviewDueAt          DateTime?
  publishedAt          DateTime?
  supersededAt         DateTime?
  archivedAt           DateTime?
  clientSyncId         String?          @unique
  deletedAt            DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

