// -----------------------------------------------------
// GENERATOR + DATASOURCE
// -----------------------------------------------------
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// -----------------------------------------------------
// ENUMS
// -----------------------------------------------------
enum UserRole {
  SUPER_ADMIN
  UNION_HALL_ADMIN
  COMPANY_ADMIN
  ADMIN
  SUPERVISOR
  PROJECT_MANAGER
  WORKER
  CONTRACTOR_ADMIN
  CONTRACTOR_USER
  TRAINING_PROVIDER_ADMIN
  TRAINING_INSTRUCTOR
}

enum ProviderApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProviderComplianceLevel {
  COMPLIANT
  NEEDS_ATTENTION
  NON_COMPLIANT
  PENDING_REVIEW
}

enum InstructorQualificationStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum TrainingStandardKind {
  CSA
  PROVINCIAL_OHS
  FEDERAL_OHS
  INDUSTRY_COP
}

enum TrainingValidationOutcome {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVIEW
}

/// Immutable credential ledger — actor who caused the event.
enum CredentialLedgerActorType {
  SYSTEM
  PROVIDER
  SUPERVISOR
  WORKER
  ADMIN
}

/// Immutable credential ledger — event kinds (append-only).
enum CredentialLedgerEventType {
  CREATED
  UPDATED
  VERIFIED
  REVOKED
  EXPIRED
  CORRECTED
  IMPORTED
}

enum TrainingValidationSubject {
  TRAINING_RECORD
  PROVIDER
  INSTRUCTOR
  CERTIFICATE
  COURSE
}

/// Regulatory decision layer (extends standards compliance; distinct from equipment/core complianceStatus).
enum RegulatoryComplianceStatus {
  COMPLIANT
  PARTIALLY_COMPLIANT
  NON_COMPLIANT
  UNKNOWN
}

enum TrainingCredentialNftMintStatus {
  PENDING_MINT
  MINTED
  FAILED
  REVOKED
}

enum NftMintJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TrainingRejectionSeverity {
  ERROR
  WARNING
}

enum TrainingRejectionCategory {
  STANDARD
  JURISDICTION
  PROVIDER
  INSTRUCTOR
  EXPIRY
  CERTIFICATE
  PROGRAM
}

enum ProjectStatus {
  ACTIVE
  CLOSED
}

enum AssignmentStatus {
  ACTIVE
  REMOVED
  COMPLETED
}

enum ProjectComplianceRuleType {
  ALL_WORKERS
  ROLE
  TRADE
}

enum ProjectComplianceAlertType {
  MISSING
  EXPIRED
  EXPIRING_SOON
}

enum LinkComplianceStatus {
  COMPLIANT
  NEEDS_ATTENTION
  NON_COMPLIANT
  LOCKED_OUT
}

enum UnionMembershipStatus {
  ACTIVE
  SUSPENDED
  ENDED
}

enum EquipmentSafetyStatus {
  OK
  NEEDS_INSPECTION
  UNSAFE
}

/// Denormalized lockout flag on equipment (mirrors `lockedOutAt`).
enum EquipmentLockoutStatus {
  CLEAR
  LOCKED_OUT
}

enum WorkerSiteStatus {
  ALLOWED
  BANNED
}

/// Who performed the attestation on a training record (e.g. supervisor sign-off).
enum TrainingAttestationRole {
  SUPERVISOR
  WORKER
